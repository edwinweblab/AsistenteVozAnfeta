<Window
    x:Class="Anfeta.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ANFETA - Asistente de Voz Empresarial">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ BARRA SUPERIOR ═══════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource AnfetaNeutral900}"
                BorderBrush="#12FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid MinHeight="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel x:Name="BrandPanel"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Border Width="28" Height="28"
                            CornerRadius="6"
                            Background="{StaticResource AnfetaAccentBrush}">
                        <FontIcon Glyph="&#xE720;"
                                  FontSize="15"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ANFETA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8C8075"
                               CharacterSpacing="80"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"/>

                <!-- Indicadores de estado -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Internet -->
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Conexión a internet activa">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0EFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconInternet"
                                      Glyph="&#xE968;"
                                      FontSize="14"
                                      Foreground="{StaticResource AnfetaSuccessBrush}"/>
                            <TextBlock x:Name="TxtInternet"
                                       Text="Internet"
                                       FontSize="12"
                                       Foreground="#8C8075"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="16" Background="#14FFFFFF" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Login Anfeta (Shared) -->
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            Command="{Binding LinkSharedIconCommand}"
                            ToolTipService.ToolTip="Login Anfeta - Click para iniciar sesión">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0EFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8FA;"
                                      FontSize="14"
                                      Foreground="{Binding SharedLinkForeground}"/>
                            <TextBlock Text="{Binding SharedLinkText}"
                                       FontSize="12"
                                       Foreground="{Binding SharedLinkForeground}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Link / Perfil -->
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            Command="{Binding LinkIconCommand}"
                            ToolTipService.ToolTip="Estado de vinculación - Click para ver tu perfil o vincular cuenta">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0EFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72E;"
                                      FontSize="14"
                                      Foreground="{Binding LinkForeground}"/>
                            <TextBlock Text="{Binding LinkText}"
                                       FontSize="12"
                                       Foreground="{Binding LinkForeground}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="16" Background="#14FFFFFF" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Micrófono -->
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Estado del micrófono - Configurar en Configuración">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0EFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconMic"
                                      Glyph="&#xE720;"
                                      FontSize="14"
                                      Foreground="#6B5F56"/>
                            <TextBlock x:Name="TxtMic"
                                       Text="Micrófono"
                                       FontSize="12"
                                       Foreground="#8C8075"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dropbox -->
                    <Button x:Name="DropboxIndicator"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            Click="DropboxIndicator_Click"
                            ToolTipService.ToolTip="Dropbox">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0EFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="DotDropbox"
                                     Width="7" Height="7"
                                     Fill="#4A3E36"
                                     VerticalAlignment="Center"/>
                            <FontIcon x:Name="IconDropbox"
                                      Glyph="&#xEC50;"
                                      FontSize="14"
                                      Foreground="#4A3E36"/>
                            <TextBlock x:Name="TxtDropbox"
                                       Text="Dropbox"
                                       FontSize="12"
                                       Foreground="#6B5F56"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ NAVEGACIÓN PRINCIPAL ═══════════ -->
        <NavigationView Grid.Row="1"
                        x:Name="AppNav"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="220"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="AppNav_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Height="60" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="34" Height="34"
                                CornerRadius="8"
                                Background="{StaticResource AnfetaAccentBrush}">
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="18"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ANFETA"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       CharacterSpacing="40"/>
                            <TextBlock Text="Asistente de Voz"
                                       FontSize="10"
                                       Foreground="#6B5F56"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel Principal"
                                    Tag="Home"
                                    ToolTipService.ToolTip="Panel principal del asistente">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Comandos Disponibles"
                                    Tag="Commands"
                                    ToolTipService.ToolTip="Lista de comandos disponibles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Aplicaciones Permitidas" Tag="AllowedApps"
                    ToolTipService.ToolTip="Gestionar apps locales permitidas y sinónimos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A7;"/>
                        <!-- icono tipo app/grid -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Buscador" Tag="Search"
                                    ToolTipService.ToolTip="Buscar en actividades y proyectos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Configuración"
                                    Tag="Settings"
                                    ToolTipService.ToolTip="Ajustes y configuración del sistema">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Google Calendar"
                    Tag="GoogleCalendar"
                    ToolTipService.ToolTip="Conectar y gestionar Google Calendar">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE787;"/>
                </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Pruebas de Sistema"
                                    Tag="Tests"
                                    ToolTipService.ToolTip="Ejecutar pruebas de diagnóstico">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Padding="16,12"
                        BorderBrush="#10FFFFFF"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- Punto cambiado a naranja para unificar con el acento -->
                                <Ellipse Width="5" Height="5"
                                         Fill="#F97316"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Versión 1.0.0"
                                           FontSize="11"
                                           Foreground="#8C8075"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtVersionSubtitle"
                                       Text="Asistente de Voz Empresarial"
                                       FontSize="10"
                                       Foreground="#4A3E36"
                                       Margin="11,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Collapsed"/>
                            <Setter Target="BrandPanel.Visibility" Value="Collapsed"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtInternet.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtMic.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtDropbox.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Visible"/>
                            <Setter Target="BrandPanel.Visibility" Value="Collapsed"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtInternet.Visibility" Value="Visible"/>
                            <Setter Target="TxtMic.Visibility" Value="Visible"/>
                            <Setter Target="TxtDropbox.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1024"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Visible"/>
                            <Setter Target="BrandPanel.Visibility" Value="Visible"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Visible"/>
                            <Setter Target="TxtInternet.Visibility" Value="Visible"/>
                            <Setter Target="TxtMic.Visibility" Value="Visible"/>
                            <Setter Target="TxtDropbox.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        </NavigationView>
    </Grid>
</Window>