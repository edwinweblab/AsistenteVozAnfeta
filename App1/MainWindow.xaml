<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Asistente Voz ANFETA">

    <Grid>
        <NavigationView x:Name="AppNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="AppNav_SelectionChanged">

            <!-- Opciones del menú -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Tag="Home" Icon="Home"/>
                <NavigationViewItem Content="Comandos" Tag="Commands" Icon="Bullets"/>
            </NavigationView.MenuItems>

            <!-- Aquí se cargan las páginas -->
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
