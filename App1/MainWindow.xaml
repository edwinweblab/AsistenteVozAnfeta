<Window
    x:Class="Anfeta.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ANFETA - Asistente de Voz Empresarial">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de estado superior -->
        <Border Grid.Row="0"
                Background="{ThemeResource AnfetaNeutral900}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Brand (opcional - oculto en modo compacto) -->
                <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{StaticResource AnfetaAccentBrush}"/>
                    <TextBlock Text="ASISTENTE DE VOZ" FontSize="14" FontWeight="SemiBold" Foreground="#F7FAFC"/>
                </StackPanel>

                <!-- Indicadores de estado -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right">

                    <!-- Internet Status -->
                    <Button Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="6"
                            ToolTipService.ToolTip="Conexión a internet activa">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconInternet"
                                      Glyph="&#xE968;"
                                      FontSize="16"
                                      Foreground="{StaticResource AnfetaSuccessBrush}"/>
                            <TextBlock x:Name="TxtInternet"
                                       Text="Internet"
                                       FontSize="12"
                                       Foreground="#E2E8F0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Border Width="1" Height="20" Background="#30FFFFFF" VerticalAlignment="Center"/>

                    <!-- ICONO 2: Login Anfeta -->
                    <Button Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Padding="10,6"
                        CornerRadius="8"
                        Command="{Binding LinkSharedIconCommand}"
                        ToolTipService.ToolTip="Login Anfeta - Click para iniciar sesión">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#10FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#30FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FA;"
                      FontSize="16"
                      Foreground="{Binding SharedLinkForeground}" />
                            <TextBlock Text="{Binding SharedLinkText}"
                       FontSize="12"
                       Foreground="{Binding SharedLinkForeground}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Link Status (con hover effect) -->
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Padding="10,6"
                            CornerRadius="8"
                            Command="{Binding LinkIconCommand}"
                            ToolTipService.ToolTip="Estado de vinculación - Click para ver tu perfil o vincular cuenta">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#10FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#30FFFFFF"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;"
                                      FontSize="16"
                                      Foreground="{Binding LinkForeground}" />
                            <TextBlock Text="{Binding LinkText}"
                                       FontSize="12"
                                       Foreground="{Binding LinkForeground}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Border Width="1" Height="20" Background="#30FFFFFF" VerticalAlignment="Center"/>

                    <!-- Mic Status -->
                    <Button Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="6"
                            ToolTipService.ToolTip="Estado del micrófono - Configurar en Configuración">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconMic"
                                      Glyph="&#xE720;"
                                      FontSize="16"
                                      Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtMic"
                                       Text="Micrófono"
                                       FontSize="12"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dropbox Status (oculto en modo compacto) -->
                    <Button x:Name="DropboxIndicator" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="8,4" 
                            CornerRadius="6"
                            ToolTipService.ToolTip="Integración con Dropbox - Próximamente">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconDropbox"
                                      Glyph="&#xEC50;"
                                      FontSize="16"
                                      Foreground="#64748B"/>
                            <TextBlock x:Name="TxtDropbox"
                                       Text="Dropbox"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <NavigationView Grid.Row="1"
                        x:Name="AppNav"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="240"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="AppNav_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Height="64" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" 
                                Background="{StaticResource AnfetaAccentBrush}"
                                Padding="0"
                                ToolTipService.ToolTip="ANFETA - Asistente de Voz">
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="20"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ANFETA"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel Principal" Tag="Home"
                                    ToolTipService.ToolTip="Ver el panel principal del asistente">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Comandos Disponibles" Tag="Commands"
                                    ToolTipService.ToolTip="Ver lista de comandos y capacidades disponibles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Buscador" Tag="Search"
                                    ToolTipService.ToolTip="Buscar en actividades y proyectos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Configuración" Tag="Settings"
                                    ToolTipService.ToolTip="Ajustes y configuración del sistema">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Pruebas de Sistema" Tag="Tests"
                                    ToolTipService.ToolTip="Ejecutar pruebas de diagnóstico">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="16,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="Versión 1.0.0"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtVersionSubtitle"
                               Text="Asistente de Voz Empresarial"
                               FontSize="10"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame"/>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Collapsed"/>
                            <Setter Target="BrandPanel.Visibility" Value="Collapsed"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtInternet.Visibility" Value="Collapsed"/>
                            <Setter Target="TxtMic.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Visible"/>
                            <Setter Target="BrandPanel.Visibility" Value="Collapsed"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1024"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TxtVersionSubtitle.Visibility" Value="Visible"/>
                            <Setter Target="BrandPanel.Visibility" Value="Visible"/>
                            <Setter Target="DropboxIndicator.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        </NavigationView>
    </Grid>
</Window>