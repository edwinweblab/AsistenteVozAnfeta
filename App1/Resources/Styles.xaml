<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== COLORES BASE ========== -->
    <Color x:Key="AnfetaPrimaryColor">#1E3A5F</Color>
    <Color x:Key="AnfetaSecondaryColor">#2C5282</Color>
    <Color x:Key="AnfetaAccentColor">#FF8000</Color>
    <Color x:Key="AnfetaAccentHoverColor">#FF9933</Color>
    <Color x:Key="AnfetaSurfaceColor">#F7FAFC</Color>

    <!-- Estados -->
    <Color x:Key="AnfetaSuccessColor">#276749</Color>
    <Color x:Key="AnfetaWarningColor">#FF8000</Color>
    <Color x:Key="AnfetaErrorColor">#9B2C2C</Color>
    <Color x:Key="AnfetaInfoColor">#2C5282</Color>

    <!-- Neutrales -->
    <Color x:Key="AnfetaNeutral100">#F7FAFC</Color>
    <Color x:Key="AnfetaNeutral200">#EDF2F7</Color>
    <Color x:Key="AnfetaNeutral300">#E2E8F0</Color>
    <Color x:Key="AnfetaNeutral700">#2D3748</Color>
    <Color x:Key="AnfetaNeutral800">#1A202C</Color>
    <Color x:Key="AnfetaNeutral900">#000000</Color>

    <!-- ========== BRUSHES ========== -->
    <SolidColorBrush x:Key="AnfetaPrimaryBrush" Color="{StaticResource AnfetaPrimaryColor}"/>
    <SolidColorBrush x:Key="AnfetaSecondaryBrush" Color="{StaticResource AnfetaSecondaryColor}"/>
    <SolidColorBrush x:Key="AnfetaAccentBrush" Color="{StaticResource AnfetaAccentColor}"/>
    <SolidColorBrush x:Key="AnfetaSurfaceBrush" Color="{StaticResource AnfetaSurfaceColor}"/>
    <SolidColorBrush x:Key="AnfetaSuccessBrush" Color="{StaticResource AnfetaSuccessColor}"/>
    <SolidColorBrush x:Key="AnfetaWarningBrush" Color="{StaticResource AnfetaWarningColor}"/>
    <SolidColorBrush x:Key="AnfetaErrorBrush" Color="{StaticResource AnfetaErrorColor}"/>
    <SolidColorBrush x:Key="AnfetaInfoBrush" Color="{StaticResource AnfetaInfoColor}"/>

    <!-- ========== TIPOGRAFÍA ========== -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI</FontFamily>

    <!-- Tamaños de fuente -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeMedium">16</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <x:Double x:Key="FontSizeTitle">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>

    <!-- ========== DIMENSIONES ========== -->
    <x:Double x:Key="ButtonHeightStandard">56</x:Double>
    <x:Double x:Key="ButtonHeightCompact">40</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- ========== ESTILOS DE BOTONES ========== -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ButtonHeightStandard}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
    </Style>

    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ButtonHeightCompact}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <!-- ========== CARDS ========== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="CardElevatedStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow/>
            </Setter.Value>
        </Setter>
        <Setter Property="Translation" Value="0,0,8"/>
    </Style>

    <!-- ========== TEXTOS ========== -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubheaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

</ResourceDictionary>