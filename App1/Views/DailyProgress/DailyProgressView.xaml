<UserControl
    x:Class="Anfeta.UI.Views.DailyProgress.DailyProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="FeedBackground" Color="#0A0F14" />
        <SolidColorBrush x:Key="FeedSurface" Color="#10171E" />
        <SolidColorBrush x:Key="FeedSurfaceRaised" Color="#151E27" />
        <SolidColorBrush x:Key="FeedBorder" Color="#263746" />
        <SolidColorBrush x:Key="FeedAccent" Color="#38BDF8" />
        <SolidColorBrush x:Key="FeedMuted" Color="#8FA3B5" />

        <Style x:Key="FeedButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#151D25" />
            <Setter Property="BorderBrush" Value="#2B3D4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#F1F5F9" />
        </Style>

        <Style x:Key="FeedSegment" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="#111820" />
            <Setter Property="BorderBrush" Value="#2B3D4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource FeedBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado con identidad ANFETA, no dashboard genérico. -->
        <Border
            Grid.Row="0"
            Margin="8,6,8,5"
            Padding="12,8"
            Background="#0F1720"
            BorderBrush="#2C4A60"
            BorderThickness="1"
            CornerRadius="13">
            <Grid
                x:Name="FeedHeaderLayout"
                ColumnSpacing="10"
                RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="FeedHeaderStates">
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1120" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FeedModeSelector.(Grid.Row)" Value="0" />
                                <Setter Target="FeedModeSelector.(Grid.Column)" Value="1" />
                                <Setter Target="FeedModeSelector.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="FeedNavigation.(Grid.Row)" Value="0" />
                                <Setter Target="FeedNavigation.(Grid.Column)" Value="2" />
                                <Setter Target="FeedNavigation.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="FeedDateSubtitle.Visibility" Value="Visible" />
                                <Setter Target="OperationBadge.Visibility" Value="Visible" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="CompactHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="760" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FeedModeSelector.(Grid.Row)" Value="1" />
                                <Setter Target="FeedModeSelector.(Grid.Column)" Value="0" />
                                <Setter Target="FeedModeSelector.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="FeedNavigation.(Grid.Row)" Value="0" />
                                <Setter Target="FeedNavigation.(Grid.Column)" Value="2" />
                                <Setter Target="FeedNavigation.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="OperationBadge.Visibility" Value="Collapsed" />
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="NarrowHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="FeedModeSelector.(Grid.Row)" Value="1" />
                                <Setter Target="FeedModeSelector.(Grid.Column)" Value="0" />
                                <Setter Target="FeedModeSelector.(Grid.ColumnSpan)" Value="3" />
                                <Setter Target="FeedNavigation.(Grid.Row)" Value="0" />
                                <Setter Target="FeedNavigation.(Grid.Column)" Value="2" />
                                <Setter Target="FeedNavigation.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="FeedDateSubtitle.Visibility" Value="Collapsed" />
                                <Setter Target="OperationBadge.Visibility" Value="Collapsed" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="7"
                            Height="22"
                            VerticalAlignment="Center"
                            Background="#38BDF8"
                            CornerRadius="4" />
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#F8FAFC"
                            Text="AVANCE DIARIO" />
                        <Border
                            x:Name="OperationBadge"
                            VerticalAlignment="Center"
                            Padding="7,2"
                            Background="#122B38"
                            BorderBrush="#245773"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="8.5"
                                FontWeight="SemiBold"
                                Foreground="#7DD3FC"
                                Text="OPERACIÓN" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="FeedDateSubtitle"
                        FontSize="8.5"
                        Foreground="#8FA3B5"
                        Text="Día seleccionado" />
                </StackPanel>

                <Border
                    x:Name="FeedModeSelector"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="4"
                    HorizontalAlignment="Stretch"
                    Background="#0B1117"
                    BorderBrush="#273746"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="4">
                        <ToggleButton
                            x:Name="GeneralModeToggle"
                            Style="{StaticResource FeedSegment}"
                            Click="GeneralMode_Click"
                            IsChecked="True"
                            Content="General" />

                        <ToggleButton
                            x:Name="PersonModeToggle"
                            Style="{StaticResource FeedSegment}"
                            Click="PersonMode_Click"
                            Content="Por usuario" />

                        <ComboBox
                            x:Name="PersonPicker"
                            MinWidth="115"
                            MaxWidth="170"
                            Height="30"
                            Margin="4,0,0,0"
                            PlaceholderText="Usuario"
                            SelectionChanged="PersonPicker_SelectionChanged" />
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="FeedNavigation"
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <Button
                        x:Name="WeeklyScopeButton"
                        Style="{StaticResource FeedButton}"
                        Click="WeeklyScope_Click"
                        Content="Semana"
                        ToolTipService.ToolTip="Alternar entre el reporte diario y el reporte semanal local" />

                    <Button
                        Style="{StaticResource FeedButton}"
                        Click="PreviousDay_Click"
                        Content="‹"
                        ToolTipService.ToolTip="Día anterior" />

                    <Border
                        MinWidth="100"
                        Height="30"
                        Padding="10,0"
                        Background="#101A23"
                        BorderBrush="#2B485D"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="FeedDateText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            Text="18/08/2026" />
                    </Border>

                    <Button
                        Style="{StaticResource FeedButton}"
                        Click="NextDay_Click"
                        Content="›"
                        ToolTipService.ToolTip="Día siguiente" />

                    <Button
                        Style="{StaticResource FeedButton}"
                        Click="Refresh_Click"
                        Content="↻"
                        ToolTipService.ToolTip="Actualizar este día" />

                    <Button
                        Style="{StaticResource FeedButton}"
                        Click="Close_Click"
                        Content="✕"
                        ToolTipService.ToolTip="Volver al calendario" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPIs compactos: una sola lectura ejecutiva. -->
        <ScrollViewer
            Grid.Row="1"
            Margin="8,0,8,5"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border
                    MinWidth="155"
                    Padding="10,6"
                    Background="#0E1C24"
                    BorderBrush="#23516A"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Cobertura: avance observado en la fecha seleccionada, ponderado por los minutos agendados. En Por usuario solo incluye a la persona seleccionada.">
                    <StackPanel>
                        <TextBlock
                            x:Name="CoverageKpiLabel"
                            FontSize="8.5"
                            Foreground="#7DD3FC"
                            Text="COBERTURA HOY" />
                        <TextBlock
                            x:Name="CoverageKpiText"
                            Margin="0,1,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#E0F2FE"
                            Text="0%" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="145"
                    Padding="10,6"
                    Background="#211316"
                    BorderBrush="#67323B"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Rezagadas: actividades P cuyo horario ya terminó y cuyo avance Hoy es menor a 33%. Un 33% o más cuenta como sí hubo avance. Sin checklist se reporta aparte.">
                    <StackPanel>
                        <TextBlock
                            x:Name="LaggingKpiLabel"
                            FontSize="8.5"
                            Foreground="#FDA4AF"
                            Text="REZAGADAS" />
                        <TextBlock
                            x:Name="LaggingKpiText"
                            Margin="0,1,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#FFE4E6"
                            Text="0" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="145"
                    Padding="10,6"
                    Background="#10202A"
                    BorderBrush="#245169"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="R: actividades que pasaron a Revisión durante la fecha seleccionada. No significa que estén terminadas.">
                    <StackPanel>
                        <TextBlock
                            x:Name="ReviewKpiLabel"
                            FontSize="8.5"
                            Foreground="#67E8F9"
                            Text="R HOY" />
                        <TextBlock
                            x:Name="ReviewKpiText"
                            Margin="0,1,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#CFFAFE"
                            Text="0" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="145"
                    Padding="10,6"
                    Background="#102019"
                    BorderBrush="#275640"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Z: actividades que pasaron a Terminada/Aprobada durante la fecha seleccionada. No se copia del contador R.">
                    <StackPanel>
                        <TextBlock
                            x:Name="CompletedKpiLabel"
                            FontSize="9.5"
                            Foreground="#86EFAC"
                            Text="✓ Z HOY" />
                        <TextBlock
                            x:Name="CompletedKpiText"
                            Margin="0,1,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#DCFCE7"
                            Text="0" />
                    </StackPanel>
                </Border>

                <Border
                    MinWidth="210"
                    Padding="10,6"
                    Background="#171A20"
                    BorderBrush="#343C47"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Avance / Agendado: minutos equivalentes al avance de la fecha seleccionada frente a los minutos programados. Hoy usa checks completados editados ese día; Total es acumulado y no alimenta este KPI.">
                    <StackPanel>
                        <TextBlock
                            x:Name="ScheduledKpiLabel"
                            FontSize="9.5"
                            Foreground="#AAB6C2"
                            Text="AVANCE HOY / AGENDADO" />
                        <TextBlock
                            x:Name="ScheduledKpiText"
                            Margin="0,1,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#E5E7EB"
                            Text="0H" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="8,0,8,5">
            <!-- Vista general -->
            <Grid
                x:Name="GeneralViewHost"
                Visibility="Visible">
                <GridView
                    x:Name="PeopleGrid"
                    Padding="0,0,6,8"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    SizeChanged="PeopleGrid_SizeChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                ItemWidth="360" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>

            <!-- Vista por usuario -->
            <Grid
                x:Name="PersonDetailHost"
                Visibility="Collapsed">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="10,6"
                        Background="#111820"
                        BorderBrush="#2B3D4D"
                        BorderThickness="1"
                        CornerRadius="11">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="DetailInitialBadge"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Background="#123248"
                                BorderBrush="#2B698E"
                                BorderThickness="1"
                                CornerRadius="16">
                                <TextBlock
                                    x:Name="DetailInitialText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#BAE6FD"
                                    Text="B" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="DetailPersonName"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F8FAFC"
                                    Text="Brian" />
                                <TextBlock
                                    x:Name="DetailPersonSummary"
                                    FontSize="9.5"
                                    Foreground="#8FA3B5"
                                    Text="Cobertura 0% · 0 actividades" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Style="{StaticResource FeedButton}"
                                Click="GeneralMode_Click"
                                Content="← General" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel
                            x:Name="PersonDetailItems"
                            Padding="0,0,4,6"
                            Spacing="7" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Reporte semanal: se construye únicamente desde fotografías locales. -->
            <Grid
                x:Name="WeeklyReportHost"
                Visibility="Collapsed">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel
                        x:Name="WeeklyReportItems"
                        Padding="0,0,4,8"
                        Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- Estado vacío -->
            <Border
                x:Name="FeedEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,18"
                Background="#151B22"
                BorderBrush="#304252"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel Spacing="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="#7DD3FC"
                        Text="AVANCE" />
                    <TextBlock
                        x:Name="FeedEmptyText"
                        MaxWidth="500"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="#CBD5E1"
                        Text="No hay actividades para analizar en este día." />
                </StackPanel>
            </Border>

            <!-- Loader no bloquea con pantalla en blanco: conserva el último Feed debajo. -->
            <Border
                x:Name="FeedLoadingBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,12,0"
                Padding="10,7"
                Background="#E6111A22"
                BorderBrush="#31526A"
                BorderThickness="1"
                CornerRadius="9"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ProgressRing
                        Width="15"
                        Height="15"
                        IsActive="True"
                        Foreground="#38BDF8" />
                    <TextBlock
                        x:Name="FeedLoadingText"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="#C7D2DE"
                        Text="Preparando avance…" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="FeedFooter"
            Grid.Row="3"
            Margin="8,0,8,6"
            Padding="8,4"
            Background="#0D1319"
            BorderBrush="#243442"
            BorderThickness="1"
            CornerRadius="9">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="7,2"
                    Background="#122331"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="9"
                        Foreground="#7DD3FC"
                        Text="SEGUIMIENTO" />
                </Border>

                <TextBlock
                    x:Name="FeedStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="#7F93A5"
                    Text="Avance diario: solo cambios observados hoy; el progreso histórico no suma."
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    x:Name="FeedSourceText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="#64748B"
                    Text="Sin cargar" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
