<Page
    x:Class="Anfeta.UI.Views.LinkAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="420">

        <StackPanel Spacing="16">

            <TextBlock Text="Vincular cuenta"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBox Header="Correo electrónico"
                     PlaceholderText="correo@empresa.com"
                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}"
                       Visibility="Collapsed" />

            <!-- SIN converter: se controla con CanLink -->
            <Button Content="Vincular cuenta"
                    Command="{Binding LinkCommand}"
                    IsEnabled="{Binding CanLink}" />

            <Button Content="Cancelar"
                    Click="OnCancelClicked" />

        </StackPanel>
    </Grid>
</Page>
