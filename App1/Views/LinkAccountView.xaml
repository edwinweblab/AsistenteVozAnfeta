<Page
    x:Class="Anfeta.UI.Views.LinkAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <Page.Resources>
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#10FFFFFF"/>
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainCard.MaxWidth" Value="500"/>
                        <Setter Target="MainCard.Margin" Value="20"/>
                        <Setter Target="InfoPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainCard.MaxWidth" Value="500"/>
                        <Setter Target="MainCard.Margin" Value="0,0,32,0"/>
                        <Setter Target="InfoPanel.Visibility" Value="Visible"/>
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="340"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Card principal - LOGIN MODE -->
            <Border x:Name="LoginCard" Grid.Column="0" Style="{StaticResource GlassBorder}">
                <StackPanel Spacing="28" MinWidth="440">
                    <!-- Logo + Título -->
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AnfetaAccentBrush}"
                                ToolTipService.ToolTip="Weblab Platform">
                            <TextBlock Text="WL" FontSize="28" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Vincular cuenta" FontSize="32" FontWeight="SemiBold" 
                                   Foreground="#F7FAFC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Introduce tu correo para acceder" FontSize="14" 
                                   Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Inputs -->
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Correo electrónico" FontSize="13" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="#94A3B8" 
                                          HorizontalAlignment="Right"
                                          ToolTipService.ToolTip="Ingresa el correo corporativo registrado en Weblab"/>
                            </Grid>
                            <TextBox Style="{StaticResource InputBox}"
                                     PlaceholderText="correo@empresa.com"
                                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F7FAFC"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F7FAFC"/>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Error message -->
                        <Border x:Name="ErrorBorder" Visibility="Collapsed" 
                                Background="#20EF4444" BorderBrush="#EF4444" BorderThickness="1" 
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#EF4444"/>
                                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" 
                                           FontSize="13" Foreground="#FECACA" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botones -->
                    <StackPanel Spacing="12">
                        <Button Command="{Binding LinkCommand}"
                                IsEnabled="{Binding CanLink}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Vincular este dispositivo con tu cuenta de Weblab">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                                <TextBlock Text="Vincular cuenta" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OnBackToHomeClicked"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Regresar al panel principal">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                                <TextBlock Text="Volver al inicio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer link -->
                    <HyperlinkButton HorizontalAlignment="Center" Padding="0"
                                     ToolTipService.ToolTip="Contacta al administrador del sistema">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE897;" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock FontSize="12" Foreground="#94A3B8">
                                <Run Text="¿No tienes acceso? "/>
                                <Run Text="Contacta al admin" Foreground="{StaticResource AnfetaAccentBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

            <!-- Card principal - PROFILE MODE -->
            <Border x:Name="ProfileCard" Grid.Column="0" Style="{StaticResource GlassBorder}">
                <StackPanel Spacing="28" MinWidth="440">
                    <!-- Avatar + Nombre -->
                    <StackPanel Spacing="18" HorizontalAlignment="Center">
                        <!-- Avatar con sombra -->
                        <Grid Width="90" Height="90">
                            <Ellipse Fill="#40000000" Margin="0,4,0,0" Opacity="0.6"/>
                            <Border Width="90" Height="90" CornerRadius="45" 
                                    Background="{StaticResource AnfetaAccentBrush}"
                                    BorderThickness="3" BorderBrush="#20FFFFFF"
                                    ToolTipService.ToolTip="Avatar del usuario">
                                <TextBlock Text="{Binding AvatarInitial, FallbackValue='U'}" 
                                           FontSize="36" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding UserProfile.FullName, FallbackValue='Usuario'}" 
                                       FontSize="30" FontWeight="SemiBold" 
                                       Foreground="#F7FAFC" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE715;" FontSize="14" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding UserProfile.Email, FallbackValue=''}" 
                                           FontSize="14" Foreground="#94A3B8"
                                           ToolTipService.ToolTip="Correo electrónico registrado"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Información de cuenta -->
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource InfoCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" 
                                        Background="#14FF6B35" 
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Fecha de registro">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="20" 
                                              Foreground="{StaticResource AnfetaAccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Miembro desde" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding FormattedCreatedAt, FallbackValue='--'}" 
                                               FontSize="16" FontWeight="SemiBold" Foreground="#F7FAFC" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InfoCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" 
                                        Background="#143EC8A0" 
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Última actividad registrada">
                                    <FontIcon Glyph="&#xE916;" FontSize="20" Foreground="#34D399"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Última actividad" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding FormattedUpdatedAt, FallbackValue='--'}" 
                                               FontSize="16" FontWeight="SemiBold" Foreground="#F7FAFC" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Botones -->
                    <StackPanel Spacing="12">
                        <Button Command="{Binding SignOutCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Cerrar sesión y desvincular este dispositivo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xF3B1;" FontSize="16"/>
                                <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OnBackToHomeClicked"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Regresar al panel principal">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE80F;" FontSize="16"/>
                                <TextBlock Text="Volver al inicio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Panel informativo -->
            <StackPanel x:Name="InfoPanel" Grid.Column="1" Spacing="18" 
                        VerticalAlignment="Center" Margin="32,0,0,0">
                <Border Background="#14FF6B35" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{StaticResource AnfetaAccentBrush}"/>
                            <TextBlock Text="Acceso seguro" FontSize="18" FontWeight="SemiBold" Foreground="#F7FAFC"/>
                        </StackPanel>
                        <TextBlock Text="Usa las credenciales del equipo para acceder. El token permanecerá almacenado de forma segura." 
                                   FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Border Background="#143EC8A0" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#34D399"/>
                            <TextBlock Text="Sincronización automática" FontSize="14" FontWeight="SemiBold" Foreground="#F7FAFC"/>
                        </StackPanel>
                        <TextBlock Text="Los datos se sincronizan en tiempo real con el servidor." 
                                   FontSize="12" Foreground="#A7F3D0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>