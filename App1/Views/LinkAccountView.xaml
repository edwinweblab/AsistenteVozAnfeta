<Page
    x:Class="Anfeta.UI.Views.LinkAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <Page.Resources>
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="40,36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22000000" Offset="0.0"/>
                        <GradientStop Color="#14000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8C7B6E"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InfoPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InfoPanel.Visibility" Value="Visible"/>
                        <Setter Target="RootGrid.ColumnDefinitions[1].Width" Value="320"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════ LOGIN CARD ══════════════ -->
            <Border x:Name="LoginCard" Grid.Column="0" Style="{StaticResource GlassBorder}" MinWidth="420">
                <StackPanel Spacing="28">

                    <!-- Encabezado -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="34"
                                Background="{StaticResource AnfetaAccentBrush}"
                                HorizontalAlignment="Center"
                                ToolTipService.ToolTip="Weblab Platform">
                            <TextBlock Text="WL" FontSize="26" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Vincular cuenta" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#F7FAFC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Accede con tus credenciales corporativas de Weblab"
                                       FontSize="13" Foreground="#6B5F56" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}"/>

                    <!-- Campos -->
                    <StackPanel Spacing="16">

                        <!-- Correo -->
                        <StackPanel Spacing="0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CORREO ELECTRÓNICO"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE715;" FontSize="13" Foreground="#6B5F56"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Correo corporativo registrado en Weblab"/>
                            </Grid>
                            <TextBox Style="{StaticResource InputBox}"
                                     PlaceholderText="correo@empresa.com"
                                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F7FAFC"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F7FAFC"/>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Teléfono -->
                        <StackPanel Spacing="0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TELÉFONO"
                                           VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE717;" FontSize="13" Foreground="#6B5F56"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Número de teléfono (solo dígitos)"/>
                            </Grid>
                            <TextBox Style="{StaticResource InputBox}"
                                     PlaceholderText="Ej. 7711234567"
                                     Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F7FAFC"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F7FAFC"/>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Error — rojo se conserva -->
                        <Border x:Name="ErrorBorder" Visibility="Collapsed"
                                Background="#1AEF4444" BorderBrush="#60EF4444" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#EF4444"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}"
                                           FontSize="13" Foreground="#FCA5A5" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botón principal -->
                    <Button Command="{Binding LinkCommand}"
                            IsEnabled="{Binding CanLink}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" Height="48"
                            ToolTipService.ToolTip="Vincular este dispositivo con tu cuenta de Weblab">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                            <TextBlock Text="Vincular cuenta" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Footer -->
                    <HyperlinkButton HorizontalAlignment="Center" Padding="0"
                                     ToolTipService.ToolTip="Contacta al administrador del sistema">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE897;" FontSize="12" Foreground="#6B5F56"
                                      VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="#6B5F56">
                                <Run Text="¿Sin acceso? "/>
                                <Run Text="Contacta al admin"
                                     Foreground="{StaticResource AnfetaAccentBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </HyperlinkButton>

                </StackPanel>
            </Border>

            <!-- ══════════════ PROFILE CARD ══════════════ -->
            <Border x:Name="ProfileCard" Grid.Column="0" Style="{StaticResource GlassBorder}"
                    MinWidth="420" Visibility="Collapsed">
                <StackPanel Spacing="24">

                    <!-- Avatar + Nombre -->
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="#30000000" Margin="0,5,0,0" Opacity="0.5"/>
                            <Border Width="84" Height="84" CornerRadius="42"
                                    Background="{StaticResource AnfetaAccentBrush}"
                                    BorderThickness="2.5" BorderBrush="#25FFFFFF"
                                    ToolTipService.ToolTip="Avatar del usuario">
                                <TextBlock Text="{Binding AvatarInitial, FallbackValue='U'}"
                                           FontSize="34" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UserProfile.FullName, FallbackValue='Usuario'}"
                                       FontSize="26" FontWeight="SemiBold" Foreground="#F7FAFC"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE715;" FontSize="13" Foreground="#6B5F56"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UserProfile.Email, FallbackValue=''}"
                                           FontSize="13" Foreground="#6B5F56" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="Correo electrónico registrado"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}"/>

                    <!-- Info de cuenta -->
                    <StackPanel Spacing="10">
                        <Border Style="{StaticResource InfoCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="#14FF6B35" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Fecha de registro">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="19"
                                              Foreground="{StaticResource AnfetaAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MIEMBRO DESDE" FontSize="11"
                                               Foreground="#6B5F56" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FormattedCreatedAt, FallbackValue='--'}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#F7FAFC" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InfoCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="#143EC8A0" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Última actividad registrada">
                                    <FontIcon Glyph="&#xE916;" FontSize="19" Foreground="#34D399"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ÚLTIMA ACTIVIDAD" FontSize="11"
                                               Foreground="#6B5F56" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FormattedUpdatedAt, FallbackValue='--'}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#F7FAFC" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Cerrar sesión -->
                    <Button Command="{Binding SignOutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" Height="48"
                            ToolTipService.ToolTip="Cerrar sesión y desvincular este dispositivo">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xF3B1;" FontSize="16"/>
                            <TextBlock Text="Cerrar sesión" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ══════════════ PANEL INFO LATERAL ══════════════ -->
            <StackPanel x:Name="InfoPanel" Grid.Column="1" Spacing="14"
                        VerticalAlignment="Center" Margin="28,0,0,0">

                <!-- Naranja -->
                <Border Background="#14FF6B35" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="18"
                                      Foreground="{StaticResource AnfetaAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Acceso seguro" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#F7FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Usa las credenciales del equipo para acceder. El token se almacena de forma segura en este dispositivo."
                                   FontSize="12" Foreground="#D4C9C0" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Verde — se conserva -->
                <Border Background="#143EC8A0" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#34D399" VerticalAlignment="Center"/>
                            <TextBlock Text="Sincronización automática" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F7FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Los datos se sincronizan en tiempo real con el servidor de Weblab."
                                   FontSize="12" Foreground="#A7F3D0" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Azul frío → naranja cálido -->
                <Border Background="#14F97316" CornerRadius="14" Padding="20,18"
                        BorderThickness="1" BorderBrush="#14FFFFFF">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="#FB923C" VerticalAlignment="Center"/>
                            <TextBlock Text="Solo lectura local" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F7FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="El token solo se almacena localmente. No se comparte con terceros."
                                   FontSize="12" Foreground="#FDBA74" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Botón volver -->
        <Button Click="OnBackToHomeClicked"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Background="Transparent" BorderThickness="1" BorderBrush="#25FFFFFF"
                CornerRadius="10" Padding="14,10"
                ToolTipService.ToolTip="Regresar al panel principal">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#12FFFFFF"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#35FFFFFF"/>
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="#8C7B6E" VerticalAlignment="Center"/>
                <TextBlock Text="Volver al inicio" FontSize="13" Foreground="#8C7B6E" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

    </Grid>
</Page>