<Page
    x:Class="Anfeta.UI.Views.AllowedAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

	<ScrollViewer>
		<Grid Padding="24" RowSpacing="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ================= HEADER ================= -->
			<StackPanel Grid.Row="0" Spacing="6">
				<TextBlock Text="Aplicaciones Permitidas"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F7FAFC"/>
				<TextBlock Text="Selecciona apps instaladas, habilítalas y define sinónimos para comandos de voz."
                           FontSize="13"
                           Foreground="#CBD5E1"/>
			</StackPanel>

			<!-- ================= ACTIONS (TOP) ================= -->
			<StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12">
				<Button Content="Re-escanear apps instaladas"
                        Padding="14,10"
                        CornerRadius="10"
                        Command="{Binding RescanCommand}"/>

				<Button Content="Agregar manualmente (.exe)"
                        Padding="14,10"
                        CornerRadius="10"
                        Command="{Binding AddManualCommand}"/>
			</StackPanel>

			<!-- ================= LISTA ================= -->
			<Border Grid.Row="2"
                    Background="{ThemeResource AnfetaNeutral900}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">

				<StackPanel Spacing="16">

					<!-- Título sección -->
					<StackPanel>
						<TextBlock Text="Aplicaciones detectadas"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#F7FAFC"/>
						<TextBlock Text="Apps encontradas en el sistema. Activa solo las que el asistente puede abrir."
                                   FontSize="12"
                                   Foreground="#94A3B8"/>
					</StackPanel>

					<!-- Encabezados tipo tabla -->
					<Border Background="#0B1220"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="240"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="Aplicación"
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

							<TextBlock Grid.Column="1"
                                       Text="Acciones"
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
						</Grid>
					</Border>

					<!-- LISTVIEW -->
					<ListView ItemsSource="{Binding AllowedApps}"
                              SelectionMode="None"
                              Background="Transparent">

						<ListView.ItemContainerStyle>
							<Style TargetType="ListViewItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
								<Setter Property="Padding" Value="0"/>
								<Setter Property="Margin" Value="0,0,0,10"/>
								<Setter Property="Background" Value="Transparent"/>
							</Style>
						</ListView.ItemContainerStyle>

						<ListView.ItemTemplate>
							<DataTemplate>
								<Border Background="#0F172A"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">

									<Grid ColumnSpacing="14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="240"/>
										</Grid.ColumnDefinitions>

										<!-- INFO APP -->
										<StackPanel Spacing="4">
											<TextBlock Text="{Binding FriendlyName}"
                                                       Foreground="#E2E8F0"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>

											<StackPanel Orientation="Horizontal" Spacing="10">
												<TextBlock Text="{Binding ExecutableName}"
                                                           Foreground="#94A3B8"
                                                           FontSize="12"/>
												<TextBlock Text="{Binding Category}"
                                                           Foreground="#64748B"
                                                           FontSize="12"/>
											</StackPanel>

											<TextBlock Text="{Binding ExecutablePath}"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.9"/>
										</StackPanel>

										<!-- ACCIONES -->
										<StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Spacing="10">

											<StackPanel HorizontalAlignment="Right" Spacing="6">
												<TextBlock Text="Permitida"
                                                           Foreground="#CBD5E1"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"/>

												<ToggleSwitch IsOn="{Binding Enabled, Mode=TwoWay}"
                                                              Toggled="AllowedToggle_Toggled"/>
											</StackPanel>

											<StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="10">

												<Button Content="Sinónimos..."
                                                        Padding="12,8"
                                                        CornerRadius="10"
                                                        Click="EditSynonyms_Click"/>

											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ListView.ItemTemplate>

					</ListView>

					<!-- Estado -->
					<TextBlock Text="{Binding Status}"
                               Foreground="#94A3B8"
                               FontSize="12"/>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</Page>