<Page
    x:Class="Anfeta.UI.Views.AllowedAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="28">

            <!-- HEADER -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Aplicaciones Permitidas"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Selecciona aplicaciones instaladas, habilítalas y define sinónimos para comandos de voz."
                               FontSize="12"
                               Foreground="#CBD5E1"/>
                </StackPanel>
            </Grid>

            <!-- SECCIÓN ACCIONES -->
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="3"
                            Height="18"
                            CornerRadius="2"
                            Background="{StaticResource AnfetaAccentBrush}"/>
                    <FontIcon FontSize="14"
                              Foreground="{StaticResource AnfetaAccentBrush}"
                              Glyph="&#xE71D;"/>
                    <TextBlock Text="GESTIÓN DE APLICACIONES"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               CharacterSpacing="100"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6"/>

                        <StackPanel Grid.Column="1"
                                    Spacing="14"
                                    Padding="18,16">

                            <StackPanel Spacing="3">
                                <TextBlock Text="Escanear o agregar aplicaciones"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Detecta apps instaladas en el sistema o agrega manualmente un ejecutable permitido."
                                           FontSize="11"
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Re-escanear apps instaladas"
                                        Padding="14,10"
                                        Click="Rescan_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button Content="Agregar manualmente (.exe)"
                                        Padding="14,10"
                                        Click="AddManual_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECCIÓN LISTA -->
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="3"
                            Height="18"
                            CornerRadius="2"
                            Background="{StaticResource AnfetaAccentBrush}"/>
                    <FontIcon FontSize="14"
                              Foreground="{StaticResource AnfetaAccentBrush}"
                              Glyph="&#xE8D7;"/>
                    <TextBlock Text="APLICACIONES DETECTADAS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               CharacterSpacing="100"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Buscador y paginación -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5"/>

                        <StackPanel Grid.Column="1"
                                    Spacing="12"
                                    Padding="16">

                            <AutoSuggestBox PlaceholderText="Buscar por nombre, ejecutable, ruta, categoría o clave..."
                                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            QueryIcon="Find"
                                            Background="#14FFFFFF"
                                            Foreground="White"
                                            BorderBrush="#22FFFFFF"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding PaginationSummary}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <Button Content="Anterior"
                                            Command="{Binding PreviousPageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,8"/>

                                    <TextBlock Text="{Binding CurrentPageDisplay}"
                                               Foreground="#CBD5E1"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <Button Content="Siguiente"
                                            Command="{Binding NextPageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Encabezado -->
                <Border Background="#080C14"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="170"/>
                            <ColumnDefinition Width="2.4*" MinWidth="220"/>
                            <ColumnDefinition Width="1.1*" MinWidth="100"/>
                            <ColumnDefinition Width="1.1*" MinWidth="110"/>
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="APLICACIÓN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   CharacterSpacing="80"/>

                        <TextBlock Grid.Column="1"
                                   Text="RUTA"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   CharacterSpacing="80"/>

                        <TextBlock Grid.Column="2"
                                   Text="CATEGORÍA"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   CharacterSpacing="80"/>

                        <TextBlock Grid.Column="3"
                                   Text="ESTADO"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   CharacterSpacing="80"/>

                        <TextBlock Grid.Column="4"
                                   Text="ACCIONES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   CharacterSpacing="80"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Lista -->
                <ListView ItemsSource="{Binding PagedAllowedApps}"
                          SelectionMode="None"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource AnfetaAccentBrush}"
                                            CornerRadius="12,0,0,12"
                                            Opacity="0.5"/>

                                    <Grid Grid.Column="1"
                                          Padding="14,12"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="170"/>
                                            <ColumnDefinition Width="2.4*" MinWidth="220"/>
                                            <ColumnDefinition Width="1.1*" MinWidth="100"/>
                                            <ColumnDefinition Width="1.1*" MinWidth="110"/>
                                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Aplicación -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    VerticalAlignment="Center">
                                            <Border Width="34"
                                                    Height="34"
                                                    CornerRadius="10"
                                                    Background="#14FFFFFF"
                                                    BorderBrush="#22FFFFFF"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="&#xE71D;"
                                                          Foreground="{StaticResource AnfetaAccentBrush}"
                                                          FontSize="16"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding FriendlyName}"
                                                           Foreground="#FFFFFF"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExecutableName}"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Ruta -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ExecutablePath}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"/>

                                        <!-- Categoría -->
                                        <Border Grid.Column="2"
                                                Padding="8,4"
                                                CornerRadius="6"
                                                Background="#14FFFFFF"
                                                BorderBrush="#18FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Estado -->
                                        <StackPanel Grid.Column="3"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Permitida"
                                                       Foreground="#CBD5E1"
                                                       FontSize="11"/>

                                            <ToggleSwitch IsOn="{Binding Enabled, Mode=TwoWay}"
                                                          Toggled="AllowedToggle_Toggled"
                                                          OnContent="Sí"
                                                          OffContent="No"
                                                          HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <!-- Acciones -->
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Width="36"
                                                    Height="36"
                                                    Click="EditSynonyms_Click"
                                                    Tag="{Binding}"
                                                    Background="#14FFFFFF"
                                                    BorderBrush="#22FFFFFF"
                                                    BorderThickness="1"
                                                    ToolTipService.ToolTip="Editar sinónimos">
                                                <FontIcon Glyph="&#xE8D2;"
                                                          FontSize="16"
                                                          Foreground="{StaticResource AnfetaAccentBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Estado -->
                <Border Background="#080C14"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <TextBlock Text="{Binding Status}"
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>