<ContentDialog
    x:Class="Anfeta.UI.Views.VoiceCommands.ImportVoiceCommandsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Importar comandos de voz"
    PrimaryButtonText="Importar"
    SecondaryButtonText="Cancelar"
    DefaultButton="Primary">

    <StackPanel Spacing="12">
        <TextBlock Text="Pega aquí el TXT (formato: palabra == token). Se agrupa por token y se crean sinónimos." TextWrapping="Wrap" />

        <TextBox
            x:Name="InputBox"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="220"
            PlaceholderText="Ej: transaccion == ttran" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton x:Name="MergeRadio" Content="Merge (agregar/actualizar)" IsChecked="True"/>
            <RadioButton x:Name="ReplaceRadio" Content="Replace (reemplazar todo)"/>
        </StackPanel>

        <TextBlock x:Name="PreviewText" Opacity="0.85" Text="Aún no analizado." TextWrapping="Wrap"/>

        <Button Content="Analizar" Click="Analyze_Click" HorizontalAlignment="Left"/>
    </StackPanel>
</ContentDialog>