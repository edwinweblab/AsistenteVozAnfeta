<ContentDialog
    x:Class="Anfeta.UI.Dialogs.HotkeyPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configurar Atajo de Teclado"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary">
    <StackPanel
        Spacing="16"
        Padding="8"
        KeyDown="OnKeyDown"
        IsTabStop="True">
        <TextBlock
            Text="Presiona la combinación de teclas que deseas usar:"
            FontSize="14"
            TextWrapping="Wrap"/>
        <Border
            Padding="24,16"
            HorizontalAlignment="Stretch">
            <TextBlock
                x:Name="TxtPreview"
                Text="Presiona teclas..."
                FontSize="18"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>
        </Border>
        <TextBlock
            x:Name="TxtWarning"
            Text="Debe incluir modificadores (Ctrl, Alt, Shift o Win) y una tecla."
            FontSize="12"
            Visibility="Collapsed"
            TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>