<ContentDialog
    x:Class="Anfeta.UI.Views.Dialogs.SavedSearchFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Edit Filter"
    MinWidth="720"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="4" Spacing="16">

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="Filter Identity" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Name" />
                <TextBox
                    x:Name="NameTextBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    PlaceholderText="Ej. Revisiones NNEFT" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Description" />
                <TextBox
                    x:Name="DescriptionTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    PlaceholderText="Descripción opcional del filtro" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    VerticalAlignment="Top"
                    Text="Search" />
                <TextBox
                    x:Name="QueryTextBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    MinHeight="90"
                    AcceptsReturn="True"
                    PlaceholderText="Ej. aprtqqw|prtqqw|rtqqw aavel"
                    TextWrapping="Wrap" />
            </Grid>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Matching Options" />

            <Grid ColumnSpacing="24" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox
                    x:Name="MatchCaseCheckBox"
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="Match case" />


                <CheckBox
                    x:Name="MatchPathCheckBox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="Match path" />

            </Grid>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Sort" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Sort by" />

                <ComboBox
                    x:Name="SortByComboBox"
                    Grid.Column="1"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Name (A-Z)" Tag="name_asc" />
                    <ComboBoxItem Content="Name (Z-A)" Tag="name_desc" />
                    <ComboBoxItem Content="Modified (newest)" Tag="modified_desc" />
                    <ComboBoxItem Content="Modified (oldest)" Tag="modified_asc" />
                    <ComboBoxItem Content="Size (largest)" Tag="size_desc" />
                    <ComboBoxItem Content="Size (smallest)" Tag="size_asc" />
                    <ComboBoxItem Content="Extension (A-Z)" Tag="ext_asc" />
                </ComboBox>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>