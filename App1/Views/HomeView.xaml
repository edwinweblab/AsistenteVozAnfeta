<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF"/>

        <!-- Botón del micrófono circular -->
        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Panel glass -->
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel lateral -->
        <Style x:Key="SidePanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A000000" Offset="0.0"/>
                        <GradientStop Color="#10000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Badge de estado -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Ítem del feed de actividad -->
        <Style x:Key="ActivityItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
        </Style>
    </Page.Resources>

    <Grid>

        <!-- ══ LAYOUT PRINCIPAL: Header + Body + Footer ══ -->
        <Grid Padding="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════ HEADER ══════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Título izquierda -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="ANFETA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#374151"
                               CharacterSpacing="200"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#F7FAFC"/>
                </StackPanel>

                <!-- Badges centrados -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Border Style="{StaticResource StatusBadge}"
                            Background="#14FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding CurrentLanguageInfo}"
                                       FontSize="11"
                                       Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge escuchando (solo visible cuando activo) -->
                    <Border x:Name="MicStatusBadge"
                            Style="{StaticResource StatusBadge}"
                            Background="#1AFF6B35"
                            BorderBrush="#30FF6B35"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FF6B35"/>
                            <TextBlock x:Name="MicStatusText"
                                       Text="Escuchando"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FF6B35"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botón ayuda derecha -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="Habla normal, yo me encargo del resto"
                               FontSize="12"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>
                    <Button x:Name="HelpButton"
                            Width="36" Height="36"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            ToolTipService.ToolTip="Solucionar problemas con el micrófono">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF"/>
                        </Button.Resources>
                        <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="#94A3B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Separador header -->
            <Border Grid.Row="0"
                    Height="1"
                    Background="#12FFFFFF"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,-1"/>

            <!-- ══════════════ BODY: 3 COLUMNAS ══════════════ -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol"  Width="260"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition x:Name="RightCol" Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- ══ COLUMNA IZQUIERDA: Panel de estado dinámico ══ -->
                <Border Grid.Column="0" Style="{StaticResource SidePanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera panel estado -->
                        <Border Grid.Row="0"
                                Padding="16,14,16,12"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="#34D399"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="ESTADO DEL SISTEMA"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           CharacterSpacing="150"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Feed de estado scrollable -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,10">
                            <StackPanel Spacing="8">

                                <!-- Panel de mensaje de info (dinámico, bindeable) -->
                                <Border Visibility="{Binding ShowInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource ActivityItem}"
                                        Background="#1234D399"
                                        BorderBrush="#2034D399">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#34D399"/>
                                            <TextBlock Text="Notificación"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#34D399"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InfoMessage}"
                                                   FontSize="12"
                                                   Foreground="#A7F3D0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ítem: Texto reconocido -->
                                <Border Style="{StaticResource ActivityItem}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="#475569"/>
                                            <TextBlock Text="TEXTO DETECTADO"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#475569"
                                                       CharacterSpacing="100"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecognizedText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F7FAFC"
                                                   TextWrapping="Wrap"
                                                   MinHeight="20"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ítem: Última acción -->
                                <Border x:Name="CardLastAction"
                                        Style="{StaticResource ActivityItem}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#34D399"/>
                                                <TextBlock Text="ÚLTIMA ACCIÓN"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#475569"
                                                           CharacterSpacing="100"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#1A34D399"
                                                    CornerRadius="999"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="OK"
                                                           FontSize="10"
                                                           Foreground="#34D399"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap">
                                            <Run Text="Entendí: " Foreground="#475569"/>
                                            <Run Text="{Binding RecognizedText}"
                                                 Foreground="#34D399"
                                                 FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE81C;" FontSize="11" Foreground="#374151"/>
                                            <TextBlock Text="Acción ejecutada correctamente"
                                                       FontSize="11"
                                                       Foreground="#374151"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Hint de comando -->
                                <Border Style="{StaticResource ActivityItem}"
                                        Background="#08FFFFFF"
                                        BorderBrush="#0AFFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#374151"/>
                                        <TextBlock FontSize="12" Foreground="#64748B">
                                            <Run Text="Di: "/>
                                            <Run Text="&quot;Abrir navegador&quot;"
                                                 FontWeight="SemiBold"
                                                 Foreground="#94A3B8"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ══ COLUMNA CENTRAL: Micrófono ══ -->
                <Grid Grid.Column="2">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="28">

                        <!-- Subtítulo dinámico sobre el mic -->
                        <Border HorizontalAlignment="Center"
                                CornerRadius="999"
                                Padding="16,8"
                                Background="#0AFFFFFF"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="Presiona el micrófono o usa el atajo"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Micrófono con anillos reactivos -->
                        <Viewbox Stretch="Uniform" MaxWidth="300" MaxHeight="300">
                            <Grid Width="300" Height="300">
                                <Ellipse x:Name="Ring1"
                                         Fill="{StaticResource RingBrush}"
                                         Opacity="0.18"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Ring2"
                                         Fill="{StaticResource RingBrush}"
                                         Opacity="0.12"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Ring3"
                                         Fill="{StaticResource RingBrush}"
                                         Opacity="0.08"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="MicGlow"
                                         Width="210" Height="210"
                                         Fill="{StaticResource AnfetaAccentBrush}"
                                         Opacity="0.18"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Grid Width="164" Height="164">
                                    <Ellipse Fill="#000000" Opacity="0.28" Margin="2,6,2,0"/>
                                    <Button x:Name="MicButton"
                                            Style="{StaticResource MicButtonStyle}"
                                            Width="164" Height="164"
                                            RenderTransformOrigin="0.5,0.5"
                                            ToolTipService.ToolTip="Presiona para hablar">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground"            Color="#FF6B35"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8A4A"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#E05020"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled"    Color="#374151"/>
                                        </Button.Resources>
                                        <Button.RenderTransform>
                                            <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0"/>
                                        </Button.RenderTransform>
                                        <FontIcon Glyph="&#xE720;" Foreground="White" FontSize="50"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Viewbox>

                        <!-- Etiqueta debajo del mic -->
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- ══ COLUMNA DERECHA: Actividad reciente ══ -->
                <Border Grid.Column="4" Style="{StaticResource SidePanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera actividad -->
                        <Border Grid.Row="0"
                                Padding="16,14,16,12"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="#60A5FA"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIVIDAD RECIENTE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           CharacterSpacing="150"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Lista de actividad scrollable -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,10">
                            <StackPanel x:Name="CardActivity" Spacing="6">

                                <!-- Ítem de actividad: hardcoded por ahora -->
                                <Border Style="{StaticResource ActivityItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                 Fill="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Abrir navegador"
                                                   FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="10:15" FontSize="11"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE73E;" Foreground="#34D399" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ActivityItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                 Fill="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Crear actividad"
                                                   FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="09:45" FontSize="11"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE73E;" Foreground="#34D399" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ActivityItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                 Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Eliminar archivo"
                                                   FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="08:30" FontSize="11"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xEA39;" Foreground="#EF4444" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Separador -->
                                <Border Height="1" Background="#0AFFFFFF" Margin="0,4"/>

                                <!-- Ítem vacío placeholder -->
                                <Border Style="{StaticResource ActivityItem}"
                                        Background="#06FFFFFF"
                                        BorderBrush="#08FFFFFF">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="#1F2937"/>
                                        <TextBlock Text="El historial aparecerá aquí"
                                                   FontSize="12"
                                                   Foreground="#1F2937"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>

            <!-- ══════════════ FOOTER ══════════════ -->
            <Border Grid.Row="2"
                    Background="#08FFFFFF"
                    BorderBrush="#12FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="16,10"
                    Margin="-20,0,-20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE720;" FontSize="12" Foreground="#374151"/>
                            <TextBlock x:Name="TxtInputDevice"
                                       Text="Entrada: No configurado"
                                       FontSize="12"
                                       Foreground="#4B5563"/>
                        </StackPanel>
                        <Border Width="1" Height="14" Background="#1F2937" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="#374151"/>
                            <TextBlock x:Name="TxtOutputDevice"
                                       Text="Salida: No configurado"
                                       FontSize="12"
                                       Foreground="#4B5563"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- ══ VISUAL STATES responsive ══ -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftCol.Width"  Value="0"/>
                        <Setter Target="RightCol.Width" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftCol.Width"  Value="260"/>
                        <Setter Target="RightCol.Width" Value="260"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>
</Page>
