<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF" />

        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#1C000000" />
                        <GradientStop Offset="1.0" Color="#10000000" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5,12,5" />
        </Style>

        <Style x:Key="ActivityRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10,12,10" />
            <Setter Property="Background" Value="#0CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
        </Style>

        <!--  Template reutilizable para cada item del historial de comandos  -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <Border Style="{StaticResource ActivityRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Hora  -->
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#4A3E36"
                        Text="{Binding Time}" />

                    <!--  Texto del comando  -->
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#D4C9C0"
                        MaxLines="1"
                        Text="{Binding InputText}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Chip categoría  -->
                    <Border
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="7,3,7,3"
                        VerticalAlignment="Center"
                        Background="#14FB923C"
                        BorderBrush="#25FB923C"
                        BorderThickness="1"
                        CornerRadius="999">
                        <TextBlock
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="#FB923C"
                            Text="{Binding Category}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <!--  Chip de velocidad TTS: RadioButton sin indicador circular, estilo píldora  -->
        <Style x:Key="SpeedChipStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,5,14,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="RootBorder"
                            Background="#12FFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#CCFF6B35" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#FFFF6B35" />
                                            <Setter Target="ContentText.Foreground" Value="#FFFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#12FFFFFF" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#18FFFFFF" />
                                            <Setter Target="ContentText.Foreground" Value="#55FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.80" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.60" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.35" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="ContentText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="#55FFFFFF"
                                Text="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Botón ícono TTS: cuadrado compacto, sin borde  -->
        <Style x:Key="TtsIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Padding="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ══════════════ HEADER ══════════════  -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        CharacterSpacing="250"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#8C7B6E"
                        Text="ANFETA" />
                </StackPanel>

                <!--  Badge idioma  -->
                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="#1AFB923C"
                    BorderBrush="#30FB923C"
                    BorderThickness="1"
                    Style="{StaticResource StatusBadge}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="11"
                            Foreground="#FB923C"
                            Glyph="&#xE774;" />
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FDBA74"
                            Text="{Binding CurrentLanguageInfo}" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        x:Name="MicStatusBadge"
                        Background="#1AFF6B35"
                        BorderBrush="#30FF6B35"
                        BorderThickness="1"
                        Style="{StaticResource StatusBadge}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#FF6B35" />
                            <TextBlock
                                x:Name="MicStatusText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF6B35"
                                Text="Escuchando" />
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="HelpButton"
                        Width="36"
                        Height="36"
                        Background="#14FFFFFF"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        ToolTipService.ToolTip="Solucionar problemas con el micrófono">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF" />
                        </Button.Resources>
                        <FontIcon
                            FontSize="14"
                            Foreground="#8C7B6E"
                            Glyph="&#xE897;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="0"
                Height="1"
                Margin="0,0,0,-1"
                VerticalAlignment="Bottom"
                Background="#0EFFFFFF" />

            <!--  ══════════════ PANEL NOTIFICACIONES ══════════════  -->
            <Border
                x:Name="NotifStrip"
                Grid.Row="1"
                Padding="0"
                Style="{StaticResource PanelCard}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="28,14,28,14">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse
                                x:Name="NotifDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="#34D399" />
                            <TextBlock
                                x:Name="NotifHeaderText"
                                VerticalAlignment="Center"
                                CharacterSpacing="180"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#8C7B6E"
                                Text="NOTIFICACIONES" />
                        </StackPanel>
                        <Border
                            x:Name="NotifCountBadge"
                            Padding="8,3,8,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#14FB923C"
                            CornerRadius="999"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="NotifCountText"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FB923C" />
                        </Border>
                    </Grid>
                    <Border
                        Grid.Row="0"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="#0EFFFFFF" />

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="0,14,0,16"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="0.5*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="NotificationsPanel"
                                Grid.Column="1"
                                Spacing="12" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ══════════════ CONTENEDOR PRINCIPAL ══════════════  -->
            <Border
                Grid.Row="3"
                Padding="0"
                Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="*" />
                        <ColumnDefinition x:Name="LeftDiv" Width="1" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition x:Name="RightDiv" Width="1" />
                        <ColumnDefinition x:Name="RightCol" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ══ COLUMNA IZQUIERDA: Actividad Reciente ══  -->
                    <Grid x:Name="CardActivity" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header con contador del día  -->
                        <Border
                            Grid.Row="0"
                            Padding="20,14,20,14"
                            BorderBrush="#0EFFFFFF"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="#FB923C" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        CharacterSpacing="180"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#FB923C"
                                        Text="ACTIVIDAD RECIENTE" />
                                </StackPanel>

                                <!--  Badge: N comandos hoy  -->
                                <Border
                                    Padding="8,3,8,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#0EFB923C"
                                    BorderBrush="#20FB923C"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#FB923C"
                                            Text="{Binding TodayCommandCount}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#8C7B6E"
                                            Text="hoy" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Lista de comandos recientes  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Padding="12,12,12,12"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">

                                <!--  Estado vacío: se oculta cuando hay items  -->
                                <Border
                                    x:Name="EmptyHistoryState"
                                    Padding="20,32,20,32"
                                    HorizontalAlignment="Center"
                                    Visibility="Visible">
                                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="28"
                                            Foreground="#2A2420"
                                            Glyph="&#xE721;" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#4A3E36"
                                            Text="Sin actividad aún"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!--  ItemsRepeater bindeado a RecentCommands  -->
                                <ItemsRepeater
                                    x:Name="RecentCommandsList"
                                    ItemTemplate="{StaticResource HistoryItemTemplate}"
                                    ItemsSource="{Binding RecentCommands}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Column="1" Background="#0EFFFFFF" />

                    <!--  ══ COLUMNA CENTRAL: Micrófono ══  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Spacing="8">
                            <Border
                                Padding="14,6,14,6"
                                HorizontalAlignment="Center"
                                Background="#1A34D399"
                                BorderBrush="#3034D399"
                                BorderThickness="1"
                                CornerRadius="999">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        x:Name="StatusDot"
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="#34D399" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#A7F3D0"
                                        Text="{Binding StatusText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">

                            <Viewbox
                                MaxWidth="240"
                                MaxHeight="240"
                                HorizontalAlignment="Center"
                                Stretch="Uniform">
                                <Grid Width="240" Height="240">
                                    <Ellipse
                                        x:Name="Ring1"
                                        Fill="{StaticResource RingBrush}"
                                        Opacity="0.18"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse
                                        x:Name="Ring2"
                                        Fill="{StaticResource RingBrush}"
                                        Opacity="0.12"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse
                                        x:Name="Ring3"
                                        Fill="{StaticResource RingBrush}"
                                        Opacity="0.08"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse
                                        x:Name="MicGlow"
                                        Width="176"
                                        Height="176"
                                        Fill="{StaticResource AnfetaAccentBrush}"
                                        Opacity="0.18"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Grid Width="138" Height="138">
                                        <Ellipse
                                            Margin="2,6,2,0"
                                            Fill="#000000"
                                            Opacity="0.26" />
                                        <Button
                                            x:Name="MicButton"
                                            Width="138"
                                            Height="138"
                                            RenderTransformOrigin="0.5,0.5"
                                            Style="{StaticResource MicButtonStyle}"
                                            ToolTipService.ToolTip="Presiona para hablar">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#FF6B35" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8A4A" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E05020" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#374151" />
                                            </Button.Resources>
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0" />
                                            </Button.RenderTransform>
                                            <FontIcon
                                                FontSize="42"
                                                Foreground="White"
                                                Glyph="&#xE720;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Viewbox>

                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FB923C"
                                Text="Presiona para hablar" />
                        </StackPanel>

                        <!--  Dispositivos  -->
                        <Border
                            Grid.Row="2"
                            Margin="16,0,16,18"
                            Background="#0EFFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Padding="14,10,14,10"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#FF6B35"
                                        Glyph="&#xE720;" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            CharacterSpacing="150"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#FF8A4A"
                                            Text="ENTRADA" />
                                        <TextBlock
                                            x:Name="TxtInputDevice"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#D4C9C0"
                                            MaxLines="1"
                                            Text="No configurado"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#14FFFFFF" />

                                <StackPanel
                                    Grid.Column="2"
                                    Padding="14,10,14,10"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#FB923C"
                                        Glyph="&#xE767;" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            CharacterSpacing="150"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#FB923C"
                                            Text="SALIDA" />
                                        <TextBlock
                                            x:Name="TxtOutputDevice"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#D4C9C0"
                                            MaxLines="1"
                                            Text="No configurado"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                    <Border Grid.Column="3" Background="#0EFFFFFF" />

                    <!--  ══ COLUMNA DERECHA: Detectado ══  -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="20,14,20,14"
                            BorderBrush="#0EFFFFFF"
                            BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="#FF8A4A"
                                    Glyph="&#xE8BD;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    CharacterSpacing="180"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8A4A"
                                    Text="DETECTADO" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer
                            Grid.Row="1"
                            Padding="20,16,20,20"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    MinHeight="24"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F1F5F9"
                                    Text="{Binding RecognizedText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#FB923C"
                                    Text="Esperando comando de voz..." />
                            </StackPanel>
                        </ScrollViewer>

                        <!--  Controles TTS: velocidad + pausa/detener  -->
                        <Border
                            Grid.Row="2"
                            Padding="16,10,16,14"
                            BorderBrush="#0EFFFFFF"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Chips de velocidad — Border + Tapped, sin VisualStateManager  -->
                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                                    <Border
                                        x:Name="SpeedChip1"
                                        Tag="1"
                                        Tapped="SpeedChip_Tapped"
                                        CornerRadius="6"
                                        Padding="14,5,14,5"
                                        Background="#12FFFFFF"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1">
                                        <TextBlock
                                            x:Name="SpeedChip1Text"
                                            Text="x1"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#55FFFFFF" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="Velocidad normal" />
                                        </ToolTipService.ToolTip>
                                    </Border>
                                    <Border
                                        x:Name="SpeedChip2"
                                        Tag="1.5"
                                        Tapped="SpeedChip_Tapped"
                                        CornerRadius="6"
                                        Padding="14,5,14,5"
                                        Background="#12FFFFFF"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1">
                                        <TextBlock
                                            x:Name="SpeedChip2Text"
                                            Text="x1.5"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#55FFFFFF" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="Velocidad 1.5x" />
                                        </ToolTipService.ToolTip>
                                    </Border>
                                    <Border
                                        x:Name="SpeedChip3"
                                        Tag="2"
                                        Tapped="SpeedChip_Tapped"
                                        CornerRadius="6"
                                        Padding="14,5,14,5"
                                        Background="#12FFFFFF"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1">
                                        <TextBlock
                                            x:Name="SpeedChip3Text"
                                            Text="x2"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#55FFFFFF" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="Velocidad doble" />
                                        </ToolTipService.ToolTip>
                                    </Border>
                                </StackPanel>

                                <!--  Pausar / Detener como iconos  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Button
                                        Style="{StaticResource TtsIconButtonStyle}"
                                        Command="{Binding PauseTtsCommand}">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Glyph="{Binding PauseTtsGlyph}" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding PauseTtsLabel}" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                    <Button
                                        Style="{StaticResource TtsIconButtonStyle}"
                                        Command="{Binding StopTtsCommand}">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Glyph="&#xE8D8;" />
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="Detener voz" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </Border>

            <Border Grid.Row="4" Height="0" />

        </Grid>

        <!--  ══ RESPONSIVE ══  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftCol.Width" Value="0" />
                        <Setter Target="LeftDiv.Width" Value="0" />
                        <Setter Target="RightDiv.Width" Value="0" />
                        <Setter Target="RightCol.Width" Value="0" />
                        <Setter Target="CardActivity.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftCol.Width" Value="*" />
                        <Setter Target="LeftDiv.Width" Value="1" />
                        <Setter Target="RightDiv.Width" Value="1" />
                        <Setter Target="RightCol.Width" Value="*" />
                        <Setter Target="CardActivity.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
