<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF"/>
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,24">
            <TextBlock Text="{Binding StatusText}" FontSize="30" FontWeight="SemiBold" Foreground="#F7FAFC" HorizontalAlignment="Center"/>
            <TextBlock Text="Habla normal, yo me encargo del resto" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                <Border Style="{StaticResource StatusBadge}" Background="#14FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#CBD5E1"/>
                        <TextBlock Text="{Binding CurrentLanguageInfo}" FontSize="12" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Border>
                <Border x:Name="MicStatusBadge" Style="{StaticResource StatusBadge}" Background="#14FF6B35" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FF6B35"/>
                        <TextBlock x:Name="MicStatusText" Text="Escuchando" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B35"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        <Button x:Name="HelpButton" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="40" Height="40" Background="#14FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="20" Margin="0,8,8,0"
                ToolTipService.ToolTip="¿Problemas con el micrófono? Click para ver soluciones">
            <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="#E2E8F0"/>
        </Button>
        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="1200" HorizontalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <InfoBar IsOpen="{Binding ShowInfo}" Message="{Binding InfoMessage}" Severity="Informational"/>
                    <Viewbox Stretch="Uniform" MaxWidth="280" MaxHeight="280">
                        <Grid Width="280" Height="280">
                            <Ellipse x:Name="Ring1" Fill="{StaticResource RingBrush}" Opacity="0.18" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" Fill="{StaticResource RingBrush}" Opacity="0.12" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring3" Fill="{StaticResource RingBrush}" Opacity="0.08" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MicGlow" Width="200" Height="200" Fill="{StaticResource AnfetaAccentBrush}" Opacity="0.18" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid Width="156" Height="156">
                                <Ellipse Fill="#000000" Opacity="0.30" Margin="2,6,2,0"/>
                                <Button x:Name="MicButton" Style="{StaticResource MicButtonStyle}" Width="156" Height="156" RenderTransformOrigin="0.5,0.5" ToolTipService.ToolTip="Click para hablar">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </Button.RenderTransform>
                                    <FontIcon Glyph="&#xE720;" Foreground="White" FontSize="46"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Viewbox>
                    <Border CornerRadius="999" Padding="12,7" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#18FFFFFF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#0BFFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontSize="12" Foreground="#EDF2F7">
                            <Run Text="💡 Di: "/>
                            <Run Text="&quot;Abrir navegador&quot;" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource GlassBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Texto detectado" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            <TextBlock Text="{Binding RecognizedText}" FontSize="16" Foreground="#F7FAFC" TextWrapping="Wrap" MinHeight="24"/>
                            <TextBlock FontSize="12" Foreground="#94A3B8">
                                <Run Text="Tip: "/>
                                <Run Text="Presiona el micrófono y habla con claridad."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Cards completas -->
                <Grid x:Name="CardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CardLastAction" Grid.Column="0" Style="{StaticResource GlassBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Última acción" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                <Border Background="#2034D399" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Éxito" FontSize="12" Foreground="#F7FAFC" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock FontSize="16" Foreground="#F7FAFC" TextWrapping="Wrap">
                                <Run Text="Entendí: "/>
                                <Run Text="{Binding RecognizedText}" Foreground="#34D399" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#94A3B8">
                                <Run Text="Respuesta: "/>
                                <Run Text="Acción ejecutada correctamente."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CardActivity" Grid.Column="2" Style="{StaticResource GlassBorder}">
                        <StackPanel>
                            <TextBlock Text="Actividad reciente" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Abrir navegador" FontSize="14" Foreground="#F7FAFC"/>
                                    <TextBlock Grid.Column="1" Text="10:15 AM" FontSize="12" Foreground="#94A3B8" Margin="10,0"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" Foreground="#34D399" FontSize="14"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Crear tarea" FontSize="14" Foreground="#F7FAFC"/>
                                    <TextBlock Grid.Column="1" Text="09:45 AM" FontSize="12" Foreground="#94A3B8" Margin="10,0"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" Foreground="#34D399" FontSize="14"/>
                                </Grid>
                                <TextBlock Text="Entregar informe" FontSize="12" Foreground="#94A3B8" Margin="0,-8,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Eliminar archivo" FontSize="14" Foreground="#F7FAFC"/>
                                    <TextBlock Grid.Column="1" Text="08:30 AM" FontSize="12" Foreground="#94A3B8" Margin="10,0"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xEA39;" Foreground="#EF4444" FontSize="14"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <!-- Footer: Audio Devices -->
        <Border Grid.Row="2" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtInputDevice" Text="Entrada: No configurado" FontSize="12" Foreground="#CBD5E1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtOutputDevice" Text="Salida: No configurado" FontSize="12" Foreground="#CBD5E1"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- VisualStates para responsive (único y consolidado) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="CardActivity.(Grid.Column)" Value="0"/>
                        <Setter Target="CardActivity.(Grid.Row)" Value="1"/>
                        <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="CardActivity.Margin" Value="0,14,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardLastAction.(Grid.Column)" Value="0"/>
                        <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CardActivity.(Grid.Column)" Value="2"/>
                        <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CardActivity.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>