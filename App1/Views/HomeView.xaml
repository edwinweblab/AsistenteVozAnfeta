<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Colores de marca -->
        <SolidColorBrush x:Key="AnfetaAccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="AnfetaSuccessBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="AnfetaErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="AnfetaWarningBrush" Color="#FBBF24"/>

        <!-- Neutrales -->
        <SolidColorBrush x:Key="N50"  Color="#0F172A"/>
        <SolidColorBrush x:Key="N100" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="N200" Color="#EDF2F7"/>
        <SolidColorBrush x:Key="N300" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="N400" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="N500" Color="#94A3B8"/>
        <SolidColorBrush x:Key="N700" Color="#334155"/>
        <SolidColorBrush x:Key="N900" Color="#0B1220"/>

        <!-- Fondo -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1220" Offset="0.0"/>
            <GradientStop Color="#0F172A" Offset="0.45"/>
            <GradientStop Color="#08101D" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Rings -->
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF"/>

        <!-- Estilos reutilizables -->
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource N500}"/>
        </Style>

        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="30" Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================
             SECCIÓN: HEADER CON ESTADO
             ======================================== -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,24">
            <!-- Título principal -->
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="30"
                FontWeight="SemiBold"
                Foreground="{StaticResource N200}"
                HorizontalAlignment="Center"
                TextAlignment="Center"/>

            <!-- Subtítulo -->
            <TextBlock
                Text="Habla normal, yo me encargo del resto"
                FontSize="13"
                Foreground="{StaticResource N500}"
                HorizontalAlignment="Center"/>

            <!-- Estado: Idioma + Micrófono -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                <!-- Badge: Idioma -->
                <Border Style="{StaticResource StatusBadge}" Background="#14FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" 
                                  FontSize="12" Foreground="{StaticResource N400}"/>
                        <TextBlock Text="{Binding CurrentLanguageInfo}"
                                   FontSize="12"
                                   Foreground="{StaticResource N400}"/>
                    </StackPanel>
                </Border>

                <!-- Badge: Estado del micrófono -->
                <Border x:Name="MicStatusBadge" Style="{StaticResource StatusBadge}" 
                        Background="#14FF6B35" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="#FF6B35"/>
                        <TextBlock x:Name="MicStatusText" Text="Escuchando"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF6B35"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ========================================
             SECCIÓN: BODY PRINCIPAL
             ======================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="1200">

                <!-- ========================================
                     PANEL CENTRAL: MICRÓFONO + TEXTO
                     ======================================== -->
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <!-- InfoBar de estado -->
                    <InfoBar
                        IsOpen="{Binding ShowInfo}"
                        Message="{Binding InfoMessage}"
                        Severity="Informational"/>

                    <!-- Micrófono con animaciones -->
                    <Viewbox Stretch="Uniform" MaxWidth="280" MaxHeight="280">
                        <Grid Width="280" Height="280">
                            <!-- Ring 1 -->
                            <Ellipse x:Name="Ring1"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.18"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Ring 2 -->
                            <Ellipse x:Name="Ring2"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.12"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Ring 3 -->
                            <Ellipse x:Name="Ring3"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.08"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Glow -->
                            <Ellipse x:Name="MicGlow"
                                     Width="200" Height="200"
                                     Fill="{StaticResource AnfetaAccentBrush}"
                                     Opacity="0.18"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Botón del micrófono -->
                            <Grid Width="156" Height="156">
                                <Ellipse Fill="#000000" Opacity="0.30" Margin="2,6,2,0"/>
                                <Button x:Name="MicButton"
                                        Style="{StaticResource MicButtonStyle}"
                                        Width="156" Height="156"
                                        RenderTransformOrigin="0.5,0.5"
                                        ToolTipService.ToolTip="Click para hablar">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </Button.RenderTransform>
                                    <FontIcon Glyph="&#xE720;"
                                              FontFamily="Segoe MDL2 Assets"
                                              Foreground="White"
                                              FontSize="46"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Viewbox>

                    <!-- Sugerencia de uso -->
                    <Border CornerRadius="999" Padding="12,7" HorizontalAlignment="Center"
                            BorderThickness="1" BorderBrush="#18FFFFFF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#0BFFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontSize="12" Foreground="{StaticResource N200}">
                            <Run Text="💡 Di: "/>
                            <Run Text="&quot;Abrir navegador&quot;" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>

                    <!-- Texto detectado -->
                    <Border Style="{StaticResource GlassBorder}" MaxWidth="560">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Texto detectado"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource N300}"/>

                            <TextBlock Text="{Binding RecognizedText}"
                                       FontSize="16"
                                       Foreground="{StaticResource N100}"
                                       TextWrapping="Wrap"
                                       MinHeight="24"/>

                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="Tip: "/>
                                <Run Text="Presiona el micrófono y habla con claridad."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================
                     SECCIÓN: AYUDA RÁPIDA
                     ======================================== -->
                <!-- Botón de ayuda flotante (esquina superior derecha) -->
                <Button x:Name="HelpButton"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Width="40"
                    Height="40"
                    Background="#14FFFFFF"
                    BorderBrush="#30FFFFFF"
                    CornerRadius="20"
                    Margin="0,8,8,0"
                    ToolTipService.ToolTip="¿Problemas con el micrófono? Click para ver soluciones">
                    <FontIcon Glyph="&#xE897;" 
                 FontFamily="Segoe MDL2 Assets" 
                 FontSize="16"
                 Foreground="{StaticResource N300}"/>
                </Button>

                <!-- ========================================
                     SECCIÓN: ÚLTIMA ACCIÓN
                     ======================================== -->
                <Border Style="{StaticResource GlassBorder}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Última acción"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource N300}"/>

                            <Border Background="#2034D399"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="Éxito"
                                           FontSize="12"
                                           Foreground="{StaticResource N100}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock FontSize="16" Foreground="{StaticResource N100}" TextWrapping="Wrap">
                            <Run Text="Entendí: "/>
                            <Run Text="{Binding RecognizedText}"
                                 Foreground="{StaticResource AnfetaSuccessBrush}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="Respuesta: "/>
                            <Run Text="Acción ejecutada correctamente."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>