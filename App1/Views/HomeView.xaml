<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF"/>

        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,8,0,24">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F7FAFC"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Habla normal, yo me encargo del resto"
                           FontSize="13"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,6,0,0">
                    <Border Style="{StaticResource StatusBadge}" Background="#14FFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding CurrentLanguageInfo}"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MicStatusBadge"
                            Style="{StaticResource StatusBadge}"
                            Background="#14FF6B35"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FF6B35"/>
                            <TextBlock x:Name="MicStatusText"
                                       Text="Escuchando"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FF6B35"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button x:Name="HelpButton"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Width="38" Height="38"
                    Background="#14FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,4,4,0"
                    ToolTipService.ToolTip="Solucionar problemas con el micrófono">
                <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="#94A3B8"/>
            </Button>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">

                <!-- Panel de estado (reemplaza InfoBar, no descartable) -->
                <Border Visibility="{Binding ShowInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="12"
                        Padding="16,12"
                        BorderThickness="1"
                        BorderBrush="#20FFFFFF"
                        Background="#10FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="30" Height="30"
                                CornerRadius="8"
                                Background="#1434D399">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="14"
                                      Foreground="#34D399"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding InfoMessage}"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Micrófono centrado -->
                <StackPanel Spacing="16" HorizontalAlignment="Center">

                    <Viewbox Stretch="Uniform" MaxWidth="280" MaxHeight="280">
                        <Grid Width="280" Height="280">
                            <Ellipse x:Name="Ring1"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.18"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.12"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring3"
                                     Fill="{StaticResource RingBrush}"
                                     Opacity="0.08"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="MicGlow"
                                     Width="200" Height="200"
                                     Fill="{StaticResource AnfetaAccentBrush}"
                                     Opacity="0.18"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid Width="156" Height="156">
                                <Ellipse Fill="#000000" Opacity="0.30" Margin="2,6,2,0"/>
                                <Button x:Name="MicButton"
                                        Style="{StaticResource MicButtonStyle}"
                                        Width="156" Height="156"
                                        RenderTransformOrigin="0.5,0.5"
                                        ToolTipService.ToolTip="Presiona para hablar">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground"             Color="#FF6B35"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#FF8A4A"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#E05020"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled"     Color="#374151"/>
                                    </Button.Resources>
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0"/>
                                    </Button.RenderTransform>
                                    <FontIcon Glyph="&#xE720;" Foreground="White" FontSize="46"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Viewbox>

                    <!-- Sugerencia de comando -->
                    <Border CornerRadius="999"
                            Padding="14,8"
                            HorizontalAlignment="Center"
                            BorderThickness="1"
                            BorderBrush="#18FFFFFF"
                            Background="#0AFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#475569"/>
                            <TextBlock FontSize="12" Foreground="#94A3B8">
                                <Run Text="Di: "/>
                                <Run Text="&quot;Abrir navegador&quot;"
                                     FontWeight="SemiBold"
                                     Foreground="#CBD5E1"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Texto reconocido -->
                    <Border Style="{StaticResource GlassBorder}" MaxWidth="600" HorizontalAlignment="Center">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="#475569"/>
                                <TextBlock Text="Texto detectado"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RecognizedText}"
                                       FontSize="16"
                                       Foreground="#F7FAFC"
                                       TextWrapping="Wrap"
                                       MinHeight="24"/>
                            <TextBlock FontSize="12" Foreground="#475569">
                                <Run Text="Habla con claridad frente al micrófono"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cards inferiores -->
                <Grid x:Name="CardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card: Última acción -->
                    <Border x:Name="CardLastAction"
                            Grid.Column="0"
                            Style="{StaticResource GlassBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#34D399"/>
                                    <TextBlock Text="Última acción"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#E2E8F0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#1A34D399"
                                        CornerRadius="999"
                                        Padding="10,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Completado"
                                               FontSize="12"
                                               Foreground="#34D399"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="#14FFFFFF"/>
                            <TextBlock FontSize="15" Foreground="#F7FAFC" TextWrapping="Wrap">
                                <Run Text="Entendí: " Foreground="#64748B"/>
                                <Run Text="{Binding RecognizedText}"
                                     Foreground="#34D399"
                                     FontWeight="SemiBold"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="#475569"/>
                                <TextBlock Text="Acción ejecutada correctamente"
                                           FontSize="12"
                                           Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card: Actividad reciente -->
                    <Border x:Name="CardActivity"
                            Grid.Column="2"
                            Style="{StaticResource GlassBorder}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="#94A3B8"/>
                                <TextBlock Text="Actividad reciente"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E2E8F0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Height="1" Background="#14FFFFFF"/>
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             Fill="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Abrir navegador"
                                               FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="10:15"
                                               FontSize="12" Foreground="#475569"
                                               Margin="10,0" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE73E;"
                                              Foreground="#34D399" FontSize="13"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             Fill="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Crear actividad"
                                               FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="09:45"
                                               FontSize="12" Foreground="#475569"
                                               Margin="10,0" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE73E;"
                                              Foreground="#34D399" FontSize="13"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Eliminar archivo"
                                               FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="08:30"
                                               FontSize="12" Foreground="#475569"
                                               Margin="10,0" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xEA39;"
                                              Foreground="#EF4444" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Audio Devices -->
        <Border Grid.Row="2"
                Background="#10FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="#475569"/>
                    <TextBlock x:Name="TxtInputDevice"
                               Text="Entrada: No configurado"
                               FontSize="12"
                               Foreground="#64748B"/>
                </StackPanel>
                <Border Width="1" Height="16" Background="#20FFFFFF" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#475569"/>
                    <TextBlock x:Name="TxtOutputDevice"
                               Text="Salida: No configurado"
                               FontSize="12"
                               Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Visual States responsive -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="CardActivity.(Grid.Column)" Value="0"/>
                        <Setter Target="CardActivity.(Grid.Row)" Value="1"/>
                        <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="CardActivity.Margin" Value="0,14,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardLastAction.(Grid.Column)" Value="0"/>
                        <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CardActivity.(Grid.Column)" Value="2"/>
                        <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CardActivity.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>
</Page>