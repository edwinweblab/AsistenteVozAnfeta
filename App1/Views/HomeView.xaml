<Page
    x:Class="Anfeta.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Neutrales -->
        <SolidColorBrush x:Key="N50"  Color="#0F172A"/>
        <SolidColorBrush x:Key="N100" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="N200" Color="#EDF2F7"/>
        <SolidColorBrush x:Key="N300" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="N400" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="N500" Color="#94A3B8"/>
        <SolidColorBrush x:Key="N700" Color="#334155"/>
        <SolidColorBrush x:Key="N900" Color="#0B1220"/>

        <!-- Fondo -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1220" Offset="0.0"/>
            <GradientStop Color="#0F172A" Offset="0.45"/>
            <GradientStop Color="#08101D" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Rings -->
        <SolidColorBrush x:Key="RingBrush" Color="#FFFFFFFF"/>

        <!-- Glass (para cards) -->
        <Style x:Key="GlassBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#24000000" Offset="0.0"/>
                        <GradientStop Color="#16000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource N500}"/>
        </Style>

        <!-- Estilo del botón mic -->
        <Style x:Key="MicButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource AnfetaAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="30" x:Name="Root" Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,18">
            <TextBlock
                Text="Listo para escuchar"
                FontSize="30"
                FontWeight="SemiBold"
                Foreground="{StaticResource N200}"
                HorizontalAlignment="Center"/>

            <!-- ✅ Ahora viene del VM -->
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="13"
                Foreground="{StaticResource N500}"
                HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PANEL CENTRAL -->
            <StackPanel Grid.Row="0" Spacing="14" HorizontalAlignment="Center">

                <!-- Viewbox para que el mic sea responsivo -->
                <Viewbox Stretch="Uniform" MaxWidth="320" MaxHeight="320">
                    <Grid Width="280" Height="280">

                        <!-- Ring 1 -->
                        <Ellipse x:Name="Ring1"
                                 Fill="{StaticResource RingBrush}"
                                 Opacity="0.18"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring1Scale" ScaleX="0.70" ScaleY="0.70"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Ring 2 -->
                        <Ellipse x:Name="Ring2"
                                 Fill="{StaticResource RingBrush}"
                                 Opacity="0.12"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring2Scale" ScaleX="0.62" ScaleY="0.62"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Ring 3 -->
                        <Ellipse x:Name="Ring3"
                                 Fill="{StaticResource RingBrush}"
                                 Opacity="0.08"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring3Scale" ScaleX="0.55" ScaleY="0.55"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Glow detrás del mic -->
                        <Ellipse x:Name="MicGlow"
                                 Width="200" Height="200"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AnfetaAccentBrush}"
                                 Opacity="0.18"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="MicGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Mic botón -->
                        <Grid Width="156" Height="156" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="#000000" Opacity="0.30" Margin="2,6,2,0"/>

                            <!-- ✅ Ahora ejecuta el comando del VM -->
                            <Button x:Name="MicButton"
                                    Style="{StaticResource MicButtonStyle}"
                                    Width="156" Height="156"
                                    RenderTransformOrigin="0.5,0.5"
                                    Command="{Binding ToggleMicCommand}">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="MicScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Button.RenderTransform>

                                <Grid>
                                    <FontIcon Glyph="&#xE720;"
                                              FontFamily="Segoe MDL2 Assets"
                                              Foreground="White"
                                              FontSize="46"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Viewbox>

                <!-- Hint -->
                <Border CornerRadius="999"
                        Padding="12,7"
                        HorizontalAlignment="Center"
                        BorderThickness="1"
                        BorderBrush="#18FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#0BFFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <!-- ✅ Ahora viene del VM -->
                    <TextBlock Text="{Binding LastHeard}"
                               FontSize="12"
                               Foreground="{StaticResource N200}"/>
                </Border>

            </StackPanel>

            <!-- Cards -->
            <Grid Grid.Row="1" Margin="0,18,0,0" x:Name="CardsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowCompact1" Height="Auto"/>
                    <RowDefinition x:Name="RowCompact2" Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Última acción -->
                <Border x:Name="CardLastAction" Grid.Column="0" Grid.Row="0" Style="{StaticResource GlassBorder}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Última acción"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource N300}"/>

                            <Border Grid.Column="1"
                                    Background="#2034D399"
                                    CornerRadius="999"
                                    Padding="10,4">
                                <TextBlock Text="Éxito"
                                           FontSize="12"
                                           Foreground="{StaticResource N100}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock FontSize="16" Foreground="{StaticResource N100}">
                            <Run Text="Entendí: "/>
                            <Run Text="Abrir navegador."
                                 Foreground="{StaticResource AnfetaSuccessBrush}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="Respuesta: "/>
                            <Run Text="Acción ejecutada correctamente."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Actividad reciente -->
                <Border x:Name="CardActivity" Grid.Column="1" Grid.Row="0" Style="{StaticResource GlassBorder}">
                    <StackPanel>
                        <TextBlock Text="Actividad reciente"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource N300}"
                                   Margin="0,0,0,10"/>

                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Abrir navegador" FontSize="14" Foreground="{StaticResource N100}"/>
                                <TextBlock Grid.Column="1" Text="10:15 AM" FontSize="12" Foreground="{StaticResource N500}" Margin="10,0,10,0"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                          Foreground="{StaticResource AnfetaSuccessBrush}" FontSize="14"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Crear tarea" FontSize="14" Foreground="{StaticResource N100}"/>
                                <TextBlock Grid.Column="1" Text="09:45 AM" FontSize="12" Foreground="{StaticResource N500}" Margin="10,0,10,0"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                          Foreground="{StaticResource AnfetaSuccessBrush}" FontSize="14"/>
                            </Grid>

                            <TextBlock Text="Entregar informe"
                                       FontSize="12"
                                       Foreground="{StaticResource N500}"
                                       Margin="0,-8,0,0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Eliminar archivo" FontSize="14" Foreground="{StaticResource N100}"/>
                                <TextBlock Grid.Column="1" Text="08:30 AM" FontSize="12" Foreground="{StaticResource N500}" Margin="10,0,10,0"/>
                                <FontIcon Grid.Column="2" Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                          Foreground="{StaticResource AnfetaErrorBrush}" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- VisualStates: Wide vs Compact -->
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Compact">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="CardLastAction.(Grid.Column)" Value="0"/>
                                <Setter Target="CardLastAction.(Grid.Row)" Value="0"/>
                                <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="2"/>

                                <Setter Target="CardActivity.(Grid.Column)" Value="0"/>
                                <Setter Target="CardActivity.(Grid.Row)" Value="1"/>
                                <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="CardActivity.Margin" Value="0,14,0,0"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="CardLastAction.(Grid.Column)" Value="0"/>
                                <Setter Target="CardLastAction.(Grid.Row)" Value="0"/>
                                <Setter Target="CardLastAction.(Grid.ColumnSpan)" Value="1"/>

                                <Setter Target="CardActivity.(Grid.Column)" Value="1"/>
                                <Setter Target="CardActivity.(Grid.Row)" Value="0"/>
                                <Setter Target="CardActivity.(Grid.ColumnSpan)" Value="1"/>
                                <Setter Target="CardActivity.Margin" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </Grid>
    </Grid>
</Page>
