<Page
    x:Class="Anfeta.UI.Views.ApiKeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Anfeta.UI.Data"
    Background="{StaticResource BgGradient}">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="API Keys"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F7FAFC"/>
                <TextBlock Text="Administra tus claves de Groq (agregar, activar, eliminar)"
                           FontSize="13"
                           Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Info -->
            <InfoBar x:Name="InfoStatus"
                     Grid.Row="1"
                     IsOpen="False"
                     IsClosable="True"/>

            <!-- Formulario agregar -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Agregar nueva API key"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F7FAFC"/>

                    <TextBox Grid.Row="1"
                             x:Name="TxtName"
                             PlaceholderText="Nombre (opcional)"
                             Height="44"/>

                    <PasswordBox Grid.Row="2"
                                 x:Name="TxtApiKey"
                                 PlaceholderText="gsk_..."
                                 Height="44"/>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkMakeActive"
                                  Grid.Column="0"
                                  Content="Activar al guardar"
                                  IsChecked="True"
                                  VerticalAlignment="Center"/>

                        <Button x:Name="BtnAdd"
                                Grid.Column="1"
                                Content="Validar y guardar"
                                Click="BtnAdd_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Título lista -->
            <StackPanel Grid.Row="3" Spacing="6">
                <TextBlock Text="Claves registradas"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F7FAFC"/>
                <Border Height="2"
                        Background="{StaticResource AnfetaAccentBrush}"
                        CornerRadius="1"/>
            </StackPanel>

            <!-- Lista -->
            <ListView Grid.Row="4"
                      x:Name="LvKeys"
                      SelectionMode="None"
                      HorizontalContentAlignment="Stretch">

                <!-- Encabezado -->
                <ListView.Header>
                    <Border Style="{StaticResource CardStyle}" Padding="10,6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Nombre" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="API Key" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Proveedor" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Estado / Última validación" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Acciones" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="data:ApiKeyRow">
                        <Border Margin="0,0,0,8"
                                Padding="10"
                                Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="132"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nombre (editable) -->
                                <TextBox x:Name="NameBox"
                                         Grid.Column="0"
                                         Text="{x:Bind Name, Mode=TwoWay}"
                                         PlaceholderText="(sin nombre)"
                                         LostFocus="Name_LostFocus"
                                         Height="32"
                                         Padding="10,6"/>

                                <!-- API key -->
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Masked}"
                                           Foreground="#F7FAFC"
                                           VerticalAlignment="Center"/>

                                <!-- Proveedor -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Provider}"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>

                                <!-- Estado + fecha -->
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">

                                    <!-- CHIP ACTIVA -->
                                    <Border Padding="8,4"
                                            CornerRadius="999"
                                            Background="#14FFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            Visibility="{x:Bind ActiveVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Accept" Foreground="{StaticResource AnfetaAccentBrush}"/>
                                            <TextBlock Text="ACTIVA"
                                                       Foreground="{StaticResource AnfetaAccentBrush}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CHIP INACTIVA -->
                                    <Border Padding="8,4"
                                            CornerRadius="999"
                                            Background="#14FFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            Visibility="{x:Bind InactiveVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Remove" Foreground="#94A3B8"/>
                                            <TextBlock Text="INACTIVA"
                                                       Foreground="#94A3B8"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{x:Bind LastValidatedAt}"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="280"/>
                                </StackPanel>

                                <!-- Acciones -->
                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <!-- Activar (solo si NO está activa) -->
                                    <Button Tag="{x:Bind Id}"
                                            Click="BtnActivate_Click"
                                            IsEnabled="{x:Bind CanActivate}"
                                            Width="34" Height="32"
                                            ToolTipService.ToolTip="Marcar como activa"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                        <SymbolIcon Symbol="Pin" Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Button>

                                    <!-- Editar -->
                                    <Button Tag="{x:Bind Id}"
                                            Click="BtnEdit_Click"
                                            Width="34" Height="32"
                                            ToolTipService.ToolTip="Editar nombre"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                        <SymbolIcon Symbol="Edit" Foreground="#CBD5E1"/>
                                    </Button>

                                    <!-- Eliminar -->
                                    <Button Tag="{x:Bind Id}"
                                            Click="BtnDelete_Click"
                                            Width="34" Height="32"
                                            ToolTipService.ToolTip="Eliminar"
                                            Style="{StaticResource SecondaryButtonStyle}">
                                        <SymbolIcon Symbol="Delete" Foreground="{StaticResource AnfetaWarningBrush}"/>
                                    </Button>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </ScrollViewer>
</Page>
