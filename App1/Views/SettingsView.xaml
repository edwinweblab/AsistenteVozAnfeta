<Page
    x:Class="Anfeta.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--  Header con botones de ayuda  -->
            <Grid Grid.Row="0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Configuración"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#F7FAFC"/>
                    <TextBlock Text="Personaliza audio y atajos de teclado"
                               FontSize="13"
                               Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Botones arriba-derecha -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                    <!-- Ayuda de Windows -->
                    <Button x:Name="BtnOpenWindowsSettings"
                            Click="BtnOpenWindowsSettings_Click"
                            Width="40" Height="40"
                            Background="#14FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            CornerRadius="20"
                            ToolTipService.ToolTip="Abrir Configuración de Windows">
                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#CBD5E1"/>
                    </Button>

                    <!--  Problemas comunes  -->
                    <Button
                        x:Name="BtnShowTroubleshoot"
                        Width="40"
                        Height="40"
                        Background="#14FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Click="BtnShowTroubleshoot_Click"
                        CornerRadius="20"
                        ToolTipService.ToolTip="¿Problemas con el audio?">
                        <FontIcon
                            FontSize="16"
                            Foreground="{StaticResource AnfetaWarningBrush}"
                            Glyph="&#xE897;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ========== SECCIÓN DROPBOX (RUTA) ==========  -->
            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xEC50;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Dropbox" />
                </StackPanel>

                <Border
                    Height="2"
                    Background="{StaticResource AnfetaAccentBrush}"
                    CornerRadius="1" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Ruta de Dropbox" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="Selecciona la carpeta raíz que usará ANFETA para indexar y buscar."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            x:Name="DropboxPathBox"
                            Grid.Row="1"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            PlaceholderText="Aún no configurado..." />

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                x:Name="BtnPickDropboxRoot"
                                MinWidth="220"
                                Click="BtnPickDropboxRoot_Click"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBlock Text="Seleccionar carpeta..." />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="BtnResetDropboxRoot"
                                MinWidth="140"
                                Click="BtnResetDropboxRoot_Click"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    <TextBlock Text="Reiniciar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ========== SECCIÓN AUDIO ==========  -->
            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xE767;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Audio" />
                </StackPanel>

                <Border Height="2" Background="{StaticResource AnfetaAccentBrush}" CornerRadius="1"/>

                <!-- Estado actual -->
                <StackPanel Spacing="4" Margin="0,4,0,8">
                    <TextBlock x:Name="TxtCurrentInput"
                               Text="Entrada: No configurado"
                               FontSize="12"
                               Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtCurrentOutput"
                               Text="Salida: No configurado"
                               FontSize="12"
                               Foreground="#94A3B8"/>
                </StackPanel>

                <!--  Card Entrada  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontSize="20"
                                Foreground="{StaticResource AnfetaAccentBrush}"
                                Glyph="&#xE720;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Entrada (Micrófono)" />
                        </StackPanel>

                        <ComboBox Grid.Row="1"
                                  x:Name="CbInputDevice"
                                  PlaceholderText="Seleccionar micrófono"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CbInputDevice_SelectionChanged"
                                  Height="44"/>

                        <Button Grid.Row="2"
                                x:Name="BtnTestMic"
                                Click="BtnTestMic_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="180">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="IconTestMic"
                                    FontSize="16"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="TxtTestMic" Text="Probar Micrófono" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Row="3"
                                    x:Name="PnlMicLevel"
                                    Visibility="Collapsed"
                                    Spacing="8">
                            <Grid>
                                <ProgressBar
                                    x:Name="PgMicLevel"
                                    Height="28"
                                    CornerRadius="4"
                                    Foreground="{StaticResource AnfetaAccentBrush}"
                                    Maximum="100" />
                                <TextBlock
                                    x:Name="TxtMicLevel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="0%" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Card Salida  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontSize="20"
                                Foreground="{StaticResource AnfetaAccentBrush}"
                                Glyph="&#xE767;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Salida (Altavoces)" />
                        </StackPanel>

                        <ComboBox Grid.Row="1"
                                  x:Name="CbOutputDevice"
                                  PlaceholderText="Seleccionar altavoces"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CbOutputDevice_SelectionChanged"
                                  Height="44"/>

                        <Button Grid.Row="2"
                                x:Name="BtnTestSpeaker"
                                Click="BtnTestSpeaker_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="180">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="IconTestSpeaker"
                                    FontSize="16"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="TxtTestSpeaker" Text="Probar Sonido" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ========== SECCIÓN ATAJOS ==========  -->
            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xE92E;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Atajos de Teclado" />
                </StackPanel>

                <Border
                    Height="2"
                    Background="{StaticResource AnfetaAccentBrush}"
                    CornerRadius="1" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock Text="Activar micrófono" FontSize="14" Foreground="#CBD5E1"/>
                            <TextBlock Text="Presiona esta combinación en cualquier momento para iniciar escucha."
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#14FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtHotkeyDisplay"
                                       Text="Ctrl + Alt + V"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AnfetaAccentBrush}"/>
                        </Border>

                        <Button Grid.Row="2"
                                x:Name="BtnChangeHotkey"
                                Click="BtnChangeHotkey_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Width="48"
                                Height="48"
                                Padding="0"
                                ToolTipService.ToolTip="Cambiar atajo de teclado">
                            <FontIcon Glyph="&#xE70F;" FontSize="18"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========== SECCIÓN API KEYS ========== -->
            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="{StaticResource AnfetaAccentBrush}"/>
                    <TextBlock Text="API Keys" FontSize="18" FontWeight="SemiBold" Foreground="#F7FAFC"/>
                </StackPanel>

                <Border Height="2" Background="{StaticResource AnfetaAccentBrush}" CornerRadius="1"/>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Administra tus llaves (por ejemplo Groq) y selecciona cuál está activa."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"/>

                        <Button Grid.Row="1"
                                Content="Administrar API Keys"
                                Click="BtnApiKeys_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="220"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- InfoBar -->
            <StackPanel Grid.Row="4" Spacing="12">
                <InfoBar x:Name="InfoStatus" IsOpen="False" IsClosable="True"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
