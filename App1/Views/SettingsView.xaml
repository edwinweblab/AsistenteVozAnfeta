<Page
    x:Class="Anfeta.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Configuración" 
                           Style="{StaticResource HeaderTextStyle}"
                           Foreground="White"/>
                <TextBlock Text="Personaliza dispositivos de audio"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="#B0B0B0"/>
            </StackPanel>

            <!-- SECCIÓN: Audio -->
            <StackPanel Grid.Row="1" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{StaticResource AnfetaAccentBrush}"/>
                    <TextBlock Text="Audio" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="White"/>
                </StackPanel>
                <Border Height="2" 
                        Background="{StaticResource AnfetaAccentBrush}" 
                        CornerRadius="1"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Card Entrada -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE720;" FontSize="20" Foreground="{StaticResource AnfetaAccentBrush}"/>
                        <TextBlock Text="Entrada (Micrófono)" 
                                   Style="{StaticResource SubheaderTextStyle}"
                                   Foreground="White"/>
                    </StackPanel>

                    <ComboBox Grid.Row="1" 
                              x:Name="CbInputDevice"
                              PlaceholderText="Seleccionar micrófono"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CbInputDevice_SelectionChanged"
                              Height="44"/>

                    <Button Grid.Row="2" 
                            x:Name="BtnTestMic"
                            Click="BtnTestMic_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="180">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="IconTestMic" Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="TxtTestMic" Text="Probar Micrófono"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="3" 
                                x:Name="PnlMicLevel" 
                                Visibility="Collapsed"
                                Spacing="8">
                        <Grid>
                            <ProgressBar x:Name="PgMicLevel"
                                     Maximum="100"
                                     Height="28"
                                     CornerRadius="4"
                                     IsIndeterminate="False"
                                     ShowPaused="False"
                                     ShowError="False"
                                     Foreground="{StaticResource AnfetaAccentBrush}"/>
                            <TextBlock x:Name="TxtMicLevel"
                                       Text="0%"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Salida -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE767;" FontSize="20" Foreground="{StaticResource AnfetaAccentBrush}"/>
                        <TextBlock Text="Salida (Altavoces)" 
                                   Style="{StaticResource SubheaderTextStyle}"
                                   Foreground="White"/>
                    </StackPanel>

                    <ComboBox Grid.Row="1" 
                              x:Name="CbOutputDevice"
                              PlaceholderText="Seleccionar altavoces"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CbOutputDevice_SelectionChanged"
                              Height="44"/>

                    <Button Grid.Row="2" 
                            x:Name="BtnTestSpeaker"
                            Click="BtnTestSpeaker_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="180">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="IconTestSpeaker" Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="TxtTestSpeaker" Text="Probar Sonido"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- InfoBar + Link Windows -->
            <StackPanel Grid.Row="4" Spacing="12">
                <InfoBar x:Name="InfoStatus" IsOpen="False" IsClosable="True"/>

                <HyperlinkButton x:Name="BtnOpenWindowsSettings"
                                 Click="BtnOpenWindowsSettings_Click"
                                 HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource AnfetaAccentBrush}"/>
                        <TextBlock Text="Abrir Configuración de Windows" 
                                   Foreground="{StaticResource AnfetaAccentBrush}"/>
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>

            <!-- Separador para futuras secciones -->
            <Border Grid.Row="5" 
                    Height="1" 
                    Background="#2A2A2A" 
                    Margin="0,16,0,0"/>

        </Grid>
    </ScrollViewer>
</Page>