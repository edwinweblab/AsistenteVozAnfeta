<Page
    x:Class="Anfeta.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="28">

                <!--  HEADER  -->
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="Configuración" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#D4C9C0"
                            Text="Personaliza audio, atajos de teclado y conexiones" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="BtnOpenWindowsSettings"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Click="BtnOpenWindowsSettings_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Abrir Configuración de Windows">
                            <FontIcon
                                FontSize="14"
                                Foreground="#EDE8E3"
                                Glyph="&#xE713;" />
                        </Button>
                        <Button
                            x:Name="BtnShowTroubleshoot"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Click="BtnShowTroubleshoot_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Solucionar problemas de audio">
                            <FontIcon
                                FontSize="14"
                                Foreground="#FBBF24"
                                Glyph="&#xE897;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ═══ IDENTIDAD DE USUARIO ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="USUARIO ACTUAL" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="¿Quién está usando ANFETA?" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Se usa para mostrar únicamente los mensajes y recordatorios dirigidos a esta persona. Sin seleccionar mostrará todos."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="CurrentUserCombo"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Sin seleccionar · mostrar todos"
                                    SelectionChanged="CurrentUserCombo_SelectionChanged">
                                    <ComboBoxItem Content="Sin seleccionar · mostrar todos" Tag="" />
                                    <ComboBoxItem Content="John" Tag="jjohn" />
                                    <ComboBoxItem Content="Karla" Tag="kkarl" />
                                    <ComboBoxItem Content="Isaias" Tag="iisaia" />
                                    <ComboBoxItem Content="Sotelo" Tag="eedua" />
                                    <ComboBoxItem Content="Acalli" Tag="aacal" />
                                    <ComboBoxItem Content="Andrade" Tag="aandr" />
                                    <ComboBoxItem Content="Emmanuel" Tag="eemma" />
                                    <ComboBoxItem Content="Brian" Tag="bbria" />
                                    <ComboBoxItem Content="Genaro" Tag="ggena" />
                                    <ComboBoxItem Content="Neftali" Tag="nneft" />
                                </ComboBox>
                                <TextBlock
                                    x:Name="CurrentUserStatusText"
                                    FontSize="11"
                                    Foreground="#D4C9C0"
                                    Text="Se mostrarán todos los recordatorios."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN DROPBOX ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xEC50;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="DROPBOX" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Ruta de carpeta raíz" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="ANFETA indexará esta carpeta para búsquedas por voz."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                    x:Name="DropboxPathBox"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    IsReadOnly="True"
                                    PlaceholderText="Sin carpeta configurada..." />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="BtnPickDropboxRoot"
                                        Click="BtnPickDropboxRoot_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                            <TextBlock Text="Seleccionar carpeta" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BtnResetDropboxRoot"
                                        Click="BtnResetDropboxRoot_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Reiniciar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Conexión con Dropbox API  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="#3984FF"
                                CornerRadius="12,0,0,12"
                                Opacity="0.75" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Conexión con Dropbox API" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Vincula una cuenta para crear carpetas y subir archivos desde ANFETA."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Padding="12"
                                    Background="#181818"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="DropboxApiStatusText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFFF"
                                            Text="Dropbox no vinculado." />
                                        <TextBlock
                                            x:Name="DropboxApiAccountText"
                                            FontSize="11"
                                            Foreground="#B8B8B8"
                                            Text="Sin cuenta conectada."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel
                                    x:Name="DropboxAuthorizationPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Autoriza ANFETA en el navegador, copia el código que muestra Dropbox y pégalo aquí."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="DropboxAuthorizationCodeBox"
                                        Height="40"
                                        PlaceholderText="Código de autorización" />
                                    <Button
                                        x:Name="BtnCompleteDropboxAuthorization"
                                        HorizontalAlignment="Left"
                                        Click="BtnCompleteDropboxAuthorization_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                            <TextBlock Text="Completar conexión" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="BtnConnectDropbox"
                                        Click="BtnConnectDropbox_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                                            <TextBlock Text="Conectar Dropbox" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnTestDropboxConnection"
                                        Click="BtnTestDropboxConnection_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                            <TextBlock Text="Probar conexión" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnDisconnectDropbox"
                                        Click="BtnDisconnectDropbox_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE8BB;" />
                                            <TextBlock Text="Desvincular" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <!--  ═══ WHATSAPP WEB ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="#22C55E"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="#22C55E"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="WHATSAPP WEB" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="#22C55E"
                                CornerRadius="12,0,0,12"
                                Opacity="0.78" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                x:Name="WhatsAppStatusDot"
                                                Width="10"
                                                Height="10"
                                                VerticalAlignment="Center"
                                                Background="#64748B"
                                                CornerRadius="5" />
                                            <TextBlock
                                                x:Name="WhatsAppStatusText"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                Text="Sin comprobar" />
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="WhatsAppStatusDetailText"
                                            FontSize="11"
                                            Foreground="#D4C9C0"
                                            Text="Configura el Bridge y verifica la conexión."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ProgressRing
                                            x:Name="WhatsAppOperationRing"
                                            Width="18"
                                            Height="18"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="WhatsAppOperationText"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="#86EFAC"
                                            Text="Listo" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="#9CA3AF"
                                            Text="Sesión" />
                                        <TextBlock
                                            x:Name="WhatsAppSessionText"
                                            FontSize="11"
                                            Foreground="#E5E7EB"
                                            Text="anfeta-main" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="#9CA3AF"
                                            Text="Persistencia" />
                                        <TextBlock
                                            x:Name="WhatsAppPersistenceText"
                                            FontSize="11"
                                            Foreground="#E5E7EB"
                                            Text="Sin comprobar" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="#9CA3AF"
                                            Text="Última conexión" />
                                        <TextBlock
                                            x:Name="WhatsAppConnectedAtText"
                                            FontSize="11"
                                            Foreground="#E5E7EB"
                                            Text="—" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Padding="12"
                                    Background="#141E1A"
                                    BorderBrush="#284A37"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#BBF7D0"
                                            Text="Configuración del Bridge" />

                                        <!--
                                            Los labels van separados del control.
                                            No usamos Header + Height fijo porque WinUI incluye
                                            el Header dentro de esa altura y termina aplastando
                                            visualmente el área editable.
                                        -->
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#E5E7EB"
                                                Text="URL del servidor" />
                                            <TextBox
                                                x:Name="WhatsAppBridgeUrlBox"
                                                MinHeight="42"
                                                Padding="11,7"
                                                Background="#0B1411"
                                                BorderBrush="#3C6E50"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Foreground="#F3F4F6"
                                                PlaceholderText="https://anfeta-whatsapp-bridge.onrender.com" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="5">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#E5E7EB"
                                                    Text="API key" />
                                                <PasswordBox
                                                    x:Name="WhatsAppApiKeyBox"
                                                    MinHeight="42"
                                                    Padding="11,7"
                                                    Background="#0B1411"
                                                    BorderBrush="#3C6E50"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Foreground="#F3F4F6"
                                                    PasswordRevealMode="Peek"
                                                    PlaceholderText="Clave privada del Bridge" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="5">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#E5E7EB"
                                                    Text="Número interno inicial" />
                                                <TextBox
                                                    x:Name="WhatsAppSeedParticipantBox"
                                                    MinHeight="42"
                                                    Padding="11,7"
                                                    Background="#0B1411"
                                                    BorderBrush="#3C6E50"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Foreground="#F3F4F6"
                                                    PlaceholderText="Ej. 524831191441" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            Margin="0,-2,0,0"
                                            FontSize="10.5"
                                            Foreground="#9CA3AF"
                                            Text="El número interno solo se utiliza al crear un grupo. El cliente entra mediante el enlace de invitación."
                                            TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button
                                                x:Name="BtnSaveWhatsAppBridge"
                                                Click="BtnSaveWhatsAppBridge_Click"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                                    <TextBlock Text="Guardar" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                x:Name="BtnTestWhatsAppBridge"
                                                Click="BtnTestWhatsAppBridge_Click"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                                    <TextBlock Text="Verificar conexión" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="BtnConnectWhatsApp"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnConnectWhatsApp_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                            <TextBlock Text="Conectar" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnShowWhatsAppQr"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnShowWhatsAppQr_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xED14;" />
                                            <TextBlock Text="Mostrar QR" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnChangeWhatsAppAccount"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnChangeWhatsAppAccount_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                            <TextBlock Text="Cambiar cuenta" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border
                                    x:Name="WhatsAppQrPanel"
                                    Padding="16"
                                    Background="#101815"
                                    BorderBrush="#365C46"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="240"
                                            Height="240"
                                            Padding="8"
                                            Background="White"
                                            CornerRadius="8">
                                            <Grid>
                                                <Image
                                                    x:Name="WhatsAppQrImage"
                                                    Stretch="Uniform" />
                                                <ProgressRing
                                                    x:Name="WhatsAppQrLoadingRing"
                                                    Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="False"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                Text="Vincular WhatsApp" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#D4C9C0"
                                                Text="En el teléfono abre WhatsApp → Dispositivos vinculados → Vincular dispositivo y escanea este código. ANFETA detectará la conexión automáticamente."
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="WhatsAppQrWaitText"
                                                FontSize="11"
                                                Foreground="#86EFAC"
                                                Text="Esperando escaneo…" />
                                            <Button
                                                x:Name="BtnCloseWhatsAppQr"
                                                HorizontalAlignment="Left"
                                                Click="BtnCloseWhatsAppQr_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Ocultar QR" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN NOTION ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="NOTION" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Base de datos de Notion" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="ANFETA leerá páginas de Notion y las agregará al buscador."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Token de integración" />
                                    <PasswordBox
                                        x:Name="NotionTokenBox"
                                        Height="40"
                                        PlaceholderText="ntn_..." />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Bases incluidas" />

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">

                                        <GridView
                                            x:Name="NotionSourcesList"
                                            MaxHeight="220"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,10,10" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="330"
                                                        Padding="10"
                                                        Background="#252525"
                                                        BorderBrush="#333333"
                                                        BorderThickness="1"
                                                        CornerRadius="8">

                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Top"
                                                                Background="#2E7D32"
                                                                CornerRadius="11">
                                                                <FontIcon
                                                                    FontSize="12"
                                                                    Foreground="White"
                                                                    Glyph="&#xE73E;" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Spacing="2">

                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="#AFAFAF"
                                                                    Text="{Binding DataSourceId}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    x:Name="NotionStatusText"
                                    FontSize="11"
                                    Foreground="#D4C9C0"
                                    Text="Notion no configurado."
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="BtnSaveNotion"
                                        Click="BtnSaveNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                            <TextBlock Text="Guardar" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnTestNotion"
                                        Click="BtnTestNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                                            <TextBlock Text="Probar conexión" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnSyncNotion"
                                        Click="BtnSyncNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE895;" />
                                            <TextBlock Text="Sincronizar Notion" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnResetNotion"
                                        Click="BtnResetNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Limpiar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <!--  ═══ SECCIÓN AUDIO ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE767;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="AUDIO" />
                    </StackPanel>

                    <!--  Indicador de dispositivos activos del sistema  -->
                    <Border
                        Padding="14,10"
                        Background="#0A0C0E"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="#34D399" />
                                <!--  Renombrado: TxtCurrentInput → TxtStatusInput  -->
                                <TextBlock
                                    x:Name="TxtStatusInput"
                                    FontSize="11"
                                    Foreground="#EDE8E3"
                                    Text="Cargando..." />
                            </StackPanel>
                            <Border
                                Width="1"
                                Height="12"
                                VerticalAlignment="Center"
                                Background="#20FFFFFF" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="#34D399" />
                                <!--  Renombrado: TxtCurrentOutput → TxtStatusOutput  -->
                                <TextBlock
                                    x:Name="TxtStatusOutput"
                                    FontSize="11"
                                    Foreground="#EDE8E3"
                                    Text="Cargando..." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Card Micrófono  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource AnfetaAccentBrush}"
                                        Glyph="&#xE720;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Entrada (Micrófono)" />
                                </StackPanel>

                                <!--  Dispositivo activo del sistema — solo lectura  -->
                                <Border
                                    Padding="14,10"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF8A4A"
                                            Glyph="&#xE720;" />
                                        <TextBlock
                                            x:Name="TxtMicDevice"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#D4C9C0"
                                            Text="Cargando..."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#6B5F56"
                                    Text="ANFETA usa el micrófono predeterminado de Windows. Para cambiarlo, configúralo en Sonido del sistema."
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="BtnTestMic"
                                    Click="BtnTestMic_Click"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="IconTestMic"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="TxtTestMic" Text="Probar micrófono" />
                                    </StackPanel>
                                </Button>

                                <StackPanel
                                    x:Name="PnlMicLevel"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <ProgressBar
                                            x:Name="PgMicLevel"
                                            Height="24"
                                            CornerRadius="4"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Maximum="100" />
                                        <TextBlock
                                            x:Name="TxtMicLevel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="0%" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Card Altavoces  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource AnfetaAccentBrush}"
                                        Glyph="&#xE767;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Salida (Altavoces)" />
                                </StackPanel>

                                <!--  Dispositivo activo del sistema — solo lectura  -->
                                <Border
                                    Padding="14,10"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FB923C"
                                            Glyph="&#xE767;" />
                                        <TextBlock
                                            x:Name="TxtSpeakerDevice"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#D4C9C0"
                                            Text="Cargando..."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#6B5F56"
                                    Text="ANFETA usa los altavoces predeterminados de Windows. Para cambiarlos, configúralos en Sonido del sistema."
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="BtnTestSpeaker"
                                    Click="BtnTestSpeaker_Click"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="IconTestSpeaker"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="TxtTestSpeaker" Text="Probar sonido" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN ATAJOS ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />

                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE92E;" />

                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="ATAJOS DE TECLADO" />
                    </StackPanel>

                    <!--  CARD: Activar micrófono  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Activar micrófono" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Presiona esta combinación desde cualquier app para iniciar la escucha."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">

                                    <Border
                                        Padding="14,10"
                                        Background="#060A10"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <TextBlock
                                            x:Name="TxtHotkeyDisplay"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Text="Ctrl + Alt + V" />
                                    </Border>

                                    <Button
                                        x:Name="BtnChangeHotkey"
                                        Width="40"
                                        Height="40"
                                        Click="BtnChangeHotkey_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Cambiar atajo de micrófono">

                                        <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  CARD: Abrir buscador  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Abrir buscador" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Presiona esta combinación desde cualquier app para abrir el módulo Buscador y empezar a escribir."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">

                                    <Border
                                        Padding="14,10"
                                        Background="#060A10"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <TextBlock
                                            x:Name="TxtSearchHotkeyDisplay"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Text="Ctrl + Alt + B" />
                                    </Border>

                                    <Button
                                        x:Name="BtnChangeSearchHotkey"
                                        Width="40"
                                        Height="40"
                                        Click="BtnChangeSearchHotkey_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Cambiar atajo del buscador">

                                        <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN API KEYS ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE8D7;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="API KEYS" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Claves de integración" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Administra tus llaves (Groq y otras) y selecciona cuál está activa."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Click="BtnApiKeys_Click" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                        <TextBlock Text="Administrar API Keys" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  INFOBAR FIJA ABAJO  -->
        <Border Grid.Row="1" Padding="24,0,24,12">
            <InfoBar
                x:Name="InfoStatus"
                Margin="0,8,0,0"
                IsClosable="True"
                IsOpen="False" />
        </Border>

    </Grid>
</Page>