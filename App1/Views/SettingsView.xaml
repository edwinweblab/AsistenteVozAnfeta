<Page
    x:Class="Anfeta.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="Auto" />
                <!--  Dropbox  -->
                <RowDefinition Height="Auto" />
                <!--  Audio  -->
                <RowDefinition Height="Auto" />
                <!--  Atajos  -->
                <RowDefinition Height="Auto" />
                <!--  InfoBar  -->
            </Grid.RowDefinitions>

            <!--  Header con botones de ayuda  -->
            <Grid Grid.Row="0">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Configuración" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#94A3B8"
                        Text="Personaliza audio y atajos de teclado" />
                </StackPanel>

                <!--  Botones arriba-derecha  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">

                    <!--  Ayuda de Windows  -->
                    <Button
                        x:Name="BtnOpenWindowsSettings"
                        Width="40"
                        Height="40"
                        Background="#14FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Click="BtnOpenWindowsSettings_Click"
                        CornerRadius="20"
                        ToolTipService.ToolTip="Abrir Configuración de Windows">
                        <FontIcon
                            FontSize="16"
                            Foreground="#CBD5E1"
                            Glyph="&#xE713;" />
                    </Button>

                    <!--  Problemas comunes  -->
                    <Button
                        x:Name="BtnShowTroubleshoot"
                        Width="40"
                        Height="40"
                        Background="#14FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        Click="BtnShowTroubleshoot_Click"
                        CornerRadius="20"
                        ToolTipService.ToolTip="¿Problemas con el audio?">
                        <FontIcon
                            FontSize="16"
                            Foreground="{StaticResource AnfetaWarningBrush}"
                            Glyph="&#xE897;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ========== SECCIÓN DROPBOX (RUTA) ==========  -->
            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xEC50;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Dropbox" />
                </StackPanel>

                <Border
                    Height="2"
                    Background="{StaticResource AnfetaAccentBrush}"
                    CornerRadius="1" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Ruta de Dropbox" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="Selecciona la carpeta raíz que usará ANFETA para indexar y buscar."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            x:Name="DropboxPathBox"
                            Grid.Row="1"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            PlaceholderText="Aún no configurado..." />

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                x:Name="BtnPickDropboxRoot"
                                MinWidth="220"
                                Click="BtnPickDropboxRoot_Click"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBlock Text="Seleccionar carpeta..." />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="BtnResetDropboxRoot"
                                MinWidth="140"
                                Click="BtnResetDropboxRoot_Click"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    <TextBlock Text="Reiniciar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ========== SECCIÓN AUDIO ==========  -->
            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xE767;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Audio" />
                </StackPanel>

                <Border
                    Height="2"
                    Background="{StaticResource AnfetaAccentBrush}"
                    CornerRadius="1" />

                <!--  Estado actual  -->
                <StackPanel Margin="0,4,0,8" Spacing="4">
                    <TextBlock
                        x:Name="TxtCurrentInput"
                        FontSize="12"
                        Foreground="#94A3B8"
                        Text="Entrada: No configurado" />
                    <TextBlock
                        x:Name="TxtCurrentOutput"
                        FontSize="12"
                        Foreground="#94A3B8"
                        Text="Salida: No configurado" />
                </StackPanel>

                <!--  Card Entrada  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontSize="20"
                                Foreground="{StaticResource AnfetaAccentBrush}"
                                Glyph="&#xE720;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Entrada (Micrófono)" />
                        </StackPanel>

                        <ComboBox
                            x:Name="CbInputDevice"
                            Grid.Row="1"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Seleccionar micrófono"
                            SelectionChanged="CbInputDevice_SelectionChanged" />

                        <Button
                            x:Name="BtnTestMic"
                            Grid.Row="2"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Click="BtnTestMic_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="IconTestMic"
                                    FontSize="16"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="TxtTestMic" Text="Probar Micrófono" />
                            </StackPanel>
                        </Button>

                        <StackPanel
                            x:Name="PnlMicLevel"
                            Grid.Row="3"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Grid>
                                <ProgressBar
                                    x:Name="PgMicLevel"
                                    Height="28"
                                    CornerRadius="4"
                                    Foreground="{StaticResource AnfetaAccentBrush}"
                                    Maximum="100" />
                                <TextBlock
                                    x:Name="TxtMicLevel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="0%" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Card Salida  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontSize="20"
                                Foreground="{StaticResource AnfetaAccentBrush}"
                                Glyph="&#xE767;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F7FAFC"
                                Text="Salida (Altavoces)" />
                        </StackPanel>

                        <ComboBox
                            x:Name="CbOutputDevice"
                            Grid.Row="1"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Seleccionar altavoces"
                            SelectionChanged="CbOutputDevice_SelectionChanged" />

                        <Button
                            x:Name="BtnTestSpeaker"
                            Grid.Row="2"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Click="BtnTestSpeaker_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="IconTestSpeaker"
                                    FontSize="16"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="TxtTestSpeaker" Text="Probar Sonido" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ========== SECCIÓN ATAJOS ==========  -->
            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource AnfetaAccentBrush}"
                        Glyph="&#xE92E;" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F7FAFC"
                        Text="Atajos de Teclado" />
                </StackPanel>

                <Border
                    Height="2"
                    Background="{StaticResource AnfetaAccentBrush}"
                    CornerRadius="1" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock
                                FontSize="14"
                                Foreground="#CBD5E1"
                                Text="Activar micrófono" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="Presiona esta combinación en cualquier momento para iniciar escucha."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="16,12"
                            HorizontalAlignment="Left"
                            Background="#14FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                x:Name="TxtHotkeyDisplay"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AnfetaAccentBrush}"
                                Text="Ctrl + Alt + V" />
                        </Border>

                        <Button
                            x:Name="BtnChangeHotkey"
                            Grid.Row="2"
                            Height="48"
                            MinWidth="48"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Click="BtnChangeHotkey_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Cambiar atajo de teclado">
                            <FontIcon FontSize="18" Glyph="&#xE70F;" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  InfoBar  -->
            <StackPanel Grid.Row="4" Spacing="12">
                <InfoBar
                    x:Name="InfoStatus"
                    IsClosable="True"
                    IsOpen="False" />
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
