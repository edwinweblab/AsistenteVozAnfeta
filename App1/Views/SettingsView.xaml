<Page
    x:Class="Anfeta.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgGradient}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="28">

                <!--  HEADER  -->
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="Configuración" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#D4C9C0"
                            Text="Personaliza audio, atajos de teclado y conexiones" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="BtnOpenWindowsSettings"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Click="BtnOpenWindowsSettings_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Abrir Configuración de Windows">
                            <FontIcon
                                FontSize="14"
                                Foreground="#EDE8E3"
                                Glyph="&#xE713;" />
                        </Button>
                        <Button
                            x:Name="BtnShowTroubleshoot"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Click="BtnShowTroubleshoot_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="Solucionar problemas de audio">
                            <FontIcon
                                FontSize="14"
                                Foreground="#FBBF24"
                                Glyph="&#xE897;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ═══ SECCIÓN DROPBOX ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xEC50;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="DROPBOX" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Ruta de carpeta raíz" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="ANFETA indexará esta carpeta para búsquedas por voz."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                    x:Name="DropboxPathBox"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    IsReadOnly="True"
                                    PlaceholderText="Sin carpeta configurada..." />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="BtnPickDropboxRoot"
                                        Click="BtnPickDropboxRoot_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                            <TextBlock Text="Seleccionar carpeta" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BtnResetDropboxRoot"
                                        Click="BtnResetDropboxRoot_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Reiniciar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <!--  ═══ SECCIÓN NOTION ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="NOTION" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.6" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Base de datos de Notion" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="ANFETA leerá páginas de Notion y las agregará al buscador."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Token de integración" />
                                    <PasswordBox
                                        x:Name="NotionTokenBox"
                                        Height="40"
                                        PlaceholderText="ntn_..." />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Bases incluidas" />

                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">

                                        <GridView
                                            x:Name="NotionSourcesList"
                                            MaxHeight="220"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,10,10" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="330"
                                                        Padding="10"
                                                        Background="#252525"
                                                        BorderBrush="#333333"
                                                        BorderThickness="1"
                                                        CornerRadius="8">

                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Grid.Column="0"
                                                                Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Top"
                                                                Background="#2E7D32"
                                                                CornerRadius="11">
                                                                <FontIcon
                                                                    FontSize="12"
                                                                    Foreground="White"
                                                                    Glyph="&#xE73E;" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Spacing="2">

                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="#AFAFAF"
                                                                    Text="{Binding DataSourceId}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    x:Name="NotionStatusText"
                                    FontSize="11"
                                    Foreground="#D4C9C0"
                                    Text="Notion no configurado."
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="BtnSaveNotion"
                                        Click="BtnSaveNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                            <TextBlock Text="Guardar" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnTestNotion"
                                        Click="BtnTestNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                                            <TextBlock Text="Probar conexión" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnSyncNotion"
                                        Click="BtnSyncNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE895;" />
                                            <TextBlock Text="Sincronizar Notion" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="BtnResetNotion"
                                        Click="BtnResetNotion_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <TextBlock Text="Limpiar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <!--  ═══ SECCIÓN AUDIO ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE767;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="AUDIO" />
                    </StackPanel>

                    <!--  Indicador de dispositivos activos del sistema  -->
                    <Border
                        Padding="14,10"
                        Background="#0A0C0E"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="#34D399" />
                                <!--  Renombrado: TxtCurrentInput → TxtStatusInput  -->
                                <TextBlock
                                    x:Name="TxtStatusInput"
                                    FontSize="11"
                                    Foreground="#EDE8E3"
                                    Text="Cargando..." />
                            </StackPanel>
                            <Border
                                Width="1"
                                Height="12"
                                VerticalAlignment="Center"
                                Background="#20FFFFFF" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="#34D399" />
                                <!--  Renombrado: TxtCurrentOutput → TxtStatusOutput  -->
                                <TextBlock
                                    x:Name="TxtStatusOutput"
                                    FontSize="11"
                                    Foreground="#EDE8E3"
                                    Text="Cargando..." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Card Micrófono  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource AnfetaAccentBrush}"
                                        Glyph="&#xE720;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Entrada (Micrófono)" />
                                </StackPanel>

                                <!--  Dispositivo activo del sistema — solo lectura  -->
                                <Border
                                    Padding="14,10"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FF8A4A"
                                            Glyph="&#xE720;" />
                                        <TextBlock
                                            x:Name="TxtMicDevice"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#D4C9C0"
                                            Text="Cargando..."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#6B5F56"
                                    Text="ANFETA usa el micrófono predeterminado de Windows. Para cambiarlo, configúralo en Sonido del sistema."
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="BtnTestMic"
                                    Click="BtnTestMic_Click"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="IconTestMic"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="TxtTestMic" Text="Probar micrófono" />
                                    </StackPanel>
                                </Button>

                                <StackPanel
                                    x:Name="PnlMicLevel"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <ProgressBar
                                            x:Name="PgMicLevel"
                                            Height="24"
                                            CornerRadius="4"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Maximum="100" />
                                        <TextBlock
                                            x:Name="TxtMicLevel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="0%" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Card Altavoces  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource AnfetaAccentBrush}"
                                        Glyph="&#xE767;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Salida (Altavoces)" />
                                </StackPanel>

                                <!--  Dispositivo activo del sistema — solo lectura  -->
                                <Border
                                    Padding="14,10"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#FB923C"
                                            Glyph="&#xE767;" />
                                        <TextBlock
                                            x:Name="TxtSpeakerDevice"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#D4C9C0"
                                            Text="Cargando..."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#6B5F56"
                                    Text="ANFETA usa los altavoces predeterminados de Windows. Para cambiarlos, configúralos en Sonido del sistema."
                                    TextWrapping="Wrap" />

                                <Button
                                    x:Name="BtnTestSpeaker"
                                    Click="BtnTestSpeaker_Click"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="IconTestSpeaker"
                                            FontSize="14"
                                            Glyph="&#xE768;" />
                                        <TextBlock x:Name="TxtTestSpeaker" Text="Probar sonido" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN ATAJOS ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />

                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE92E;" />

                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="ATAJOS DE TECLADO" />
                    </StackPanel>

                    <!--  CARD: Activar micrófono  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Activar micrófono" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Presiona esta combinación desde cualquier app para iniciar la escucha."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">

                                    <Border
                                        Padding="14,10"
                                        Background="#060A10"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <TextBlock
                                            x:Name="TxtHotkeyDisplay"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Text="Ctrl + Alt + V" />
                                    </Border>

                                    <Button
                                        x:Name="BtnChangeHotkey"
                                        Width="40"
                                        Height="40"
                                        Click="BtnChangeHotkey_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Cambiar atajo de micrófono">

                                        <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  CARD: Abrir buscador  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />

                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">

                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Abrir buscador" />

                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Presiona esta combinación desde cualquier app para abrir el módulo Buscador y empezar a escribir."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">

                                    <Border
                                        Padding="14,10"
                                        Background="#060A10"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8">

                                        <TextBlock
                                            x:Name="TxtSearchHotkeyDisplay"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AnfetaAccentBrush}"
                                            Text="Ctrl + Alt + B" />
                                    </Border>

                                    <Button
                                        x:Name="BtnChangeSearchHotkey"
                                        Width="40"
                                        Height="40"
                                        Click="BtnChangeSearchHotkey_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTipService.ToolTip="Cambiar atajo del buscador">

                                        <FontIcon FontSize="15" Glyph="&#xE70F;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ═══ SECCIÓN API KEYS ═══  -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            Background="{StaticResource AnfetaAccentBrush}"
                            CornerRadius="2" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource AnfetaAccentBrush}"
                            Glyph="&#xE8D7;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Text="API KEYS" />
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{StaticResource AnfetaAccentBrush}"
                                CornerRadius="12,0,0,12"
                                Opacity="0.5" />
                            <StackPanel
                                Grid.Column="1"
                                Padding="18,16"
                                Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF"
                                        Text="Claves de integración" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D4C9C0"
                                        Text="Administra tus llaves (Groq y otras) y selecciona cuál está activa."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Click="BtnApiKeys_Click" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                        <TextBlock Text="Administrar API Keys" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  INFOBAR FIJA ABAJO  -->
        <Border Grid.Row="1" Padding="24,0,24,12">
            <InfoBar
                x:Name="InfoStatus"
                Margin="0,8,0,0"
                IsClosable="True"
                IsOpen="False" />
        </Border>

    </Grid>
</Page>