                            Text="Día seleccionado"
                            TextTrimming="CharacterEllipsis" />

                        <Button
                            Grid.Column="6"
                            Height="30"
                            Padding="12,0"
                            Click="RemindersCalendarNew_Click"
                            Content="+ Nuevo recordatorio"
                            CornerRadius="6"
                            Background="#5B2A86"
                            BorderBrush="#A855F7" />

                        <Button
                            Grid.Column="7"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Click="RemindersCalendarRefresh_Click"
                            Content="↻"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Actualizar desde el índice local" />

                        <Button
                            Grid.Column="8"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Click="RemindersCalendarClose_Click"
                            Content="✕"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Cerrar calendario de recordatorios" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="12,7"
                    Background="#151A22"
                    BorderBrush="#2F3845"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock
                            x:Name="RemindersCalendarSummaryText"
                            FontSize="11"
                            Opacity="0.76"
                            Text="Recordatorios del día"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer
                        x:Name="RemindersCalendarScrollViewer"
                        HorizontalScrollBarVisibility="Visible"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <Canvas
                            x:Name="RemindersCalendarCanvas"
                            MinWidth="0"
                            MinHeight="1260"
                            Background="#0F141A"
                            DoubleTapped="RemindersCalendarCanvas_DoubleTapped" />
                    </ScrollViewer>

                    <Border
                        x:Name="RemindersCalendarEmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="22,16"
                        Background="#E61B1F23"
                        BorderBrush="#6B4C86"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Text="🔔" />
                            <TextBlock
                                x:Name="RemindersCalendarEmptyText"
                                MaxWidth="520"
                                Text="No hay recordatorios para este día."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                MaxWidth="520"
                                FontSize="10.5"
                                Opacity="0.65"
                                Text="Doble clic sobre una hora para crear uno con destinatario, fecha y hora precargados."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!--  Vista calendario; se construye desde SearchView.Calendar.cs  -->
            <Grid
        x:Name="CalendarHost"
        Grid.Column="0"
        Grid.ColumnSpan="5"
        Canvas.ZIndex="500"
        Background="#111820"
        Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="12,9"
                    Background="#191F28"
                    BorderBrush="#34404D"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarYesterday_Click"
                            Content="Ayer"
                            CornerRadius="6" />

                        <Button
                            Grid.Column="1"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarToday_Click"
                            Content="Hoy"
                            CornerRadius="6" />

                        <Button
                            Grid.Column="2"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarTomorrow_Click"
                            Content="Mañana"
                            CornerRadius="6" />

                        <Button
                            Grid.Column="3"
                            Width="32"
                            Height="30"
                            Padding="0"
                            Click="CalendarPreviousDay_Click"
                            Content="‹"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Día anterior" />

                        <Button
                            x:Name="CalendarPeopleButton"
                            Grid.Column="4"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarPeopleButton_Click"
                            Content="Personas"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Elegir las personas visibles" />

                        <TextBlock
                            x:Name="CalendarDateTitle"
                            Grid.Column="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Calendario" />

                        <TextBlock
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.68"
                            Text="Vista general" />

                        <Button
                            Grid.Column="7"
                            Width="32"
                            Height="30"
                            Padding="0"
                            Click="CalendarNextDay_Click"
                            Content="›"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Día siguiente" />

                        <Button
                            x:Name="CalendarZoomOutButton"
                            Grid.Column="8"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="CalendarZoomOut_Click"
                            Content="−"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Reducir zoom" />

                        <TextBlock
                            x:Name="CalendarZoomText"
                            Grid.Column="9"
                            MinWidth="46"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="100%"
                            TextAlignment="Center" />

                        <Button
                            x:Name="CalendarZoomInButton"
                            Grid.Column="10"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="CalendarZoomIn_Click"
                            Content="+"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Aumentar zoom" />

                        <Button
                            Grid.Column="11"
                            Height="30"
                            Padding="9,0"
                            Click="CalendarRunDailyAutomation_Click"
                            Content="Procesar ayer"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Mover pendientes de ayer a hoy y guardar reporte" />

                        <Button
                            Grid.Column="12"
                            Height="30"
                            Padding="9,0"
                            Click="CalendarDailyReport_Click"
                            Content="Reporte"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Abrir el último reporte diario" />

                        <ToggleButton
                            x:Name="CalendarCobrosToggle"
                            Grid.Column="13"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarCobrosToggle_Click"
                            Content="💰 Cobros"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Mostrar u ocultar eventos de BD COBRAR Y PAGAR" />

                        <Button
                            Grid.Column="14"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarRefresh_Click"
                            Content="Actualizar"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Actualización rápida incremental · Ctrl + clic para recarga completa" />

                        <Button
                            Grid.Column="15"
                            Height="30"
                            Padding="10,0"
                            Click="CalendarClose_Click"
                            Content="Resultados"
                            CornerRadius="6" />
                    </Grid>
                </Border>

                <!--
                    Progreso no bloqueante del calendario. La caché permanece
                    visible mientras ANFETA consulta y aplica cambios de Notion.
                -->
                <Border
                    x:Name="CalendarProcessPanel"
                    Grid.Row="1"
                    Padding="12,7"
                    Background="#151B22"
                    BorderBrush="#34404D"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing
                                x:Name="CalendarProcessRing"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                IsActive="True" />

                            <TextBlock
                                x:Name="CalendarProcessStageText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="Preparando calendario..." />

                            <TextBlock
                                x:Name="CalendarProcessDetailText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Opacity="0.72"
                                Text=""
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                x:Name="CalendarProcessElapsedText"
                                Grid.Column="3"
                                MinWidth="72"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Opacity="0.65"
                                Text="00:00" />
                        </Grid>

                        <ProgressBar
                            x:Name="CalendarProcessBar"
                            Grid.Row="1"
                            Height="4"
                            Minimum="0"
                            Maximum="100"
                            IsIndeterminate="True"
                            Value="0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ScrollViewer
                            x:Name="CalendarScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled"
                            PointerWheelChanged="CalendarScrollViewer_PointerWheelChanged"
                            ViewChanged="CalendarScrollViewer_ViewChanged">
                            <Canvas
                                x:Name="CalendarCanvas"
                                MinWidth="900"
                                MinHeight="820"
                                Background="#10161E" />
                        </ScrollViewer>

                        <Border
                            x:Name="CalendarEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="22,16"
                            Background="#E61B1F23"
                            BorderBrush="#465566"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="CalendarEmptyText"
                                MaxWidth="520"
                                Text="No hay actividades para este día."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!--
                        Panel solicitado para revisar rápidamente todas las
                        actividades de una persona. Los resúmenes usan la carga
                        existente del calendario; el contenido de Notion solo se
                        consulta cuando se pulsa "Ver contenido" en una tarjeta.
                    -->
                    <Border
                        x:Name="CalendarPersonPreviewPanel"
                        Grid.Column="1"
                        Width="420"
                        Padding="14"
                        Background="#171B21"
                        BorderBrush="#34404D"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="CalendarPersonPreviewTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Actividades" />
                                    <TextBlock
                                        x:Name="CalendarPersonPreviewDate"
                                        FontSize="11"
                                        Opacity="0.66"
                                        Text="Día seleccionado" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Width="32"
                                    Height="30"
                                    Padding="0"
                                    Click="CalendarPersonPreviewClose_Click"
                                    Content="✕"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="Cerrar vista previa por persona" />
                            </Grid>

                            <TextBlock
                                x:Name="CalendarPersonPreviewSummary"
                                Grid.Row="1"
                                FontSize="11"
                                Opacity="0.72"
                                Text="Selecciona el ojo de una persona para ver sus actividades."
                                TextWrapping="Wrap" />

                            <ScrollViewer
                                Grid.Row="2"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled">
                                <StackPanel
                                    x:Name="CalendarPersonPreviewItems"
                                    Padding="0,0,6,8"
                                    Spacing="10" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!--  Divisor izquierdo  -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Separador ajustable entre resultados y vista previa  -->
            <Thumb
                x:Name="DetailsPaneSplitter"
                Grid.Column="3"
                Width="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#1FFFFFFF"
                Canvas.ZIndex="50"
                DragDelta="DetailsPaneSplitter_DragDelta"
                DragCompleted="DetailsPaneSplitter_DragCompleted"
                PointerEntered="DetailsPaneSplitter_PointerEntered"
                PointerExited="DetailsPaneSplitter_PointerExited"
                ToolTipService.ToolTip="Mantén presionado y arrastra para cambiar el ancho de la vista previa">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid
                            x:Name="SplitterRoot"
                            Background="{TemplateBinding Background}">
                            <Border
                                Width="2"
                                HorizontalAlignment="Center"
                                Background="#5AFFFFFF"
                                CornerRadius="1" />
                            <Border
                                Width="8"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#66000000"
                                CornerRadius="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="⋮" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>


            <!--  ── LEFT PANEL ───────────────────────────────────  -->
            <Border
                x:Name="FoldersPane"
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  FILTROS GUARDADOS  -->
                        <Grid x:Name="SavedFiltersExpander">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <Grid
                                Grid.Row="0"
                                Height="30"
                                Padding="10,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="FILTROS GUARDADOS" />
                                <Button
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NewSavedFilter_Click"
                                    ToolTipService.ToolTip="Nuevo filtro guardado">
                                    <Viewbox
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform">
                                        <SymbolIcon Symbol="Add" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!--  Lista — MaxHeight limita a ~7 items, el resto con scroll  -->
                            <ListView
                                x:Name="SavedFiltersList"
                                Grid.Row="1"
                                MaxHeight="200"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="SavedFiltersList_ItemClick"
                                ItemsSource="{x:Bind _savedFilters, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="MinHeight" Value="22" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="searchModels:SavedSearchFilter">
                                        <Grid
                                            MinHeight="28"
                                            HorizontalAlignment="Stretch"
                                            RightTapped="SavedFilter_RightTapped">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!--  Hint vacío  -->
                            <TextBlock
                                x:Name="SavedFiltersEmptyHint"
                                Grid.Row="2"
                                Margin="10,6,0,8"
                                FontSize="11"
                                Opacity="0.5"
                                Text="Aún no hay filtros guardados"
                                Visibility="Collapsed" />
                        </Grid>

                        <!--  MÁS OPCIONES  -->
                        <muxc:Expander
                            x:Name="MoreOptionsExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <muxc:Expander.Header>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="MÁS OPCIONES" />
                            </muxc:Expander.Header>

                            <StackPanel>

                                <!--  CARPETAS  -->
                                <muxc:Expander
                                    x:Name="FoldersTreeExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Height="30"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                        </Grid>
                                        <TreeView
                                            x:Name="FolderTree"
                                            Expanding="FolderTree_Expanding"
                                            ItemInvoked="FolderTree_ItemInvoked">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                        <StackPanel
                                            x:Name="EmptyTreeHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Opacity="0.55"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Sin árbol cargado" />
                                            <TextBlock
                                                MaxWidth="180"
                                                FontSize="11"
                                                Text="Pulsa &quot;Actualizar&quot; para cargar carpetas"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  COMANDOS GUARDADOS  -->
                                <muxc:Expander
                                    x:Name="CommandsExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Comandos" />
                                            <Button
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="BtnQuickSaveCommand_Click"
                                                ToolTipService.ToolTip="Guardar búsqueda actual como comando">
                                                <Viewbox
                                                    Width="12"
                                                    Height="12"
                                                    Stretch="Uniform">
                                                    <SymbolIcon Symbol="Add" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </muxc:Expander.Header>
                                    <StackPanel>
                                        <ListView
                                            x:Name="CommandsSidebarList"
                                            MaxHeight="180"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            IsItemClickEnabled="True"
                                            ItemClick="CommandsSidebarList_ItemClick"
                                            SelectionChanged="CommandsSidebarList_SelectionChanged"
                                            SelectionMode="Single">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Setter Property="MinHeight" Value="32" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="32" RightTapped="CommandRow_RightTapped">
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                MaxLines="1"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                MaxLines="1"
                                                                Opacity="0.55"
                                                                Text="{Binding Query}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="CommandsSidebarEmptyHint"
                                            Margin="10,4,0,6"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="Aún no hay comandos" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  CARPETAS EXCLUIDAS  -->
                                <muxc:Expander
                                    x:Name="ExcludedExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas excluidas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnAddExcludedFolder_Click"
                                                Content="Excluir carpeta..."
                                                CornerRadius="6"
                                                FontSize="13" />
                                        </Grid>
                                        <ListView
                                            x:Name="ExcludedFoldersList"
                                            MaxHeight="100"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="28" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Opacity="0.8"
                                                            Text="{Binding}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="BtnRemoveExcludedFolder_Click"
                                                            Tag="{Binding}"
                                                            ToolTipService.ToolTip="Quitar exclusión">
                                                            <Viewbox
                                                                Width="10"
                                                                Height="10"
                                                                Stretch="Uniform">
                                                                <SymbolIcon Symbol="Cancel" />
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="ExcludedHint"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="No hay carpetas excluidas" />
                                    </StackPanel>
                                </muxc:Expander>

                            </StackPanel>
                        </muxc:Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── CENTER PANEL ──────────────────────────────────  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <!--  Cabecera: breadcrumb + voz  -->
                    <RowDefinition Height="28" />
                    <!--  Encabezado de columnas estilo Everything  -->
                    <RowDefinition Height="*" />
                    <!--  Lista de resultados  -->
                    <RowDefinition Height="30" />
                    <!--  Paginación  -->
                </Grid.RowDefinitions>




                <!--  Cabecera: breadcrumb izq · controles voz der  -->
                <Grid
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Ruta  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.5"
                            Text="Ruta:" />
                        <TextBlock
                            x:Name="BreadcrumbText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="/" />
                    </StackPanel>

                    <!--  Controles lectura por voz  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="BtnSpeechPrev"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPrev_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Anterior">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ToggleButton
                            x:Name="BtnSpeechPlay"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPlayPause_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Reproducir / Pausar">
                            <SymbolIcon x:Name="BtnSpeechPlayIcon" Symbol="Play" />
                        </ToggleButton>
                        <Button
                            x:Name="BtnSpeechNext"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictNext_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Siguiente">
                            <SymbolIcon Symbol="Forward" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Encabezados de columnas estilo Everything  -->
                <Grid
                    x:Name="ResultsHeaderGrid"
                    Grid.Row="1"
                    Padding="8,0"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderPathColumn" Width="150" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderNameColumn" Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderStatusColumn" Width="180" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderScheduledDateColumn" Width="155" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderDateColumn" Width="145" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D6D6D6"
                        Text="Path" />

                    <Thumb
                        x:Name="PathNameSplitter"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="PathNameSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Path" />

                    <!--  Ordenar por nombre A-Z / Z-A  -->
                    <Button
                        x:Name="HeaderNameSortButton"
                        Grid.Column="2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HeaderNameSort_Click"
                        ToolTipService.ToolTip="Ordenar por nombre">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D6D6D6"
                                Text="Name" />
                            <TextBlock
                                x:Name="NameSortArrow"
                                FontSize="10"
                                Foreground="#D6D6D6"
                                Text="▲" />
                        </StackPanel>
                    </Button>

                    <Thumb
                        x:Name="NameStatusSplitter"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="NameStatusSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Name y Estado actualización" />

                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D6D6D6"
                        Text="Estado actualización"
                        TextTrimming="CharacterEllipsis" />

                    <Thumb
                        x:Name="StatusDateSplitter"
                        Grid.Column="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="StatusScheduledDateSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Estado y Fecha por hacer" />

                    <!--  Ordenar por Fecha por hacer ascendente / descendente  -->
                    <Button
                        x:Name="HeaderScheduledDateSortButton"
                        Grid.Column="6"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HeaderScheduledDateSort_Click"
                        ToolTipService.ToolTip="Ordenar por Fecha por hacer">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D6D6D6"
                                Text="Fecha por hacer"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="ScheduledDateSortArrow"
                                FontSize="10"
                                Foreground="#D6D6D6"
                                Text="" />
                        </StackPanel>
                    </Button>

                    <Thumb
                        x:Name="ScheduledDateDateSplitter"
                        Grid.Column="7"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="ScheduledDateDateSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Fecha por hacer y Date Modified" />

                    <!--  Ordenar por fecha reciente / antigua  -->
                    <Button
                        x:Name="HeaderModifiedSortButton"
                        Grid.Column="8"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HeaderModifiedSort_Click"
                        ToolTipService.ToolTip="Ordenar por fecha modificada">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D6D6D6"
                                Text="Date Modified" />
                            <TextBlock
                                x:Name="ModifiedSortArrow"
                                FontSize="10"
                                Foreground="#D6D6D6"
                                Text="" />
                        </StackPanel>
                    </Button>

                </Grid>

                <!--  Lista de resultados estilo Everything  -->
                <Grid
                    x:Name="ResultsViewHost"
                    Grid.Row="2"
                    IsTabStop="True"
                    PointerPressed="ResultsViewHost_PointerPressed">
                    <Border
                        x:Name="LoadingOverlay"
                        Canvas.ZIndex="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="22,16"
                        Background="#E61B1F23"
                        BorderBrush="#5B8DEF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel
                            MinWidth="280"
                            MaxWidth="520"
                            Orientation="Horizontal"
                            Spacing="14">
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />

                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="LoadingTitleText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Text, ElementName=StatusText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LoadingDetailText"
                                    FontSize="12"
                                    Opacity="0.72"
                                    Text="Espera un momento mientras ANFETA termina la operación."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="NotionDropOverlay"
                        Canvas.ZIndex="80"
                        Margin="18"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#E620242A"
                        BorderBrush="#49B6FF"
                        BorderThickness="2"
                        CornerRadius="14"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                Spacing="10">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="42"
                                    Glyph="&#xE898;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Suelta para subir a Notion"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Opacity="0.76"
                                    Text="Se abrirá el flujo para elegir una página o páginas separadas."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="ResultsList"
                        DoubleTapped="ResultsList_DoubleTapped"
                        ItemsSource="{x:Bind Results, Mode=OneWay}"
                        RightTapped="ResultsList_RightTapped"
                        SelectionChanged="ResultsList_SelectionChanged"
                        SelectionMode="Extended">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,7,0,2"
                                            Padding="10,6"
                                            Background="#26000000"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Opacity="0.92"
                                                Text="{Binding HeaderText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultRow">
                                <Grid
                                    Height="22"
                                    Padding="8,0"
                                    ColumnSpacing="0"
                                    Tag="ResultColumns">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="145" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Path: en Notion muestra la base correspondiente  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Foreground="#B8B8B8"
                                        MaxLines="1"
                                        Text="{x:Bind PathColumn, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <!--  Name  -->
                                    <Grid
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#B8B8B8"
                                            Glyph="&#xE774;" />

                                        <TextBlock
                                            x:Name="NameText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            DataContextChanged="NameText_DataContextChanged"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#F2F2F2"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>

                                    <!--  Estado texto actualización proyecto  -->
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="11"
                                        Foreground="#D4D4D4"
                                        MaxLines="1"
                                        Text="{x:Bind ProjectUpdateStatus, Mode=OneWay, FallbackValue='—'}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind ProjectUpdateStatus, Mode=OneWay}" />

                                    <!--  Fecha por hacer  -->
                                    <TextBlock
                                        Grid.Column="6"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="11"
                                        Foreground="#D4D4D4"
                                        MaxLines="1"
                                        Text="{x:Bind FechaPorHacerColumn, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind ScheduledDate, Mode=OneWay}" />

                                    <!--  Date Modified  -->
                                    <TextBlock
                                        Grid.Column="8"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Foreground="#B8B8B8"
                                        MaxLines="1"
                                        Text="{x:Bind DateModifiedColumn, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="ResultsContextFlyout" Opening="ResultsContextFlyout_Opening">

                                <MenuFlyoutItem
                                    x:Name="CtxMenuOpenItem"
                                    Click="CtxOpen_Click"
                                    Text="Abrir" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuOpenExplorerItem"
                                    Click="CtxOpenPath_Click"
                                    Text="Abrir en Explorador Local" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="CtxCopyName_Click"
                                    Text="Copiar nombre" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCopyPathItem"
                                    Click="CtxCopyPath_Click"
                                    Text="Copiar ruta" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCopyLinkItem"
                                    Click="CtxCopyLink_Click"
                                    Text="Copiar link" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCopyDomainItem"
                                    Click="CtxCopyDomain_Click"
                                    Text="Copiar dominio" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuOpenDomainItem"
                                    Click="CtxOpenDomain_Click"
                                    Text="Ir al dominio" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCreateDropboxFolderItem"
                                    Click="CtxCreateDropboxFolder_Click"
                                    Text="Crear carpeta aquí..." />

                                <MenuFlyoutSubItem
                                    x:Name="CtxMenuUploadFileSubItem"
                                    Text="Subir archivo">
                                    <MenuFlyoutItem
                                        x:Name="CtxMenuUploadDropboxFileItem"
                                        Click="CtxUploadDropboxFile_Click"
                                        Text="A Dropbox..." />
                                    <MenuFlyoutItem
                                        x:Name="CtxMenuUploadNotionFileItem"
                                        Click="CtxUploadNotionFile_Click"
                                        Text="A Notion — Revisiones..." />
                                </MenuFlyoutSubItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuRenameItem"
                                    Click="CtxRename_Click"
                                    Text="Renombrar…" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuDeleteItem"
                                    Click="CtxDelete_Click"
                                    Text="Eliminar" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuBookmarkItem"
                                    Click="CtxBookmark_Click"
                                    Text="Agregar a Favoritos" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>

                    <GridView
                        x:Name="ResultsThumbnailGrid"
                        Canvas.ZIndex="5"
                        IsItemClickEnabled="False"
                        SelectionMode="Extended"
                        Visibility="Collapsed"
                        DoubleTapped="ResultsThumbnailGrid_DoubleTapped"
                        RightTapped="ResultsThumbnailGrid_RightTapped"
                        SelectionChanged="ResultsThumbnailGrid_SelectionChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    MaximumRowsOrColumns="0"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>

                        <GridView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="4,9,4,3"
                                            Padding="10,6"
                                            Background="#26000000"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding HeaderText}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>

                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultRow">
                                <Grid
                                    Width="{x:Bind ThumbnailTileWidth, Mode=OneWay}"
                                    Height="{x:Bind ThumbnailTileHeight, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Margin="4"
                                        Background="#25000000"
                                        CornerRadius="6">
                                        <Grid>
                                            <IconSourceElement
                                                Width="52"
                                                Height="52"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IconSource="{x:Bind Icon, Mode=OneWay}" />

                                            <Image
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="5,2"
                                        HorizontalAlignment="Stretch"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords"
                                        ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock
                        x:Name="EmptyResultsHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.5"
                        Text="No hay resultados" />
                </Grid>

                <!--  Paginación — altura fija 30px para que nunca se corte  -->
                <Grid
                    Grid.Row="3"
                    Padding="8,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!--  Prev  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Next  -->
                        <ColumnDefinition Width="*" />
                        <!--  Spacer  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageInfo  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageSize  -->
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnPrevPage_Click"
                        Content="⟨"
                        CornerRadius="5"
                        FontSize="13" />
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnNextPage_Click"
                        Content="⟩"
                        CornerRadius="5"
                        FontSize="13" />

                    <TextBlock
                        x:Name="PageInfoText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.65"
                        Text="Página 1" />

                    <ComboBox
                        x:Name="PageSizeCombo"
                        Grid.Column="4"
                        Height="24"
                        VerticalAlignment="Center"
                        PlaceholderText="Tamaño"
                        SelectionChanged="PageSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="25" Tag="25" />
                        <ComboBoxItem Content="50" Tag="50" />
                        <ComboBoxItem Content="100" Tag="100" />
                    </ComboBox>
                </Grid>

            </Grid>


            <!--  ── RIGHT PANEL ──────────────────────────────────  -->
            <Border
                x:Name="DetailsPane"
                Grid.Column="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Visible">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <!--  Header Detalles  -->
                        <RowDefinition Height="*" />
                        <!--  Detalles y vista previa  -->
                        <RowDefinition Height="38" />
                        <!--  Acciones  -->
                    </Grid.RowDefinitions>

                    <!--  Header Detalles  -->
                    <Grid
                        Grid.Row="0"
                        Padding="10,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.55"
                            Text="DETALLES" />
                    </Grid>

                    <!--  Detalles  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Padding="12,10"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="DetailsTitle"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Selecciona un elemento"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailsPath"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Padding="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Opacity="0.55"
                                        Text="Metadata" />
                                    <TextBlock
                                        x:Name="DetailsMeta"
                                        FontSize="11"
                                        Opacity="0.65"
                                        Text="—"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="LocalImagePreviewCard"
                                Padding="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Opacity="0.70"
                                            Text="VISTA PREVIA DE IMAGEN" />

                                        <Button
                                            Grid.Column="1"
                                            MinWidth="34"
                                            Height="26"
                                            Padding="6,0"
                                            Click="LocalImageZoomOut_Click"
                                            Content="−"
                                            CornerRadius="5" />

                                        <Button
                                            Grid.Column="2"
                                            MinWidth="52"
                                            Height="26"
                                            Padding="6,0"
                                            Click="LocalImageResetZoom_Click"
                                            Content="100%"
                                            CornerRadius="5" />

                                        <Button
                                            Grid.Column="3"
                                            MinWidth="34"
                                            Height="26"
                                            Padding="6,0"
                                            Click="LocalImageZoomIn_Click"
                                            Content="+"
                                            CornerRadius="5" />

                                        <Button
                                            Grid.Column="4"
                                            Height="26"
                                            Padding="8,0"
                                            Click="LocalImageFit_Click"
                                            Content="Ajustar"
                                            CornerRadius="5" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="LocalImagePreviewStatus"
                                        FontSize="10"
                                        Opacity="0.65"
                                        Text="Ctrl + rueda para acercar o alejar."
                                        TextWrapping="Wrap" />

                                    <Border
                                        Height="360"
                                        Background="#26000000"
                                        CornerRadius="5">
                                        <Grid>
                                            <ScrollViewer
                                                x:Name="LocalImageScrollViewer"
                                                IsTabStop="True"
                                                PointerPressed="LocalImageScrollViewer_PointerPressed"
                                                HorizontalScrollBarVisibility="Auto"
                                                HorizontalScrollMode="Enabled"
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalScrollMode="Enabled"
                                                ZoomMode="Disabled">
                                                <Grid
                                                    x:Name="LocalImageCanvas"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Image
                                                        x:Name="LocalImagePreview"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ImageFailed="LocalImagePreview_ImageFailed"
                                                        ImageOpened="LocalImagePreview_ImageOpened"
                                                        Stretch="Fill" />
                                                </Grid>
                                            </ScrollViewer>

                                            <ProgressRing
                                                x:Name="LocalImagePreviewProgress"
                                                Width="26"
                                                Height="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="NotionPreviewCard"
                                Padding="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Opacity="0.70"
                                            Text="VISTA PREVIA" />

                                        <Button
                                            x:Name="BtnReadNotionPreview"
                                            Grid.Column="1"
                                            Height="26"
                                            Padding="9,0"
                                            Click="BtnReadNotionPreview_Click"
                                            Content="▶ Leer"
                                            CornerRadius="5"
                                            ToolTipService.ToolTip="Leer solo el contenido pendiente" />

                                        <Button
                                            x:Name="BtnStopNotionPreviewSpeech"
                                            Grid.Column="2"
                                            Height="26"
                                            Padding="9,0"
                                            Click="BtnStopNotionPreviewSpeech_Click"
                                            Content="■ Detener"
                                            CornerRadius="5"
                                            IsEnabled="False" />

                                        <ProgressRing
                                            x:Name="NotionPreviewProgress"
                                            Grid.Column="3"
                                            Width="16"
                                            Height="16"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="NotionPreviewStatus"
                                        FontSize="10"
                                        Opacity="0.60"
                                        Text="Selecciona una página de Notion."
                                        TextWrapping="Wrap" />

                                    <StackPanel
                                        x:Name="NotionPreviewContent"
                                        Spacing="7" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Acciones — altura fija 38px, nunca se corta  -->
                    <Grid
                        Grid.Row="2"
                        Padding="8,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="CtxOpen_Click"
                            Content="Abrir"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            x:Name="BtnDetailsLocation"
                            Grid.Column="1"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="BtnDetailsLink_Click"
                            Content="Ubicación"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            Grid.Column="2"
                            Width="28"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="⋯"
                            CornerRadius="6"
                            FontSize="13">
                            <Button.Flyout>
                                <MenuFlyout x:Name="DetailsMoreFlyout" Opening="DetailsMoreFlyout_Opening">

                                    <MenuFlyoutItem Click="BtnDetailsInfo_Click" Text="Info" />
                                    <MenuFlyoutItem Click="CtxCopyName_Click" Text="Copiar nombre" />

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem
                                        x:Name="DetailsCreateDropboxFolderItem"
                                        Click="CtxCreateDropboxFolder_Click"
                                        Text="Crear carpeta aquí..." />

                                    <MenuFlyoutSubItem
                                        x:Name="DetailsUploadFileSubItem"
                                        Text="Subir archivo">
                                        <MenuFlyoutItem
                                            x:Name="DetailsUploadDropboxFileItem"
                                            Click="CtxUploadDropboxFile_Click"
                                            Text="A Dropbox..." />
                                        <MenuFlyoutItem
                                            x:Name="DetailsUploadNotionFileItem"
                                            Click="CtxUploadNotionFile_Click"
                                            Text="A Notion — Revisiones..." />
                                    </MenuFlyoutSubItem>

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem
                                        x:Name="DetailsRenameItem"
                                        Click="CtxRename_Click"
                                        Text="Renombrar..." />

                                    <MenuFlyoutItem
                                        x:Name="DetailsDeleteItem"
                                        Click="CtxDelete_Click"
                                        Text="Eliminar" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 4 · STATUS BAR  — altura fija 22px, siempre visible
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="4"
            Padding="10,0"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.6"
                    Text="Estado: Dropbox" />
                <TextBlock
                    x:Name="VoiceDebugText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text=""
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border
                x:Name="NotionSyncNotice"
                Grid.Column="1"
                MaxWidth="260"
                Height="20"
                Padding="8,1"
                VerticalAlignment="Center"
                Background="#2428A745"
                BorderBrush="#5528A745"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed"
                ToolTipService.ToolTip="{Binding Text, ElementName=NotionSyncInfoText}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5">
                    <FontIcon
                        x:Name="NotionSyncNoticeIcon"
                        FontSize="10"
                        Glyph="&#xE73E;"
                        Foreground="#74D68A" />
                    <TextBlock
                        x:Name="NotionSyncInfoText"
                        MaxWidth="225"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#D7EBDD"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>


            <!--  Accesos rápidos a Google Meet  -->
            <Button
                x:Name="BtnMeetQuickLinks"
                Grid.Column="2"
                Height="26"
                Padding="8,0"
                VerticalAlignment="Center"
                Background="#263F8CFF"
                BorderBrush="#665EA7FF"
                BorderThickness="1"
                CornerRadius="7"
                ToolTipService.ToolTip="Abrir un enlace frecuente de Google Meet">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5">
                    <FontIcon
                        FontSize="12"
                        Foreground="#8DC6FF"
                        Glyph="&#xE714;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Text="Meet" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="8"
                        Glyph="&#xE70D;"
                        Opacity="0.75" />
                </StackPanel>

                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem
                            Click="OpenMeetQuickLink_Click"
                            Tag="https://meet.google.com/eye-rmmg-rgb"
                            Text="Meet 1 · eye-rmmg-rgb" />
                        <MenuFlyoutItem
                            Click="OpenMeetQuickLink_Click"
                            Tag="https://meet.google.com/omp-srcb-uix"
                            Text="Meet 2 · omp-srcb-uix" />
                        <MenuFlyoutItem
                            Click="OpenMeetQuickLink_Click"
                            Tag="https://meet.google.com/vhv-vyjf-ten"
                            Text="Meet 3 · vhv-vyjf-ten" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Click="ConfigureMeetBrowser_Click"
                            Text="Cambiar navegador…" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <ComboBox
                x:Name="CalendarPhaseFilterCombo"
                Grid.Column="3"
                Width="205"
                Height="30"
                Margin="10,2"
                Padding="10,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                SelectedIndex="0"
                SelectionChanged="CalendarPhaseFilterCombo_SelectionChanged"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Filtrar por fase con coincidencia exacta">
                <ComboBoxItem Content="Todas las fases" Tag="" />
                <ComboBoxItem Content="Por hacer · prtuzREVISION" Tag="prtuzREVISION" />
                <ComboBoxItem Content="Para revisar · rtuzREVISION" Tag="rtuzREVISION" />
                <ComboBoxItem Content="Suspendidos · sprtuzREVISION" Tag="sprtuzREVISION" />
                <ComboBoxItem Content="Terminadas · zREVISION" Tag="zREVISION" />
            </ComboBox>

            <TextBlock
                x:Name="ModeText"
                Grid.Column="4"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="Modo: Buscar" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="5"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="0 resultados" />
        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            POPUP AYUDA
            ═══════════════════════════════════════════════════════
        -->
        <Popup x:Name="HelpPopup" IsLightDismissEnabled="True">
            <Grid
                Width="{Binding ElementName=RootLayout, Path=ActualWidth}"
                Height="{Binding ElementName=RootLayout, Path=ActualHeight}"
                Background="#90000000">
                <Border
                    Width="600"
                    MaxWidth="650"
                    MaxHeight="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Black"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Ayuda · Comandos de búsqueda" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter x:Name="HelpContentHost" />
                        </ScrollViewer>
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Click="HelpPopupClose_Click"
                            Content="Cerrar" />
                    </Grid>
                </Border>
            </Grid>
        </Popup>

    </Grid>
</Page>
