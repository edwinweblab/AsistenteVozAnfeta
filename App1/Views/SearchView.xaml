                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.65"
                    Text="Agrupar" />

                    <ComboBox
                    x:Name="GroupResultsCombo"
                    Width="125"
                    Height="26"
                    FontSize="11"
