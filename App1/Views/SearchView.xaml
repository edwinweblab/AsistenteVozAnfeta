            </ScrollViewer>

            <StackPanel Visibility="Collapsed">
                <ToggleButton x:Name="ChipPdf" />
                <ToggleButton x:Name="ChipDocx" />
                <ToggleButton x:Name="ChipXlsx" />
                <ToggleButton x:Name="ChipImg" />
                <ToggleButton x:Name="ChipUrl" />
                <ToggleButton x:Name="ChipRecent" />
                <ToggleButton x:Name="ChipFolders" />
            </StackPanel>

            <!--
                FilterTypeCombo se conserva con Visibility=Collapsed
                para que el code-behind que lo referencia no rompa.
                Ya no se muestra porque los chips lo reemplazan.
            -->
            <ComboBox
                x:Name="FilterTypeCombo"
                SelectionChanged="FilterTypeCombo_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem Content="Todo" Tag="all" />
                <ComboBoxItem Content="PDF" Tag="pdf" />
                <ComboBoxItem Content="DOCX" Tag="docx" />
                <ComboBoxItem Content="XLSX" Tag="xlsx" />
                <ComboBoxItem Content="IMG" Tag="img" />
                <ComboBoxItem Content="URL" Tag="url" />
                <ComboBoxItem Content="Recientes" Tag="recent" />
                <ComboBoxItem Content="Favoritos" Tag="bookmarks" />
                <ComboBoxItem Content="Solo carpetas" Tag="folders" />
            </ComboBox>


        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 3 · BODY   Left | div | Center | div | Right
            ═══════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FoldersPaneCol" Width="220" />
                <ColumnDefinition Width="1" />
                <!--  div izq-centro  -->
                <ColumnDefinition Width="*" MinWidth="320" />
                <!--  Centro  -->
                <ColumnDefinition
                    x:Name="DetailsSplitterCol"
                    Width="12" />
                <!--  divisor ajustable centro-derecha  -->
                <ColumnDefinition
                    x:Name="DetailsCol"
                    Width="380"
                    MinWidth="260"
                    MaxWidth="750" />
            </Grid.ColumnDefinitions>

            <!--  Vista de mensajes y recordatorios; lógica en SearchView.Messages.cs  -->
            <Grid
                x:Name="MessagesHost"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Canvas.ZIndex="510"
                Background="#111820"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="12,9"
                    Background="#191F28"
                    BorderBrush="#34404D"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="185" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Mensajes" />

                        <Button
                            Grid.Column="1"
                            Height="32"
                            Padding="12,0"
                            Click="MessagesNew_Click"
                            Content="+ Nuevo mensaje"
                            CornerRadius="6" />

                        <ComboBox
                            x:Name="MessagesFilterCombo"
                            Grid.Column="2"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="MessagesFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="Recibidos" Tag="received" />
                            <ComboBoxItem Content="Enviados" Tag="sent" />
                            <ComboBoxItem Content="Conversaciones" Tag="conversations" />
                            <ComboBoxItem Content="Vencidos" Tag="overdue" />
                            <ComboBoxItem Content="Terminados" Tag="completed" />
                            <ComboBoxItem Content="Todos" Tag="all" />
                        </ComboBox>

                        <ComboBox
                            x:Name="MessagesTypeCombo"
                            Grid.Column="3"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="MessagesTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Todos los tipos" Tag="all" />
                            <ComboBoxItem Content="Recordatorios" Tag="reminders" />
                            <ComboBoxItem Content="Proyectos" Tag="projects" />
                            <ComboBoxItem Content="Revisiones" Tag="reviews" />
                        </ComboBox>

                        <ComboBox
                            x:Name="MessagesGroupCombo"
                            Grid.Column="4"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="MessagesGroupCombo_SelectionChanged">
                            <ComboBoxItem Content="Dominio / proyecto" Tag="domainproject" />
                            <ComboBoxItem Content="Sin agrupar" Tag="none" />
                            <ComboBoxItem Content="Por persona" Tag="person" />
                            <ComboBoxItem Content="Tipo de proyecto" Tag="project" />
                            <ComboBoxItem Content="Por mes" Tag="month" />
                        </ComboBox>

                        <TextBox
                            x:Name="MessagesSearchBox"
                            Grid.Column="5"
                            Height="32"
                            PlaceholderText="Buscar en mensajes..."
                            TextChanged="MessagesSearchBox_TextChanged" />

                        <TextBlock
                            x:Name="MessagesSummaryText"
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            Opacity="0.72"
                            Text="0 mensajes" />

                        <Button
                            Grid.Column="7"
                            Height="30"
                            Padding="12,0"
                            Click="MessagesRefresh_Click"
                            Content="Actualizar"
                            CornerRadius="6" />

                        <Button
                            Grid.Column="8"
                            Width="32"
                            Height="30"
                            Padding="0"
                            Click="MessagesClose_Click"
                            Content="✕"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Cerrar mensajes" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="#0B1118">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="320" MaxWidth="480" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <!--  Bandeja compacta de conversaciones  -->
                    <Grid Grid.Column="0" Background="#111820">
                        <ListView
                            x:Name="MessagesList"
                            Margin="6"
                            IsItemClickEnabled="True"
                            ItemClick="MessagesList_ItemClick"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="6,8,6,3"
                                                Padding="8,4"
                                                Background="#202A35"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Opacity="0.86"
                                                    Text="{Binding Header}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,9"
                                        Background="{Binding CardBackground}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="7">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Width="42"
                                                Height="42"
                                                VerticalAlignment="Top"
                                                Background="{Binding AvatarBrush}"
                                                CornerRadius="21">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding AvatarText}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{Binding ConversationTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    MaxLines="1"
                                                    Opacity="0.82"
                                                    Text="{Binding ConversationPreview}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="10.5"
                                                    MaxLines="1"
                                                    Opacity="0.58"
                                                    Text="{Binding ConversationContactLabel}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Spacing="5">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="10"
                                                    Opacity="0.68"
                                                    Text="{Binding ConversationTimeLabel}" />
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Padding="5,2"
                                                    Background="#E5484D"
                                                    CornerRadius="8"
                                                    Visibility="{Binding UnreadVisibility}">
                                                    <TextBlock
                                                        FontSize="8.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="NUEVO" />
                                                </Border>
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Padding="5,2"
                                                    Background="#334155"
                                                    CornerRadius="7">
                                                    <TextBlock
                                                        FontSize="8.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding MessageTypeLabel}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="MessagesEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="32"
                                Glyph="&#xE8BD;"
                                Opacity="0.55" />
                            <TextBlock
                                x:Name="MessagesEmptyText"
                                MaxWidth="260"
                                FontSize="14"
                                Opacity="0.72"
                                Text="No hay mensajes para este filtro."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="#34404D" />

                    <!--  Historial de la conversación seleccionada  -->
                    <Grid Grid.Column="2" Background="#0D141C">
                        <StackPanel
                            x:Name="MessagesConversationEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <Border
                                Width="68"
                                Height="68"
                                HorizontalAlignment="Center"
                                Background="#1D2A36"
                                CornerRadius="34">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="30"
                                    Glyph="&#xE8BD;"
                                    Opacity="0.72" />
                            </Border>
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Selecciona una conversación" />
                            <TextBlock
                                MaxWidth="430"
                                Opacity="0.65"
                                Text="El historial se abrirá aquí sin salir de la bandeja de mensajes."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            x:Name="MessagesConversationPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="14,10"
                                Background="#151E27"
                                BorderBrush="#34404D"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        Background="{Binding AvatarBrush}"
                                        CornerRadius="21">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding AvatarText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            x:Name="MessagesChatTitleText"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding ConversationTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Opacity="0.76"
                                            Text="{Binding ConversationPreview}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="MessagesChatConversationStateText"
                                            FontSize="10.5"
                                            Opacity="0.58"
                                            Text="Selecciona una conversación." />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            Padding="9,5"
                                            Click="MessageOpenOriginalActivity_Click"
                                            Content="Abrir actividad"
                                            Tag="{Binding}"
                                            Visibility="{Binding OriginalActivityButtonVisibility}" />
                                        <Button
                                            Padding="9,5"
                                            Click="MessageOpen_Click"
                                            Content="Abrir recordatorio"
                                            Tag="{Binding}"
                                            Visibility="{Binding NormalReminderOpenButtonVisibility}" />
                                        <Button
                                            Padding="9,5"
                                            Click="MessageOpen_Click"
                                            Content="Abrir notificación"
                                            Tag="{Binding}"
                                            Visibility="{Binding ProjectNotificationOpenButtonVisibility}" />
                                        <Button
                                            Padding="9,5"
                                            Click="MessagesChatOpenFull_Click"
                                            Content="Chat completo"
                                            ToolTipService.ToolTip="Abrir adjuntos, audio y acciones avanzadas" />
                                        <Button
                                            Width="34"
                                            Height="30"
                                            Padding="0"
                                            Click="MessagesChatRefresh_Click"
                                            Content="↻"
                                            ToolTipService.ToolTip="Actualizar historial" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer
                                x:Name="MessagesChatHistoryScroll"
                                Grid.Row="1"
                                Padding="18,14"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <StackPanel
                                    x:Name="MessagesChatHistoryPanel"
                                    MaxWidth="780"
                                    HorizontalAlignment="Stretch"
                                    Spacing="6" />
                            </ScrollViewer>

                            <Border
                                Grid.Row="2"
                                Padding="12,9"
                                Background="#151E27"
                                BorderBrush="#34404D"
                                BorderThickness="0,1,0,0">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="MessagesChatReplyBox"
                                            Grid.Column="0"
                                            MinHeight="38"
                                            MaxHeight="88"
                                            AcceptsReturn="True"
                                            KeyDown="MessagesChatReplyBox_KeyDown"
                                            PlaceholderText="Escribe una respuesta…  Ctrl + Enter para enviar"
                                            TextWrapping="Wrap" />

                                        <Button
                                            Grid.Column="1"
                                            Height="38"
                                            Padding="12,0"
                                            Click="MessagesChatOpenFull_Click"
                                            Content="📎 Audio y archivos"
                                            ToolTipService.ToolTip="Abrir el chat completo para adjuntar archivos o grabar audio" />

                                        <Button
                                            x:Name="MessagesChatSendButton"
                                            Grid.Column="2"
                                            Height="38"
                                            MinWidth="92"
                                            Padding="14,0"
                                            Click="MessagesChatSend_Click"
                                            Content="Enviar" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="MessagesChatStatusText"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Opacity="0.66"
                                            Text="Selecciona una conversación para responder."
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Padding="8,3"
                                                Click="MessageCopyText_Click"
                                                Content="Copiar"
                                                Tag="{Binding}" />
                                            <Button
                                                Padding="8,3"
                                                Click="MessageComplete_Click"
                                                Content="{Binding CompleteButtonText}"
                                                IsEnabled="{Binding CanComplete}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding CompleteButtonToolTip}" />
                                            <Button
                                                Padding="8,3"
                                                Click="MessageDelete_Click"
                                                Content="{Binding DeleteButtonText}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding DeleteButtonToolTip}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>


            <!--  Calendario exclusivo de recordatorios; lógica en SearchView.RemindersCalendar.cs  -->
