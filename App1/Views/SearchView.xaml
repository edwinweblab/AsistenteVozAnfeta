<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Body -->
            <RowDefinition Height="Auto"/>
            <!-- Footer (estado) -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="12" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox"

                                Grid.Column="0"
                                PlaceholderText="Buscar archivos (Local + Dropbox)..."
                                QueryIcon="Find"/>

                <ToggleButton x:Name="ToggleLocal" Grid.Column="1" Content="Local" IsChecked="True"/>
                <ToggleButton x:Name="ToggleDropbox" Grid.Column="2" Content="Dropbox" IsChecked="True"/>

                <Button x:Name="BtnSearch"
        Grid.Column="3"
        Content="Buscar"
        Click="BtnSearch_Click"/>

            </Grid>
        </Border>

        <!-- BODY -->
        <Pivot Grid.Row="1">
            <PivotItem Header="Resultados">
                <Grid>
                    <ProgressRing x:Name="LoadingRing"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                    <ListView x:Name="ResultsList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultRow">
                                <Grid Padding="10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="10" Padding="8"
                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                        <TextBlock Text="{x:Bind SourceText}" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="2" Text="{x:Bind Target}"
                                               Opacity="0.75"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Column="3"
                                            Content="⭐"
                                            ToolTipService.ToolTip="Agregar a bookmarks"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyResultsHint"
                               Text="No hay resultados"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False"/>
                </Grid>
            </PivotItem>

            <PivotItem Header="Bookmarks">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="12" Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BookmarkSearchBox"
                                     Grid.Column="0"
                                     PlaceholderText="Buscar bookmarks..."/>

                            <ComboBox x:Name="FolderCombo"
                                      Grid.Column="1"
                                      PlaceholderText="Carpeta"/>

                            <Button x:Name="BtnMove" Grid.Column="2" Content="Mover"/>
                            <Button x:Name="BtnDelete" Grid.Column="3" Content="Eliminar"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="BookmarksList" Grid.Row="1">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BookmarkItem">
                                <StackPanel Padding="10" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Folder}" Opacity="0.75"/>
                                    <TextBlock Text="{x:Bind Target}" Opacity="0.75"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyBookmarksHint"
                               Grid.Row="1"
                               Text="Aún no hay bookmarks"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               IsHitTestVisible="False"/>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- FOOTER (estado) -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Estado: Local listo | Dropbox: pendiente"
                       Opacity="0.7"/>

            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Text="0 resultados"
                       Opacity="0.7"/>
        </Grid>
    </Grid>
</Page>
