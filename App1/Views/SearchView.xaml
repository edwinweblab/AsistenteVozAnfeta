                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="Lista"
                    TextAlignment="Center" />

                    <Button
                    Width="28"
                    Height="26"
                    Padding="0"
                    Click="ResultsViewZoomIn_Click"
                    Content="+"
