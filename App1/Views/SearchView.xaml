<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models.Weblab"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:searchModels="using:Anfeta.UI.Models.Search"
    Loaded="SearchView_Loaded"
    NavigationCacheMode="Enabled">

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <!--  Row 0 TopBar  -->
            <RowDefinition Height="32" />
            <!--  Row 1 ChipStrip  -->
            <RowDefinition Height="*" />
            <!--  Row 2 Body  -->
            <RowDefinition Height="22" />
            <!--  Row 3 StatusBar  -->
        </Grid.RowDefinitions>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 0 · TOP BAR
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="0"
            Padding="8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  SearchBox  -->
                <ColumnDefinition Width="Auto" />
                <!--  Micrófono  -->
                <ColumnDefinition Width="Auto" />
                <!--  Ayuda ?  -->
                <ColumnDefinition Width="Auto" />
                <!--  Separador  -->
                <ColumnDefinition Width="Auto" />
                <!--  Toggle Filtros  -->
                <ColumnDefinition Width="Auto" />
                <!--  Toggle Detalles  -->
                <ColumnDefinition Width="Auto" />
                <!--  Separador  -->
                <ColumnDefinition Width="160" />
                <!--  SortCombo  -->
                <ColumnDefinition Width="Auto" />
                <!--  Menú ⋯  -->
            </Grid.ColumnDefinitions>

            <!--  Búsqueda  -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                PlaceholderText="Buscar en Dropbox... (AND / OR / NOT, ext:pdf)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />

            <!--  Micrófono  -->
            <Grid
                Grid.Column="1"
                Width="70"
                Height="32"
                VerticalAlignment="Center">
                <muxc:SplitButton
                    x:Name="VoiceSplit"
                    Height="32"
                    Padding="6,0"
                    HorizontalContentAlignment="Center"
                    Click="VoiceSplit_Click"
                    CornerRadius="7"
                    ToolTipService.ToolTip="Voz">
                    <muxc:SplitButton.Content>
                        <SymbolIcon Symbol="Microphone" />
                    </muxc:SplitButton.Content>
                    <muxc:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="VoiceMenu_Listen_Click" Text="Escuchar ahora" />
                            <MenuFlyoutItem Click="VoiceMenu_Config_Click" Text="Configurar comandos de voz..." />
                        </MenuFlyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>
                <ProgressRing
                    x:Name="VoiceRing"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Ayuda  -->
            <Button
                x:Name="BtnHelp"
                Grid.Column="2"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Click="MenuHelp_Click"
                Content="?"
                CornerRadius="6"
                FontWeight="SemiBold"
                ToolTipService.ToolTip="Ayuda de comandos de búsqueda" />

            <!--  Sep  -->
            <Border
                Grid.Column="3"
                Width="1"
                Height="18"
                VerticalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Toggle Filtros (panel izq)  -->
            <ToggleButton
                x:Name="ToggleFoldersPane"
                Grid.Column="4"
                Height="32"
                VerticalAlignment="Center"
                Click="ToggleFoldersPane_Click"
                Content="Filtros"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel izquierdo" />

            <!--  Toggle Detalles (panel der)  -->
            <ToggleButton
                x:Name="ToggleDetailsPane"
                Grid.Column="5"
                Height="32"
                VerticalAlignment="Center"
                Click="ToggleDetailsPane_Click"
                Content="Detalles"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel derecho" />

            <!--  Sep  -->
            <Border
                Grid.Column="6"
                Width="1"
                Height="18"
                VerticalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Ordenar por  -->
            <ComboBox
                x:Name="SortCombo"
                Grid.Column="7"
                Height="32"
                VerticalAlignment="Center"
                PlaceholderText="Ordenar por"
                SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Nombre (A–Z)" Tag="name_asc" />
                <ComboBoxItem Content="Nombre (Z–A)" Tag="name_desc" />
                <ComboBoxItem Content="Modificado (nuevo)" Tag="mod_desc" />
                <ComboBoxItem Content="Modificado (antiguo)" Tag="mod_asc" />
                <ComboBoxItem Content="Tamaño (mayor)" Tag="size_desc" />
                <ComboBoxItem Content="Tamaño (menor)" Tag="size_asc" />
            </ComboBox>

            <!--  Menú ⋯  -->
            <Button
                Grid.Column="8"
                Width="36"
                Height="32"
                VerticalAlignment="Center"
                Content="⋯"
                CornerRadius="6">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="NewSavedFilter_Click" Text="Nuevo filtro" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ImportFiltersCsv_Click" Text="Importar CSV" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 1 · CHIP STRIP
            Chips visibles. FilterTypeCombo eliminado (redundante).
            Los chips ocultos (Visibility=Collapsed) se conservan
            como fallback para el code-behind si los necesita.
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="1"
            Padding="8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <!--  Chips visibles en una WrapPanel horizontal  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <ToggleButton
                    x:Name="ChipPdf"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="PDF"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipDocx"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="DOCX"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipXlsx"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="XLSX"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipImg"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="IMG"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipUrl"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="URL"
                    CornerRadius="11" />

                <!--  Separador visual  -->
                <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ToggleButton
                    x:Name="ChipBookmarks"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="⭐ Favoritos"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipRecent"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="Recientes"
                    CornerRadius="11" />

                <ToggleButton
                    x:Name="ChipFolders"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="Solo carpetas"
                    CornerRadius="11" />

            </StackPanel>

            <!--
                FilterTypeCombo se conserva con Visibility=Collapsed
                para que el code-behind que lo referencia no rompa.
                Ya no se muestra porque los chips lo reemplazan.
            -->
            <ComboBox
                x:Name="FilterTypeCombo"
                SelectionChanged="FilterTypeCombo_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem Content="Todo" Tag="all" />
                <ComboBoxItem Content="PDF" Tag="pdf" />
                <ComboBoxItem Content="DOCX" Tag="docx" />
                <ComboBoxItem Content="XLSX" Tag="xlsx" />
                <ComboBoxItem Content="IMG" Tag="img" />
                <ComboBoxItem Content="URL" Tag="url" />
                <ComboBoxItem Content="Recientes" Tag="recent" />
                <ComboBoxItem Content="Favoritos" Tag="bookmarks" />
                <ComboBoxItem Content="Solo carpetas" Tag="folders" />
            </ComboBox>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 2 · BODY   Left | div | Center | div | Right
            ═══════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FoldersPaneCol" Width="220" />
                <ColumnDefinition Width="1" />
                <!--  div izq-centro  -->
                <ColumnDefinition Width="*" />
                <!--  Centro  -->
                <ColumnDefinition Width="1" />
                <!--  div centro-der  -->
                <ColumnDefinition x:Name="DetailsCol" Width="210" />
            </Grid.ColumnDefinitions>

            <!--  Divisores verticales  -->
            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />


            <!--  ── LEFT PANEL ───────────────────────────────────  -->
            <Border
                x:Name="FoldersPane"
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  FILTROS GUARDADOS  -->
                        <Grid x:Name="SavedFiltersExpander">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <Grid
                                Grid.Row="0"
                                Height="30"
                                Padding="10,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="FILTROS GUARDADOS" />
                                <Button
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NewSavedFilter_Click"
                                    ToolTipService.ToolTip="Nuevo filtro guardado">
                                    <Viewbox
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform">
                                        <SymbolIcon Symbol="Add" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!--  Lista — MaxHeight limita a ~7 items, el resto con scroll  -->
                            <ListView
                                x:Name="SavedFiltersList"
                                Grid.Row="1"
                                MaxHeight="200"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="SavedFiltersList_ItemClick"
                                ItemsSource="{x:Bind _savedFilters, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="searchModels:SavedSearchFilter">
                                        <Grid
                                            MinHeight="28"
                                            HorizontalAlignment="Stretch"
                                            RightTapped="SavedFilter_RightTapped">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!--  Hint vacío  -->
                            <TextBlock
                                x:Name="SavedFiltersEmptyHint"
                                Grid.Row="2"
                                Margin="10,6,0,8"
                                FontSize="11"
                                Opacity="0.5"
                                Text="Aún no hay filtros guardados"
                                Visibility="Collapsed" />
                        </Grid>

                        <!--  MÁS OPCIONES  -->
                        <muxc:Expander
                            x:Name="MoreOptionsExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <muxc:Expander.Header>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="MÁS OPCIONES" />
                            </muxc:Expander.Header>

                            <StackPanel>

                                <!--  CARPETAS  -->
                                <muxc:Expander
                                    x:Name="FoldersTreeExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Height="30"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                        </Grid>
                                        <TreeView
                                            x:Name="FolderTree"
                                            Expanding="FolderTree_Expanding"
                                            ItemInvoked="FolderTree_ItemInvoked">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                        <StackPanel
                                            x:Name="EmptyTreeHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Opacity="0.55"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Sin árbol cargado" />
                                            <TextBlock
                                                MaxWidth="180"
                                                FontSize="11"
                                                Text="Pulsa &quot;Actualizar&quot; para cargar carpetas"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  COMANDOS GUARDADOS  -->
                                <muxc:Expander
                                    x:Name="CommandsExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Comandos" />
                                            <Button
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="BtnQuickSaveCommand_Click"
                                                ToolTipService.ToolTip="Guardar búsqueda actual como comando">
                                                <Viewbox
                                                    Width="12"
                                                    Height="12"
                                                    Stretch="Uniform">
                                                    <SymbolIcon Symbol="Add" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </muxc:Expander.Header>
                                    <StackPanel>
                                        <ListView
                                            x:Name="CommandsSidebarList"
                                            MaxHeight="180"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            IsItemClickEnabled="True"
                                            ItemClick="CommandsSidebarList_ItemClick"
                                            SelectionChanged="CommandsSidebarList_SelectionChanged"
                                            SelectionMode="Single">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Setter Property="MinHeight" Value="32" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="32" RightTapped="CommandRow_RightTapped">
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                MaxLines="1"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                MaxLines="1"
                                                                Opacity="0.55"
                                                                Text="{Binding Query}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="CommandsSidebarEmptyHint"
                                            Margin="10,4,0,6"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="Aún no hay comandos" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  CARPETAS EXCLUIDAS  -->
                                <muxc:Expander
                                    x:Name="ExcludedExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas excluidas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnAddExcludedFolder_Click"
                                                Content="Excluir carpeta..."
                                                CornerRadius="6"
                                                FontSize="13" />
                                        </Grid>
                                        <ListView
                                            x:Name="ExcludedFoldersList"
                                            MaxHeight="100"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="28" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Opacity="0.8"
                                                            Text="{Binding}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="BtnRemoveExcludedFolder_Click"
                                                            Tag="{Binding}"
                                                            ToolTipService.ToolTip="Quitar exclusión">
                                                            <Viewbox
                                                                Width="10"
                                                                Height="10"
                                                                Stretch="Uniform">
                                                                <SymbolIcon Symbol="Cancel" />
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="ExcludedHint"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="No hay carpetas excluidas" />
                                    </StackPanel>
                                </muxc:Expander>

                            </StackPanel>
                        </muxc:Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── CENTER PANEL ──────────────────────────────────  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <!--  Cabecera: breadcrumb + voz  -->
                    <RowDefinition Height="*" />
                    <!--  Lista de resultados  -->
                    <RowDefinition Height="30" />
                    <!--  Paginación  -->
                </Grid.RowDefinitions>

                <!--  Cabecera: breadcrumb izq · controles voz der  -->
                <Grid
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Ruta  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.5"
                            Text="Ruta:" />
                        <TextBlock
                            x:Name="BreadcrumbText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="/" />
                    </StackPanel>

                    <!--  Controles lectura por voz  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="BtnSpeechPrev"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPrev_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Anterior">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ToggleButton
                            x:Name="BtnSpeechPlay"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPlayPause_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Reproducir / Pausar">
                            <SymbolIcon x:Name="BtnSpeechPlayIcon" Symbol="Play" />
                        </ToggleButton>
                        <Button
                            x:Name="BtnSpeechNext"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictNext_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Siguiente">
                            <SymbolIcon Symbol="Forward" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Lista de resultados  -->
                <Grid Grid.Row="1">
                    <ProgressRing
                        x:Name="LoadingRing"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="ResultsList"
                        DoubleTapped="ResultsList_DoubleTapped"
                        RightTapped="ResultsList_RightTapped"
                        SelectionChanged="ResultsList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultRow">
                                <Grid Height="26" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="7">
                                        <IconSourceElement
                                            Width="14"
                                            Height="14"
                                            IconSource="{x:Bind Icon, Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="NameText"
                                            VerticalAlignment="Center"
                                            DataContextChanged="NameText_DataContextChanged"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="28"
                                        Height="22"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnStar_Click"
                                        Content="{x:Bind StarGlyph, Mode=OneWay}"
                                        FontSize="11"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Agregar / quitar Favorito" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="CtxOpen_Click" Text="Abrir" />
                                <MenuFlyoutItem Click="CtxOpenWeb_Click" Text="Abrir en Explorador Local" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="CtxCopyPath_Click" Text="Copiar ruta" />
                                <MenuFlyoutItem Click="CtxCopyLink_Click" Text="Copiar link" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="CtxRename_Click" Text="Renombrar…" />
                                <MenuFlyoutItem Click="CtxDelete_Click" Text="Eliminar" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="CtxBookmark_Click" Text="Agregar a Favoritos" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyResultsHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.5"
                        Text="No hay resultados" />
                </Grid>

                <!--  Paginación — altura fija 30px para que nunca se corte  -->
                <Grid
                    Grid.Row="2"
                    Padding="8,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!--  Prev  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Next  -->
                        <ColumnDefinition Width="*" />
                        <!--  Spacer  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageInfo  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageSize  -->
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnPrevPage_Click"
                        Content="⟨"
                        CornerRadius="5"
                        FontSize="13" />
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnNextPage_Click"
                        Content="⟩"
                        CornerRadius="5"
                        FontSize="13" />

                    <TextBlock
                        x:Name="PageInfoText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.65"
                        Text="Página 1" />

                    <ComboBox
                        x:Name="PageSizeCombo"
                        Grid.Column="4"
                        Height="24"
                        VerticalAlignment="Center"
                        PlaceholderText="Tamaño"
                        SelectionChanged="PageSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="25" Tag="25" />
                        <ComboBoxItem Content="50" Tag="50" />
                        <ComboBoxItem Content="100" Tag="100" />
                    </ComboBox>
                </Grid>

            </Grid>


            <!--  ── RIGHT PANEL ──────────────────────────────────  -->
            <Border
                x:Name="DetailsPane"
                Grid.Column="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Visible">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <!--  Header Favoritos  -->
                        <RowDefinition Height="Auto" />
                        <!--  Search Favoritos  -->
                        <RowDefinition Height="140" />
                        <!--  Lista Favoritos  -->
                        <RowDefinition Height="30" />
                        <!--  Header Detalles  -->
                        <RowDefinition Height="*" />
                        <!--  Detalles  -->
                        <RowDefinition Height="38" />
                        <!--  Acciones  -->
                    </Grid.RowDefinitions>

                    <!--  Header Favoritos  -->
                    <Grid
                        Grid.Row="0"
                        Padding="10,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.55"
                            Text="FAVORITOS" />
                    </Grid>

                    <!--  Search Favoritos  -->
                    <AutoSuggestBox
                        Grid.Row="1"
                        Margin="8,5,8,4"
                        FontSize="12"
                        PlaceholderText="Search Favoritos" />

                    <!--  Lista Favoritos  -->
                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="BookmarksList_ItemClick"
                        ItemsSource="{x:Bind _bookmarks, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10"
                                            MaxLines="1"
                                            Opacity="0.5"
                                            Text="{Binding LocalPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnBookmarkPanelStar_Click"
                                        Content="★"
                                        FontSize="11"
                                        Tag="{Binding LocalPath}"
                                        ToolTipService.ToolTip="Quitar Favorito" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  Header Detalles  -->
                    <Grid
                        Grid.Row="3"
                        Padding="10,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.55"
                            Text="DETALLES" />
                    </Grid>

                    <!--  Detalles  -->
                    <ScrollViewer
                        Grid.Row="4"
                        Padding="10,8"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="DetailsTitle"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Selecciona un elemento"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailsPath"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Padding="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Opacity="0.55"
                                        Text="Metadata" />
                                    <TextBlock
                                        x:Name="DetailsMeta"
                                        FontSize="11"
                                        Opacity="0.65"
                                        Text="—"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Acciones — altura fija 38px, nunca se corta  -->
                    <Grid
                        Grid.Row="5"
                        Padding="8,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="CtxOpen_Click"
                            Content="Abrir"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            Grid.Column="1"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="BtnDetailsLink_Click"
                            Content="Ubicación"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            Grid.Column="2"
                            Width="28"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="⋯"
                            CornerRadius="6"
                            FontSize="13">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="BtnDetailsInfo_Click" Text="Info" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="CtxRename_Click" Text="Renombrar..." />
                                    <MenuFlyoutItem Click="CtxDelete_Click" Text="Eliminar" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 3 · STATUS BAR  — altura fija 22px, siempre visible
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="3"
            Padding="10,0"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.6"
                    Text="Estado: Dropbox" />
                <TextBlock
                    x:Name="VoiceDebugText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text=""
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock
                x:Name="ModeText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="Modo: Buscar" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="0 resultados" />
        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            POPUP AYUDA 
            ═══════════════════════════════════════════════════════
        -->
        <Popup x:Name="HelpPopup" IsLightDismissEnabled="True">
            <Grid
                Width="{Binding ElementName=RootLayout, Path=ActualWidth}"
                Height="{Binding ElementName=RootLayout, Path=ActualHeight}"
                Background="#90000000">
                <Border
                    Width="600"
                    MaxWidth="650"
                    MaxHeight="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Black"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Ayuda · Comandos de búsqueda" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter x:Name="HelpContentHost" />
                        </ScrollViewer>
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Click="HelpPopupClose_Click"
                            Content="Cerrar" />
                    </Grid>
                </Border>
            </Grid>
        </Popup>

    </Grid>
</Page>
