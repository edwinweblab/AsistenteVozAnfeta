<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models.Weblab"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:searchModels="using:Anfeta.UI.Models.Search"
    Loaded="SearchView_Loaded"
    NavigationCacheMode="Enabled">

    <Grid
        x:Name="RootLayout"
        Padding="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!--  HEADER  -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="12">

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Fila principal  -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        PlaceholderText="Buscar en Dropbox... (AND / OR / NOT, ext:pdf)"
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        TextChanged="SearchBox_TextChanged" />

                    <Grid Grid.Column="1" Height="36">
                        <muxc:SplitButton
                            x:Name="VoiceSplit"
                            Height="36"
                            MinWidth="56"
                            Padding="8,0"
                            HorizontalContentAlignment="Center"
                            Click="VoiceSplit_Click"
                            ToolTipService.ToolTip="Voz">

                            <muxc:SplitButton.Content>
                                <SymbolIcon Symbol="Microphone" />
                            </muxc:SplitButton.Content>

                            <muxc:SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="VoiceMenu_Listen_Click" Text="Escuchar ahora" />
                                    <MenuFlyoutItem Click="VoiceMenu_Config_Click" Text="Configurar comandos de voz..." />
                                </MenuFlyout>
                            </muxc:SplitButton.Flyout>
                        </muxc:SplitButton>

                        <ProgressRing
                            x:Name="VoiceRing"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <Button
                        x:Name="BtnHelp"
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Click="MenuHelp_Click"
                        Content="?"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Ayuda de comandos de búsqueda" />



                    <ToggleButton
                        x:Name="ToggleDetailsPane"
                        Grid.Column="3"
                        Click="ToggleDetailsPane_Click"
                        Content="Detalles"
                        IsChecked="True"
                        ToolTipService.ToolTip="Mostrar/ocultar panel derecho" />

                    <ComboBox
                        x:Name="SortCombo"
                        Grid.Column="4"
                        Width="180"
                        PlaceholderText="Ordenar por"
                        SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Nombre (A–Z)" Tag="name_asc" />
                        <ComboBoxItem Content="Nombre (Z–A)" Tag="name_desc" />
                        <ComboBoxItem Content="Modificado (nuevo)" Tag="mod_desc" />
                        <ComboBoxItem Content="Modificado (antiguo)" Tag="mod_asc" />
                        <ComboBoxItem Content="Tamaño (mayor)" Tag="size_desc" />
                        <ComboBoxItem Content="Tamaño (menor)" Tag="size_asc" />
                    </ComboBox>

                    <Button
                        Grid.Column="5"
                        Width="42"
                        Height="36"
                        Content="⋯">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="NewSavedFilter_Click" Text="Nuevo filtro" />
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Click="ImportFiltersCsv_Click" Text="Importar CSV" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--  Fila secundaria compacta  -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton
                        x:Name="ToggleFoldersPane"
                        Grid.Column="0"
                        Click="ToggleFoldersPane_Click"
                        Content="Filtros"
                        IsChecked="True"
                        ToolTipService.ToolTip="Mostrar/ocultar panel izquierdo" />
                    <ComboBox
                        x:Name="FilterTypeCombo"
                        Grid.Column="1"
                        Width="180"
                        PlaceholderText="Filtro"
                        SelectionChanged="FilterTypeCombo_SelectionChanged">

                        <ComboBoxItem Content="Todo" Tag="all" />
                        <ComboBoxItem Content="PDF" Tag="pdf" />
                        <ComboBoxItem Content="DOCX" Tag="docx" />
                        <ComboBoxItem Content="XLSX" Tag="xlsx" />
                        <ComboBoxItem Content="IMG" Tag="img" />
                        <ComboBoxItem Content="URL" Tag="url" />
                        <ComboBoxItem Content="Recientes" Tag="recent" />
                        <ComboBoxItem Content="Favoritos" Tag="bookmarks" />
                        <ComboBoxItem Content="Solo carpetas" Tag="folders" />
                    </ComboBox>
                    <StackPanel Visibility="Collapsed">
                        <ToggleButton
                            x:Name="ChipPdf"
                            Click="ChipFilter_Click"
                            Content="PDF" />
                        <ToggleButton
                            x:Name="ChipDocx"
                            Click="ChipFilter_Click"
                            Content="DOCX" />
                        <ToggleButton
                            x:Name="ChipXlsx"
                            Click="ChipFilter_Click"
                            Content="XLSX" />
                        <ToggleButton
                            x:Name="ChipImg"
                            Click="ChipFilter_Click"
                            Content="IMG" />
                        <ToggleButton
                            x:Name="ChipUrl"
                            Click="ChipFilter_Click"
                            Content="URL" />
                        <ToggleButton
                            x:Name="ChipRecent"
                            Click="ChipFilter_Click"
                            Content="Recientes" />
                        <ToggleButton
                            x:Name="ChipBookmarks"
                            Click="ChipFilter_Click"
                            Content="⭐ Favoritos" />
                        <ToggleButton
                            x:Name="ChipFolders"
                            Click="ChipFilter_Click"
                            Content="Solo carpetas" />
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>


        <!--  BODY  -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FoldersPaneCol" Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsCol" Width="280" />
            </Grid.ColumnDefinitions>
            <!--  LEFT: Folders  -->
            <Border
                x:Name="FoldersPane"
                Grid.Column="0"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->


                    <!--  Content  -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Padding="8" Spacing="10">
                            <!--  FILTROS GUARDADOS DIRECTOS  -->
                            <Grid x:Name="SavedFiltersExpander" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Filtros Guardados" />

                                    <Button
                                        Grid.Column="1"
                                        Width="34"
                                        Height="30"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        Click="NewSavedFilter_Click"
                                        ToolTipService.ToolTip="Nuevo filtro guardado">
                                        <Viewbox
                                            Width="14"
                                            Height="14"
                                            Stretch="Uniform">
                                            <SymbolIcon Symbol="Add" />
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!--  Lista directa  -->
                                <ListView
                                    x:Name="SavedFiltersList"
                                    Grid.Row="1"
                                    MaxHeight="320"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    IsItemClickEnabled="True"
                                    ItemClick="SavedFiltersList_ItemClick"
                                    ItemsSource="{x:Bind _savedFilters, Mode=OneWay}"
                                    SelectionMode="None">

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="searchModels:SavedSearchFilter">
                                            <Grid
                                                MinHeight="30"
                                                Padding="6,3"
                                                HorizontalAlignment="Stretch"
                                                RightTapped="SavedFilter_RightTapped">

                                                <TextBlock
                                                    MaxLines="1"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    x:Name="SavedFiltersEmptyHint"
                                    Grid.Row="1"
                                    Margin="8,8,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Opacity="0.6"
                                    Text="Aún no hay filtros guardados"
                                    Visibility="Collapsed" />
                            </Grid>

                            <!--  MÁS OPCIONES  -->
                            <Border
                                Padding="0"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                CornerRadius="10">

                                <muxc:Expander x:Name="MoreOptionsExpander" IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <Grid Margin="2,4,2,4">
                                            <TextBlock FontWeight="SemiBold" Text="Más opciones" />
                                        </Grid>
                                    </muxc:Expander.Header>

                                    <StackPanel Padding="8" Spacing="10">

                                        <!--  CARPETAS  -->
                                        <Border
                                            Padding="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10">

                                            <muxc:Expander x:Name="FoldersTreeExpander" IsExpanded="False">
                                                <muxc:Expander.Header>
                                                    <Grid Margin="2,4,2,4">
                                                        <TextBlock FontWeight="SemiBold" Text="Carpetas" />
                                                    </Grid>
                                                </muxc:Expander.Header>

                                                <StackPanel Padding="8" Spacing="6">
                                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button
                                                            Grid.Column="0"
                                                            Height="36"
                                                            Click="BtnRefreshTree_Click"
                                                            Content="Actualizar" />

                                                        <Button
                                                            Grid.Column="1"
                                                            Height="36"
                                                            Click="BtnGoRoot_Click"
                                                            Content="Inicio (/)" />
                                                    </Grid>

                                                    <TreeView
                                                        x:Name="FolderTree"
                                                        Expanding="FolderTree_Expanding"
                                                        ItemInvoked="FolderTree_ItemInvoked">
                                                        <TreeView.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </TreeView.ItemTemplate>
                                                    </TreeView>

                                                    <StackPanel
                                                        x:Name="EmptyTreeHint"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Opacity="0.65"
                                                        Spacing="6">
                                                        <TextBlock FontWeight="SemiBold" Text="Sin árbol cargado" />
                                                        <TextBlock
                                                            MaxWidth="220"
                                                            Text="Pulsa “Actualizar” para cargar carpetas"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </muxc:Expander>
                                        </Border>

                                        <!--  COMANDOS GUARDADOS  -->
                                        <Border
                                            Padding="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10">

                                            <muxc:Expander x:Name="CommandsExpander" IsExpanded="False">
                                                <muxc:Expander.Header>
                                                    <Grid
                                                        Margin="2,4,2,4"
                                                        VerticalAlignment="Center"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="Comandos" />

                                                        <Button
                                                            Grid.Column="1"
                                                            Width="36"
                                                            Height="32"
                                                            Margin="0,0,6,0"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Background="Transparent"
                                                            Click="BtnQuickSaveCommand_Click"
                                                            ToolTipService.ToolTip="Guardar la búsqueda actual como comando">
                                                            <Viewbox
                                                                Width="14"
                                                                Height="14"
                                                                Stretch="Uniform">
                                                                <SymbolIcon Symbol="Add" />
                                                            </Viewbox>
                                                        </Button>

                                                        <Grid Grid.Column="2" Width="1" />
                                                    </Grid>
                                                </muxc:Expander.Header>

                                                <StackPanel Padding="0" Spacing="6">
                                                    <ListView
                                                        x:Name="CommandsSidebarList"
                                                        MaxHeight="160"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        BorderThickness="0"
                                                        IsItemClickEnabled="True"
                                                        ItemClick="CommandsSidebarList_ItemClick"
                                                        SelectionChanged="CommandsSidebarList_SelectionChanged"
                                                        SelectionMode="Single">

                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid
                                                                    MinHeight="34"
                                                                    Padding="6,4"
                                                                    RightTapped="CommandRow_RightTapped">

                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            MaxLines="1"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />

                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            MaxLines="1"
                                                                            Opacity="0.65"
                                                                            Text="{Binding Query}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <TextBlock
                                                        x:Name="CommandsSidebarEmptyHint"
                                                        Opacity="0.6"
                                                        Text="Aún no hay comandos" />
                                                </StackPanel>
                                            </muxc:Expander>
                                        </Border>

                                        <!--  CARPETAS EXCLUIDAS  -->
                                        <Border
                                            Padding="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10">

                                            <muxc:Expander
                                                x:Name="ExcludedExpander"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                IsExpanded="False">

                                                <muxc:Expander.Header>
                                                    <Grid Margin="2,4,2,4">
                                                        <TextBlock FontWeight="SemiBold" Text="Carpetas excluidas" />
                                                    </Grid>
                                                </muxc:Expander.Header>

                                                <StackPanel
                                                    Padding="8"
                                                    HorizontalAlignment="Stretch"
                                                    Spacing="6">

                                                    <Grid
                                                        HorizontalAlignment="Stretch"
                                                        ColumnSpacing="8"
                                                        RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Height="36"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="BtnRefreshTree_Click"
                                                            Content="Actualizar" />

                                                        <Button
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Height="36"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="BtnGoRoot_Click"
                                                            Content="Inicio (/)" />

                                                        <Button
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Height="36"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="BtnAddExcludedFolder_Click"
                                                            Content="Excluir carpeta..." />
                                                    </Grid>

                                                    <ListView
                                                        x:Name="ExcludedFoldersList"
                                                        MaxHeight="100"
                                                        SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Opacity="0.85"
                                                                        Text="{Binding}"
                                                                        TextTrimming="CharacterEllipsis" />

                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Width="26"
                                                                        Height="26"
                                                                        Padding="0"
                                                                        HorizontalContentAlignment="Center"
                                                                        VerticalContentAlignment="Center"
                                                                        Click="BtnRemoveExcludedFolder_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTipService.ToolTip="Quitar exclusión">
                                                                        <Viewbox
                                                                            Width="12"
                                                                            Height="12"
                                                                            Stretch="Uniform">
                                                                            <SymbolIcon Symbol="Cancel" />
                                                                        </Viewbox>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <TextBlock
                                                        x:Name="ExcludedHint"
                                                        Opacity="0.6"
                                                        Text="No hay carpetas excluidas" />
                                                </StackPanel>
                                            </muxc:Expander>
                                        </Border>

                                    </StackPanel>
                                </muxc:Expander>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  CENTER: Results  -->
            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  Breadcrumbs + lectura de resultados  -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Izquierda: Ruta  -->
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock Opacity="0.7" Text="Ruta:" />
                            <TextBlock
                                x:Name="BreadcrumbText"
                                FontWeight="SemiBold"
                                Text="/" />
                        </StackPanel>

                        <!--  Derecha: controles de lectura  -->
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">

                            <Button
                                x:Name="BtnSpeechPrev"
                                Width="27"
                                Height="27"
                                Padding="0"
                                Click="BtnDictPrev_Click"
                                ToolTipService.ToolTip="Anterior">
                                <SymbolIcon Symbol="Back" />
                            </Button>

                            <Button
                                x:Name="BtnSpeechPlay"
                                Width="27"
                                Height="27"
                                Padding="0"
                                Click="BtnDictPlay_Click"
                                ToolTipService.ToolTip="Reproducir">
                                <SymbolIcon Symbol="Play" />
                            </Button>
                            <Button
                                x:Name="BtnSpeechNext"
                                Width="27"
                                Height="27"
                                Padding="0"
                                Click="BtnDictNext_Click"
                                ToolTipService.ToolTip="Siguiente">
                                <SymbolIcon Symbol="Forward" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!--  Header row: SOLO NOMBRE  -->
                    <Grid
                        Grid.Row="1"
                        Padding="6"
                        Opacity="0.85">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="Nombre" />
                    </Grid>
                    <!--  Results list  -->
                    <Grid Grid.Row="2">
                        <ProgressRing
                            x:Name="LoadingRing"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />

                        <ListView
                            x:Name="ResultsList"
                            DoubleTapped="ResultsList_DoubleTapped"
                            RightTapped="ResultsList_RightTapped"
                            SelectionChanged="ResultsList_SelectionChanged"
                            SelectionMode="Single">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchResultRow">
                                    <Grid Padding="6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">

                                            <IconSourceElement
                                                Width="16"
                                                Height="16"
                                                IconSource="{x:Bind Icon, Mode=OneWay}" />

                                            <TextBlock
                                                x:Name="NameText"
                                                DataContextChanged="NameText_DataContextChanged"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!--  ⭐  -->
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="38"
                                            Click="BtnStar_Click"
                                            Content="{x:Bind StarGlyph, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Agregar / quitar Favorito" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="CtxOpen_Click" Text="Abrir" />
                                    <MenuFlyoutItem Click="CtxOpenWeb_Click" Text="Abrir en Dropbox Web" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="CtxCopyPath_Click" Text="Copiar ruta" />
                                    <MenuFlyoutItem Click="CtxCopyLink_Click" Text="Copiar link" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="CtxRename_Click" Text="Renombrar…" />
                                    <MenuFlyoutItem Click="CtxDelete_Click" Text="Eliminar" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="CtxBookmark_Click" Text="Agregar a Favoritos" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyResultsHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0.6"
                            Text="No hay resultados" />
                    </Grid>

                    <!--  Paging  -->
                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Click="BtnPrevPage_Click"
                            Content="⟨" />
                        <Button
                            Grid.Column="1"
                            Click="BtnNextPage_Click"
                            Content="⟩" />

                        <TextBlock
                            x:Name="PageInfoText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Opacity="0.75"
                            Text="Página 1" />

                        <ComboBox
                            x:Name="PageSizeCombo"
                            Grid.Column="4"
                            Width="110"
                            PlaceholderText="Tamaño"
                            SelectionChanged="PageSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="25" Tag="25" />
                            <ComboBoxItem Content="50" Tag="50" />
                            <ComboBoxItem Content="100" Tag="100" />
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>
            <!--  RIGHT: Details panel (COLAPSABLE)  -->
            <!--  RIGHT: Bookmarks + Details  -->
            <Border
                x:Name="DetailsPane"
                Grid.Column="2"
                Padding="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="Visible">

                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontWeight="SemiBold"
                        Text="Favoritos" />

                    <AutoSuggestBox Grid.Row="1" PlaceholderText="Search Favoritos" />

                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        ItemsSource="{x:Bind _bookmarks, Mode=OneWay}"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            MaxLines="2"
                                            Opacity="0.65"
                                            Text="{Binding LocalPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        MinWidth="38"
                                        Click="BtnBookmarkPanelStar_Click"
                                        Content="★"
                                        Tag="{Binding LocalPath}"
                                        ToolTipService.ToolTip="Quitar Favorito" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        FontWeight="SemiBold"
                        Text="Detalles" />

                    <StackPanel Grid.Row="4" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DetailsTitle"
                                FontWeight="SemiBold"
                                Text="Selecciona un elemento" />
                            <TextBlock
                                x:Name="DetailsPath"
                                Opacity="0.75"
                                Text="—"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Padding="10"
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                            CornerRadius="10">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Metadata" />
                                <TextBlock
                                    x:Name="DetailsMeta"
                                    Opacity="0.75"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <Grid Grid.Row="5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="1"
                            Click="CtxOpen_Click"
                            Content="Abrir" />

                        <Button
                            Grid.Column="2"
                            Click="BtnDetailsLink_Click"
                            Content="Abrir Ubicación" />

                        <Button Grid.Column="3" Content="⋯">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="BtnDetailsInfo_Click" Text="Info" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="CtxRename_Click" Text="Renombrar..." />
                                    <MenuFlyoutItem Click="CtxDelete_Click" Text="Eliminar" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <!--  FOOTER  -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                Opacity="0.7"
                Text="Estado: Dropbox " />
            <TextBlock
                x:Name="VoiceDebugText"
                Grid.Column="0"
                Margin="0,18,0,0"
                FontSize="12"
                Opacity="0.65"
                Text=""
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="ModeText"
                Grid.Column="1"
                Margin="0,0,12,0"
                Opacity="0.7"
                Text="Modo: Buscar" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                Opacity="0.7"
                Text="0 resultados" />
        </Grid>
        <Popup x:Name="HelpPopup" IsLightDismissEnabled="True">
            <Grid
                Width="{Binding ElementName=RootLayout, Path=ActualWidth}"
                Height="{Binding ElementName=RootLayout, Path=ActualHeight}"
                Background="#90000000">

                <Border
                    Width="600"
                    MaxWidth="650"
                    MaxHeight="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1A110E"
                    CornerRadius="12">

                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Ayuda · Comandos de búsqueda" />

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter x:Name="HelpContentHost" />
                        </ScrollViewer>

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Click="HelpPopupClose_Click"
                            Content="Cerrar" />
                    </Grid>

                </Border>
            </Grid>
        </Popup>

    </Grid>
</Page>
