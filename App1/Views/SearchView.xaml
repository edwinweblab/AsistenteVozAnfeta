                            Content="‹"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Día anterior" />

                        <Button
                            Grid.Column="2"
                            Height="30"
                            Padding="10,0"
                            Click="RemindersCalendarToday_Click"
                            Content="Hoy"
                            CornerRadius="6" />

                        <Button
                            Grid.Column="3"
                            Height="30"
                            Padding="10,0"
                            Click="RemindersCalendarNextDay_Click"
                            Content="›"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Día siguiente" />

                        <Button
                            Grid.Column="4"
                            Height="30"
                            Padding="11,0"
                            Click="RemindersCalendarPeople_Click"
