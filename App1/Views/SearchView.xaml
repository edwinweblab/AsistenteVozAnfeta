<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models"
    Loaded="SearchView_Loaded"
    NavigationCacheMode="Enabled">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Border Grid.Row="0"
        CornerRadius="12"
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <!-- Search controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- Chips + sort -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Search + controls (LIMPIO) -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Carpetas -->
                        <ColumnDefinition Width="*"/>
                        <!-- Search -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Ayuda -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Notion -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Detalles -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Más -->
                    </Grid.ColumnDefinitions>

                    <!-- Carpetas -->
                    <ToggleButton x:Name="ToggleFoldersPane"
                          Grid.Column="0"
                          Content="Carpetas"
                          IsChecked="True"
                          Click="ToggleFoldersPane_Click"
                          ToolTipService.ToolTip="Mostrar/ocultar panel de carpetas"/>

                    <!-- Buscador -->
                    <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="Buscar en Dropbox… (AND / OR / NOT, ext:pdf)"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted"/>

                    <!-- AYUDA -->
                    <Button x:Name="BtnHelp"
                    Grid.Column="2"
                    Content="?"
                    Width="34"
                    Height="34"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    ToolTipService.ToolTip="Ayuda de comandos de búsqueda"
                    Click="MenuHelp_Click"/>

                    <!-- Notion -->
                    <ToggleButton x:Name="ToggleNotion"
                          Grid.Column="3"
                          Content="Notion"
                          ToolTipService.ToolTip="Incluir páginas Notion relacionadas"/>

                    <!-- Detalles -->
                    <ToggleButton x:Name="ToggleDetailsPane"
                          Grid.Column="4"
                          Content="Detalles"
                          IsChecked="False"
                          Click="ToggleDetailsPane_Click"
                          ToolTipService.ToolTip="Mostrar/ocultar panel de detalles"/>

                    <!-- Más -->
                    <Button x:Name="BtnMore"
                    Grid.Column="5"
                    Content="⋯">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Explorar carpetas" Click="MenuExplore_Click"/>
                                <MenuFlyoutSeparator/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- ROW 1: Chips + sort -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="ChipPdf" Content="PDF" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipDocx" Content="DOCX" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipXlsx" Content="XLSX" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipImg" Content="IMG" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipUrl" Content="URL" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipRecent" Content="Recientes" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipBookmarks" Content="⭐ Bookmarks" Click="ChipFilter_Click"/>
                        <ToggleButton x:Name="ChipFolders" Content="Solo carpetas" Click="ChipFilter_Click"/>
                    </StackPanel>

                    <ComboBox x:Name="SortCombo"
                      Grid.Column="1"
                      Width="190"
                      PlaceholderText="Ordenar por"
                      SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Nombre (A–Z)" Tag="name_asc"/>
                        <ComboBoxItem Content="Nombre (Z–A)" Tag="name_desc"/>
                        <ComboBoxItem Content="Modificado (nuevo)" Tag="mod_desc"/>
                        <ComboBoxItem Content="Modificado (antiguo)" Tag="mod_asc"/>
                        <ComboBoxItem Content="Tamaño (mayor)" Tag="size_desc"/>
                        <ComboBoxItem Content="Tamaño (menor)" Tag="size_asc"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>
        <!-- BODY -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FoldersPaneCol" Width="320"/>
                <ColumnDefinition Width="*"/>
                <!-- NEW: Details col (colapsable) -->
                <ColumnDefinition x:Name="DetailsCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Folders -->
            <Border x:Name="FoldersPane"
        Grid.Column="0"
        CornerRadius="12"
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Carpetas" FontWeight="SemiBold"/>

                    <Grid Grid.Row="1">
                        <TreeView x:Name="FolderTree"
                      ItemInvoked="FolderTree_ItemInvoked"
                      Expanding="FolderTree_Expanding">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <StackPanel x:Name="EmptyTreeHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Opacity="0.65"
                        IsHitTestVisible="False">
                            <TextBlock Text="Sin árbol cargado" FontWeight="SemiBold"/>
                            <TextBlock Text="Pulsa “Actualizar” o “Sync” para cargar carpetas"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="220"/>
                        </StackPanel>
                    </Grid>

                    <!-- Botones abajo -->
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">
                            <Button Content="Actualizar" Click="BtnRefreshTree_Click"/>
                            <Button Content="Inicio (/)" Click="BtnGoRoot_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>


            <!-- CENTER: Results -->
            <Border Grid.Column="1"
        CornerRadius="12"
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumbs -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Ruta:" Opacity="0.7"/>
                        <TextBlock x:Name="BreadcrumbText" Text="/" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Header row: SOLO NOMBRE -->
                    <Grid Grid.Row="1" Padding="6" Opacity="0.85">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Nombre" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Results list -->
                    <Grid Grid.Row="2">
                        <ProgressRing x:Name="LoadingRing"
                          IsActive="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                        <ListView x:Name="ResultsList"
                      SelectionMode="Single"
                      SelectionChanged="ResultsList_SelectionChanged"
                      DoubleTapped="ResultsList_DoubleTapped"
                      RightTapped="ResultsList_RightTapped">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchResultRow">
                                    <Grid Padding="10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">

                                            <IconSourceElement IconSource="{x:Bind Icon,Mode=OneWay}"
                       Width="18"
                       Height="18"/>

                                            <TextBlock x:Name="NameText"
           DataContextChanged="NameText_DataContextChanged"
           FontWeight="SemiBold"
           TextTrimming="CharacterEllipsis"/>



                                        </StackPanel>


                                        <!-- ⭐ -->
                                        <Button Grid.Column="1"
                MinWidth="38"
                Content="{x:Bind StarGlyph, Mode=OneWay}"
                Tag="{x:Bind}"
                Click="BtnStar_Click"
                ToolTipService.ToolTip="Agregar / quitar bookmark"/>
                                    </Grid>
                                </DataTemplate>


                            </ListView.ItemTemplate>

                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Abrir" Click="CtxOpen_Click"/>
                                    <MenuFlyoutItem Text="Abrir en Dropbox Web" Click="CtxOpenWeb_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Copiar ruta" Click="CtxCopyPath_Click"/>
                                    <MenuFlyoutItem Text="Copiar link" Click="CtxCopyLink_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Renombrar…" Click="CtxRename_Click"/>
                                    <MenuFlyoutItem Text="Eliminar" Click="CtxDelete_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Agregar a bookmarks" Click="CtxBookmark_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <TextBlock x:Name="EmptyResultsHint"
                       Text="No hay resultados"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Paging -->
                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="⟨" Click="BtnPrevPage_Click"/>
                        <Button Grid.Column="1" Content="⟩" Click="BtnNextPage_Click"/>

                        <TextBlock Grid.Column="3"
                       x:Name="PageInfoText"
                       Text="Página 1"
                       VerticalAlignment="Center"
                       Opacity="0.75"/>

                        <ComboBox Grid.Column="4"
                      x:Name="PageSizeCombo"
                      Width="110"
                      PlaceholderText="Tamaño"
                      SelectionChanged="PageSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="25" Tag="25"/>
                            <ComboBoxItem Content="50" Tag="50"/>
                            <ComboBoxItem Content="100" Tag="100"/>
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>



            <!-- RIGHT: Details panel (COLAPSABLE) -->
            <Border x:Name="DetailsPane"
                    Grid.Column="2"
                    CornerRadius="12"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="Collapsed">

                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detalles" FontWeight="SemiBold"/>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="DetailsTitle" Text="Selecciona un elemento" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailsPath" Text="—" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border CornerRadius="10" Padding="10"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Metadata" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailsMeta" Text="—" Opacity="0.75" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="10" Padding="10"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Notion relacionado" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailsNotion" Text="—" Opacity="0.75" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="DetailsHint"
                                   Text="Acciones disponibles"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Abrir Web"
                                Click="CtxOpen_Click"/>

                        <Button Grid.Column="2"
                                Content="Abrir Ubicacion"
                                Click="BtnDetailsLink_Click"/>

                        <Button Grid.Column="3"
                                Content="⋯">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Info" Click="BtnDetailsInfo_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Renombrar…" Click="CtxRename_Click"/>
                                    <MenuFlyoutItem Text="Eliminar" Click="CtxDelete_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Recompute metadata" Click="MenuRecompute_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Estado: Dropbox (API)"
                       Opacity="0.7"/>

            <TextBlock x:Name="ModeText"
                       Grid.Column="1"
                       Text="Modo: Buscar"
                       Margin="0,0,12,0"
                       Opacity="0.7"/>

            <TextBlock x:Name="CountText"
                       Grid.Column="2"
                       Text="0 resultados"
                       Opacity="0.7"/>
        </Grid>
    </Grid>
</Page>
