<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models.Weblab"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:searchModels="using:Anfeta.UI.Models.Search"
    Loaded="SearchView_Loaded"
    NavigationCacheMode="Enabled">

    <Grid
        x:Name="RootLayout"
        AllowDrop="True"
        Background="#151515"
        DragEnter="ResultsDropSurface_DragEnter"
        DragLeave="ResultsDropSurface_DragLeave"
        DragOver="ResultsDropSurface_DragOver"
        Drop="ResultsDropSurface_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <!--  Row 0 TopBar  -->
            <RowDefinition Height="0" />
            <!--  Row 1 reservado para compatibilidad; sin contenido fijo  -->
            <RowDefinition Height="62" />
            <!--  Row 2 Chips + configuración en dos filas  -->
            <RowDefinition Height="*" />
            <!--  Row 3 Body  -->
            <RowDefinition Height="34" />
            <!--  Row 4 StatusBar  -->
        </Grid.RowDefinitions>

        <!--
            ═══════════════════════════════════════════════════════
            ROW 0 · TOP BAR
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="0"
            Padding="8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">

            <Grid.ColumnDefinitions>
                <!--  0 · Buscador flexible  -->
                <ColumnDefinition Width="*" />

                <!--  1 · Guardar búsqueda  -->
                <ColumnDefinition Width="Auto" />

                <!--  2 · Micrófono  -->
                <ColumnDefinition Width="Auto" />

                <!--  3 · Ayuda  -->
                <ColumnDefinition Width="Auto" />

                <!--  4 · Separador  -->
                <ColumnDefinition Width="Auto" />

                <!--  5 · Filtros  -->
                <ColumnDefinition Width="Auto" />

                <!--  6 · Detalles  -->
                <ColumnDefinition Width="Auto" />

                <!--  7 · Actualizar Notion oculto  -->
                <ColumnDefinition Width="Auto" />

                <!--  8 · Calendario de actividades  -->
                <ColumnDefinition Width="Auto" />

                <!--  9 · Mensajes  -->
                <ColumnDefinition Width="Auto" />

                <!--  10 · Calendario de recordatorios  -->
                <ColumnDefinition Width="Auto" />

                <!--  11 · Pantallazo  -->
                <ColumnDefinition Width="Auto" />

                <!--  12 · Vistas de Notion  -->
                <ColumnDefinition Width="Auto" />

                <!--  13 · Menú adicional  -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Búsqueda  -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                GotFocus="SearchBox_GotFocus"
                PlaceholderText="Buscar en archivos o Notion... (AND / OR / NOT, ext:pdf)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                SuggestionChosen="SearchBox_SuggestionChosen"
                Tapped="SearchBox_Tapped"
                TextChanged="SearchBox_TextChanged">

                <FlyoutBase.AttachedFlyout>
                    <Flyout
                        x:Name="QuickCommandsInputFlyout"
                        Closed="QuickCommandsInputFlyout_Closed"
                        Opened="QuickCommandsInputFlyout_Opened"
                        Placement="BottomEdgeAlignedLeft"
                        ShouldConstrainToRootBounds="False"
                        ShowMode="Transient">

                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="760" />
                                <Setter Property="MaxWidth" Value="1600" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <Border
                            x:Name="QuickCommandsInputHost"
                            Width="760"
                            MaxHeight="360"
                            Padding="10"
                            Background="#1F1F1F"
                            BorderBrush="#3B3B3B"
                            BorderThickness="1"
                            CornerRadius="12">

                            <ScrollViewer
                                MaxHeight="330"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <StackPanel Spacing="9">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            x:Name="QuickPredictiveHeaderText"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Sugerencias predictivas" />

                                        <GridView
                                            x:Name="QuickPredictiveFlyoutList"
                                            MaxHeight="165"
                                            IsItemClickEnabled="True"
                                            ItemClick="QuickPredictiveFlyoutList_ItemClick"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,6,6" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="152"
                                                        Padding="8,5"
                                                        Background="#243242"
                                                        BorderBrush="#3E5268"
                                                        BorderThickness="1"
                                                        CornerRadius="10">

                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <FontIcon
                                                                    FontSize="9"
                                                                    Foreground="#D5E8FF"
                                                                    Glyph="{Binding IconGlyph}" />

                                                                <TextBlock
                                                                    MaxWidth="112"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe UI"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="{Binding Title}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                MaxWidth="124"
                                                                Margin="15,0,0,0"
                                                                FontFamily="Segoe UI"
                                                                FontSize="9"
                                                                Foreground="#AFC2D6"
                                                                Text="{Binding Subtitle}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            x:Name="QuickSavedHeaderText"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Búsquedas guardadas" />

                                        <GridView
                                            x:Name="QuickCommandsFlyoutList"
                                            MaxHeight="105"
                                            IsItemClickEnabled="True"
                                            ItemClick="QuickCommandsFlyoutList_ItemClick"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,6,6" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="150"
                                                        Padding="8,5"
                                                        Background="#292929"
                                                        BorderBrush="#404040"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        RightTapped="QuickCommandChip_RightTapped">

                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <FontIcon
                                                                FontSize="9"
                                                                Foreground="#D0D0D0"
                                                                Glyph="&#xE8A5;" />

                                                            <TextBlock
                                                                MaxWidth="113"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe UI"
                                                                FontSize="11"
                                                                Foreground="White"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="QuickFlyoutHintText"
                                        FontFamily="Segoe UI"
                                        FontSize="10"
                                        Foreground="#9E9E9E"
                                        Text="Escribe zrevision, zclientes, zdominios, zproyectos, zpagar o zcorreos · Clic derecho en guardadas para editar" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </AutoSuggestBox>

            <!--  Guardar búsqueda como chip rápido  -->
            <Button
                x:Name="BtnSaveCurrentSearchTop"
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Background="#2F2F2F"
                BorderBrush="#3A3A3A"
                Click="BtnSaveSearch_Click"
                CornerRadius="7"
                Foreground="White"
                ToolTipService.ToolTip="Guardar búsqueda como chip rápido">
                <FontIcon
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE74E;" />
            </Button>

            <!--  Micrófono  -->
            <Grid
                Grid.Column="2"
                Width="70"
                Height="32"
                VerticalAlignment="Center">

                <muxc:SplitButton
                    x:Name="VoiceSplit"
                    Height="32"
                    Padding="6,0"
                    HorizontalContentAlignment="Center"
                    Click="VoiceSplit_Click"
                    CornerRadius="7"
                    ToolTipService.ToolTip="Voz">

                    <muxc:SplitButton.Content>
                        <SymbolIcon Symbol="Microphone" />
                    </muxc:SplitButton.Content>

                    <muxc:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="VoiceMenu_Listen_Click" Text="Escuchar ahora" />
                            <MenuFlyoutItem Click="VoiceMenu_Config_Click" Text="Configurar comandos de voz..." />
                        </MenuFlyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>

                <ProgressRing
                    x:Name="VoiceRing"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Ayuda  -->
            <Button
                x:Name="BtnHelp"
                Grid.Column="3"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Click="MenuHelp_Click"
                Content="?"
                CornerRadius="6"
                FontWeight="SemiBold"
                ToolTipService.ToolTip="Ayuda de comandos de búsqueda" />

            <!--  Separador  -->
            <Border
                Grid.Column="4"
                Width="1"
                Height="18"
                VerticalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Toggle Filtros  -->
            <ToggleButton
                x:Name="ToggleFoldersPane"
                Grid.Column="5"
                MinWidth="70"
                Height="32"
                Padding="12,0"
                VerticalAlignment="Center"
                Click="ToggleFoldersPane_Click"
                Content="Filtros"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel izquierdo" />

            <!--  Toggle Detalles  -->
            <ToggleButton
                x:Name="ToggleDetailsPane"
                Grid.Column="6"
                MinWidth="76"
                Height="32"
                Padding="12,0"
                VerticalAlignment="Center"
                Click="ToggleDetailsPane_Click"
                Content="Detalles"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel derecho" />

            <!--  Actualizar Notion  -->
            <Button
                x:Name="BtnRefreshNotion"
                Grid.Column="7"
                Height="32"
                Padding="12,0"
                VerticalAlignment="Center"
                Background="#FFB020"
                Click="BtnRefreshNotion_Click"
                CornerRadius="8"
                Foreground="Black"
                Visibility="Collapsed">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                    <TextBlock x:Name="BtnRefreshNotionText" Text="Notion" />
                </StackPanel>
            </Button>


            <!--  Calendario comparativo de Revisiones  -->
            <ToggleButton
                x:Name="ToggleCalendarView"
                Grid.Column="8"
                Width="38"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Click="ToggleCalendarView_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="Abrir calendario de Revisiones">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE787;" />
            </ToggleButton>

            <!--  Vistas rápidas de Notion  -->
            <Button
                x:Name="BtnNotionViews"
                Grid.Column="12"
                MinWidth="86"
                Height="32"
                Padding="10,0"
                VerticalAlignment="Center"
                CornerRadius="6"
                ToolTipService.ToolTip="Abrir vistas frecuentes de Notion">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        FontSize="13"
                        Glyph="&#xE8A5;" />
                    <TextBlock Text="Vistas" />
                    <FontIcon
                        FontSize="10"
                        Glyph="&#xE70D;" />
                </StackPanel>

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutSubItem Text="Revisiones">
                            <MenuFlyoutItem
                                Click="OpenSavedNotionView_Click"
                                Tag="https://app.notion.com/p/2eeabd7d91b781348ed5c537ec14962e?v=3a5abd7d91b78097ac57000cd9017ac3&amp;source=copy_link"
                                Text="Seguimiento HOY Proyectos — Tabla" />
                            <MenuFlyoutItem
                                Click="OpenSavedNotionView_Click"
                                Tag="https://app.notion.com/p/2eeabd7d91b781348ed5c537ec14962e?v=3a1abd7d91b7809d9351000c725547e4&amp;source=copy_link"
                                Text="Seguimiento HOY Proyectos — Tablero" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!--  Mensajes / recordatorios  -->
            <ToggleButton
                x:Name="ToggleMessagesView"
                Grid.Column="9"
                Width="44"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Click="ToggleMessagesView_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="Abrir mensajes y recordatorios">
                <Grid>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE8BD;" />

                    <Border
                        x:Name="MessagesUnreadBadge"
                        MinWidth="16"
                        Height="16"
                        Margin="0,-8,-18,0"
                        Padding="4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E5484D"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="MessagesUnreadBadgeText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="0" />
                    </Border>
                </Grid>
            </ToggleButton>

            <!--  Calendario exclusivo de recordatorios  -->
            <ToggleButton
                x:Name="ToggleRemindersCalendarView"
                Grid.Column="10"
                Width="44"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Click="ToggleRemindersCalendarView_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="Abrir calendario de recordatorios">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Text="🔔" />

                    <Border
                        x:Name="RemindersCalendarBadge"
                        MinWidth="16"
                        Height="16"
                        Margin="0,-8,-18,0"
                        Padding="4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#A855F7"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="RemindersCalendarBadgeText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="0" />
                    </Border>
                </Grid>
            </ToggleButton>

            <!--  Pantallazo de resultados  -->
            <Button
                x:Name="BtnCaptureResults"
                Grid.Column="11"
                Width="38"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Click="BtnCaptureResults_Click"
                CornerRadius="6"
                ToolTipService.ToolTip="Capturar los resultados visibles y subirlos a Notion">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE722;" />
            </Button>

            <!--  Menú ⋯  -->
            <Button
                Grid.Column="13"
                Width="36"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Content="⋯"
                CornerRadius="6">

                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="NewSavedFilter_Click" Text="Nuevo filtro" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ImportFiltersCsv_Click" Text="Importar CSV" />

                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="BtnCheckNotionDeleted_Click" Text="Revisar páginas eliminadas" />
                        <MenuFlyoutItem Click="BtnFullResyncNotion_Click" Text="Resync completo Notion" />

                        <MenuFlyoutSeparator />

                        <MenuFlyoutSubItem Text="Color de fondo">
                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="gray"
                                Text="Gris oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="blue"
                                Text="Azul noche" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="purple"
                                Text="Morado oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="green"
                                Text="Verde oscuro" />
                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="navy"
                                Text="Azul profundo" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="midnight"
                                Text="Azul medianoche" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="violet"
                                Text="Violeta oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="wine"
                                Text="Vino oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="slate"
                                Text="Pizarra oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="coffee"
                                Text="Café oscuro" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!--  SortCombo oculto: se conserva solo para compatibilidad con el code-behind.  -->
            <ComboBox
                x:Name="SortCombo"
                SelectionChanged="SortCombo_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem Content="Nombre (A–Z)" Tag="name_asc" />
                <ComboBoxItem Content="Nombre (Z–A)" Tag="name_desc" />
                <ComboBoxItem Content="Modificado (nuevo)" Tag="mod_desc" />
                <ComboBoxItem Content="Modificado (antiguo)" Tag="mod_asc" />
            </ComboBox>
        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 1 · RESERVADO
            Las búsquedas guardadas ahora se muestran como panel temporal
            al interactuar con el input.
            ═══════════════════════════════════════════════════════
        -->
        <!--
            ═══════════════════════════════════════════════════════
            ROW 2 · CHIP STRIP
            Chips visibles. FilterTypeCombo eliminado (redundante).
            Los chips ocultos (Visibility=Collapsed) se conservan
            como fallback para el code-behind si los necesita.
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="2"
            Padding="8,3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            RowSpacing="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <!-- Primera fila: chips. Se desplaza horizontalmente si no caben. -->
            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">

                    <!--  Favoritos se queda  -->
                    <ToggleButton
                    x:Name="ChipBookmarks"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="⭐ Favoritos"
                    CornerRadius="11" />

                    <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Filtro global por origen  -->
                    <ToggleButton
                    x:Name="ChipSourceAll"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Todo"
                    CornerRadius="11"
                    Tag="all" />

                    <ToggleButton
                    x:Name="ChipSourceNotion"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Notion"
                    CornerRadius="11"
                    Tag="notion" />

                    <ToggleButton
                    x:Name="ChipSourceDropbox"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Dropbox"
                    CornerRadius="11"
                    Tag="dropbox" />

                    <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  Filtros por base Notion  -->
                    <ToggleButton
                    x:Name="ChipBaseAll"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="Todas bases"
                    CornerRadius="11"
                    Tag="" />

                    <ToggleButton
                    x:Name="ChipBaseRevisiones"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="Revisiones"
                    CornerRadius="11"
                    Tag="Revisiones" />

                    <ToggleButton
                    x:Name="ChipBaseClientes"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zClientes"
                    CornerRadius="11"
                    Tag="Clientes" />

                    <ToggleButton
                    x:Name="ChipBaseDominios"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zDominios"
                    CornerRadius="11"
                    Tag="Dominios" />

                    <ToggleButton
                    x:Name="ChipBaseProgramas"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zProyectos"
                    CornerRadius="11"
                    Tag="Programas y proyectos" />

                    <ToggleButton
                    x:Name="ChipBaseCobrar"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zPAGAR - zCOBRAR"
                    CornerRadius="11"
                    Tag="Cobrar y pagar" />

                    <ToggleButton
                    x:Name="ChipBaseCorreos"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zCorreos"
                    CornerRadius="11"
                    Tag="Correos Contraseñas" />
                </StackPanel>
            </ScrollViewer>

            <!-- Segunda fila: configuración visual y filtros auxiliares. -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
