<Page
    x:Class="Anfeta.UI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anfeta.UI.Models.Weblab"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:searchModels="using:Anfeta.UI.Models.Search"
    Loaded="SearchView_Loaded"
    NavigationCacheMode="Enabled">

    <Grid
        x:Name="RootLayout"
        AllowDrop="True"
        Background="#151515"
        DragEnter="ResultsDropSurface_DragEnter"
        DragLeave="ResultsDropSurface_DragLeave"
        DragOver="ResultsDropSurface_DragOver"
        Drop="ResultsDropSurface_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <!--  Row 0 TopBar  -->
            <RowDefinition Height="0" />
            <!--  Row 1 reservado para compatibilidad; sin contenido fijo  -->
            <RowDefinition Height="32" />
            <!--  Row 2 ChipStrip  -->
            <RowDefinition Height="*" />
            <!--  Row 3 Body  -->
            <RowDefinition Height="22" />
            <!--  Row 4 StatusBar  -->
        </Grid.RowDefinitions>

        <!--
            ═══════════════════════════════════════════════════════
            ROW 0 · TOP BAR
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="0"
            Padding="8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  SearchBox  -->
                <ColumnDefinition Width="Auto" />
                <!--  Guardar búsqueda  -->
                <ColumnDefinition Width="Auto" />
                <!--  Micrófono  -->
                <ColumnDefinition Width="Auto" />
                <!--  Ayuda  -->
                <ColumnDefinition Width="Auto" />
                <!--  Separador  -->
                <ColumnDefinition Width="Auto" />
                <!--  Filtros  -->
                <ColumnDefinition Width="Auto" />
                <!--  Detalles  -->
                <ColumnDefinition Width="Auto" />
                <!--  Actualización Notion automática: botón oculto por compatibilidad con código existente  -->
                <ColumnDefinition Width="Auto" />
                <!--  Última sync  -->
                <ColumnDefinition Width="Auto" />
                <!--  Menú  -->
            </Grid.ColumnDefinitions>

            <!--  Búsqueda  -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                GotFocus="SearchBox_GotFocus"
                PlaceholderText="Buscar en archivos o Notion... (AND / OR / NOT, ext:pdf)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                Tapped="SearchBox_Tapped"
                TextChanged="SearchBox_TextChanged">

                <FlyoutBase.AttachedFlyout>
                    <Flyout
                        x:Name="QuickCommandsInputFlyout"
                        Closed="QuickCommandsInputFlyout_Closed"
                        Opened="QuickCommandsInputFlyout_Opened"
                        Placement="BottomEdgeAlignedLeft"
                        ShouldConstrainToRootBounds="False"
                        ShowMode="Transient">

                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="760" />
                                <Setter Property="MaxWidth" Value="1600" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <Border
                            x:Name="QuickCommandsInputHost"
                            Width="760"
                            MaxHeight="360"
                            Padding="10"
                            Background="#1F1F1F"
                            BorderBrush="#3B3B3B"
                            BorderThickness="1"
                            CornerRadius="12">

                            <ScrollViewer
                                MaxHeight="330"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <StackPanel Spacing="9">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            x:Name="QuickPredictiveHeaderText"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Sugerencias predictivas" />

                                        <GridView
                                            x:Name="QuickPredictiveFlyoutList"
                                            MaxHeight="165"
                                            IsItemClickEnabled="True"
                                            ItemClick="QuickPredictiveFlyoutList_ItemClick"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,6,6" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="152"
                                                        Padding="8,5"
                                                        Background="#243242"
                                                        BorderBrush="#3E5268"
                                                        BorderThickness="1"
                                                        CornerRadius="10">

                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <FontIcon
                                                                    FontSize="9"
                                                                    Foreground="#D5E8FF"
                                                                    Glyph="{Binding IconGlyph}" />

                                                                <TextBlock
                                                                    MaxWidth="112"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Segoe UI"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="{Binding Title}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                MaxWidth="124"
                                                                Margin="15,0,0,0"
                                                                FontFamily="Segoe UI"
                                                                FontSize="9"
                                                                Foreground="#AFC2D6"
                                                                Text="{Binding Subtitle}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            x:Name="QuickSavedHeaderText"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Búsquedas guardadas" />

                                        <GridView
                                            x:Name="QuickCommandsFlyoutList"
                                            MaxHeight="105"
                                            IsItemClickEnabled="True"
                                            ItemClick="QuickCommandsFlyoutList_ItemClick"
                                            SelectionMode="None">

                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,6,6" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="IsTabStop" Value="False" />
                                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                                </Style>
                                            </GridView.ItemContainerStyle>

                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="150"
                                                        Padding="8,5"
                                                        Background="#292929"
                                                        BorderBrush="#404040"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        RightTapped="QuickCommandChip_RightTapped">

                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <FontIcon
                                                                FontSize="9"
                                                                Foreground="#D0D0D0"
                                                                Glyph="&#xE8A5;" />

                                                            <TextBlock
                                                                MaxWidth="113"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe UI"
                                                                FontSize="11"
                                                                Foreground="White"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="QuickFlyoutHintText"
                                        FontFamily="Segoe UI"
                                        FontSize="10"
                                        Foreground="#9E9E9E"
                                        Text="Escribe zrevision, zclientes, zdominios, zproyectos, zpagar o zcorreos · Clic derecho en guardadas para editar" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </AutoSuggestBox>

            <!--  Guardar búsqueda como chip rápido  -->
            <Button
                x:Name="BtnSaveCurrentSearchTop"
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Center"
                Background="#2F2F2F"
                BorderBrush="#3A3A3A"
                Click="BtnSaveSearch_Click"
                CornerRadius="7"
                Foreground="White"
                ToolTipService.ToolTip="Guardar búsqueda como chip rápido">
                <FontIcon
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE74E;" />
            </Button>

            <!--  Micrófono  -->
            <Grid
                Grid.Column="2"
                Width="70"
                Height="32"
                VerticalAlignment="Center">

                <muxc:SplitButton
                    x:Name="VoiceSplit"
                    Height="32"
                    Padding="6,0"
                    HorizontalContentAlignment="Center"
                    Click="VoiceSplit_Click"
                    CornerRadius="7"
                    ToolTipService.ToolTip="Voz">

                    <muxc:SplitButton.Content>
                        <SymbolIcon Symbol="Microphone" />
                    </muxc:SplitButton.Content>

                    <muxc:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="VoiceMenu_Listen_Click" Text="Escuchar ahora" />
                            <MenuFlyoutItem Click="VoiceMenu_Config_Click" Text="Configurar comandos de voz..." />
                        </MenuFlyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>

                <ProgressRing
                    x:Name="VoiceRing"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Ayuda  -->
            <Button
                x:Name="BtnHelp"
                Grid.Column="3"
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Click="MenuHelp_Click"
                Content="?"
                CornerRadius="6"
                FontWeight="SemiBold"
                ToolTipService.ToolTip="Ayuda de comandos de búsqueda" />

            <!--  Separador  -->
            <Border
                Grid.Column="4"
                Width="1"
                Height="18"
                VerticalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Toggle Filtros  -->
            <ToggleButton
                x:Name="ToggleFoldersPane"
                Grid.Column="5"
                Height="32"
                VerticalAlignment="Center"
                Click="ToggleFoldersPane_Click"
                Content="Filtros"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel izquierdo" />

            <!--  Toggle Detalles  -->
            <ToggleButton
                x:Name="ToggleDetailsPane"
                Grid.Column="6"
                Height="32"
                VerticalAlignment="Center"
                Click="ToggleDetailsPane_Click"
                Content="Detalles"
                CornerRadius="6"
                IsChecked="True"
                ToolTipService.ToolTip="Mostrar/ocultar panel derecho" />

            <!--  Actualizar Notion  -->
            <Button
                x:Name="BtnRefreshNotion"
                Grid.Column="7"
                Height="32"
                Padding="12,0"
                VerticalAlignment="Center"
                Background="#FFB020"
                Click="BtnRefreshNotion_Click"
                CornerRadius="8"
                Foreground="Black"
                Visibility="Collapsed">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                    <TextBlock x:Name="BtnRefreshNotionText" Text="Notion" />
                </StackPanel>
            </Button>

            <!--  Última sincronización Notion  -->
            <TextBlock
                x:Name="NotionSyncInfoText"
                Grid.Column="8"
                MaxWidth="220"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#AFAFAF"
                Text=""
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Text, ElementName=NotionSyncInfoText}" />

            <!--  Menú ⋯  -->
            <Button
                Grid.Column="9"
                Width="36"
                Height="32"
                VerticalAlignment="Center"
                Content="⋯"
                CornerRadius="6">

                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="NewSavedFilter_Click" Text="Nuevo filtro" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ImportFiltersCsv_Click" Text="Importar CSV" />

                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="BtnCheckNotionDeleted_Click" Text="Revisar páginas eliminadas" />
                        <MenuFlyoutItem Click="BtnFullResyncNotion_Click" Text="Resync completo Notion" />

                        <MenuFlyoutSeparator />

                        <MenuFlyoutSubItem Text="Color de fondo">
                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="gray"
                                Text="Gris oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="blue"
                                Text="Azul noche" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="purple"
                                Text="Morado oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="green"
                                Text="Verde oscuro" />
                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="navy"
                                Text="Azul profundo" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="midnight"
                                Text="Azul medianoche" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="violet"
                                Text="Violeta oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="wine"
                                Text="Vino oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="slate"
                                Text="Pizarra oscuro" />

                            <MenuFlyoutItem
                                Click="ThemePreset_Click"
                                Tag="coffee"
                                Text="Café oscuro" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!--  SortCombo oculto: se conserva solo para compatibilidad con el code-behind.  -->
            <ComboBox
                x:Name="SortCombo"
                SelectionChanged="SortCombo_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem Content="Nombre (A–Z)" Tag="name_asc" />
                <ComboBoxItem Content="Nombre (Z–A)" Tag="name_desc" />
                <ComboBoxItem Content="Modificado (nuevo)" Tag="mod_desc" />
                <ComboBoxItem Content="Modificado (antiguo)" Tag="mod_asc" />
            </ComboBox>
        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 1 · RESERVADO
            Las búsquedas guardadas ahora se muestran como panel temporal
            al interactuar con el input.
            ═══════════════════════════════════════════════════════
        -->
        <!--
            ═══════════════════════════════════════════════════════
            ROW 2 · CHIP STRIP
            Chips visibles. FilterTypeCombo eliminado (redundante).
            Los chips ocultos (Visibility=Collapsed) se conservan
            como fallback para el code-behind si los necesita.
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="2"
            Padding="8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Chips visibles en una WrapPanel horizontal  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <!--  Favoritos se queda  -->
                <ToggleButton
                    x:Name="ChipBookmarks"
                    Height="22"
                    Padding="10,0"
                    Click="ChipFilter_Click"
                    Content="⭐ Favoritos"
                    CornerRadius="11" />

                <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Filtro global por origen  -->
                <ToggleButton
                    x:Name="ChipSourceAll"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Todo"
                    CornerRadius="11"
                    Tag="all" />

                <ToggleButton
                    x:Name="ChipSourceNotion"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Notion"
                    CornerRadius="11"
                    Tag="notion" />

                <ToggleButton
                    x:Name="ChipSourceDropbox"
                    Height="22"
                    Padding="10,0"
                    Click="ChipSourceFilter_Click"
                    Content="Dropbox"
                    CornerRadius="11"
                    Tag="dropbox" />

                <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Filtros por base Notion  -->
                <ToggleButton
                    x:Name="ChipBaseAll"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="Todas bases"
                    CornerRadius="11"
                    Tag="" />

                <ToggleButton
                    x:Name="ChipBaseRevisiones"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="Revisiones"
                    CornerRadius="11"
                    Tag="Revisiones" />

                <ToggleButton
                    x:Name="ChipBaseClientes"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zClientes"
                    CornerRadius="11"
                    Tag="Clientes" />

                <ToggleButton
                    x:Name="ChipBaseDominios"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zDominios"
                    CornerRadius="11"
                    Tag="Dominios" />

                <ToggleButton
                    x:Name="ChipBaseProgramas"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zProyectos"
                    CornerRadius="11"
                    Tag="Programas y proyectos" />

                <ToggleButton
                    x:Name="ChipBaseCobrar"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zPAGAR - zCOBRAR"
                    CornerRadius="11"
                    Tag="Cobrar y pagar" />

                <ToggleButton
                    x:Name="ChipBaseCorreos"
                    Height="22"
                    Padding="10,0"
                    Click="ChipBaseFilter_Click"
                    Content="zCorreos"
                    CornerRadius="11"
                    Tag="Correos Contraseñas" />
            </StackPanel>

            <!-- Configuración rápida del módulo -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.65"
                    Text="Tag inicial" />

                <ComboBox
                    x:Name="DefaultTagCombo"
                    Width="150"
                    Height="26"
                    FontSize="11"
                    SelectionChanged="DefaultTagCombo_SelectionChanged">
                    <ComboBoxItem Content="Ninguno" Tag="" />
                    <ComboBoxItem Content="prtuzREVISION" Tag="prtuzREVISION" />
                    <ComboBoxItem Content="zclientes" Tag="zclientes" />
                    <ComboBoxItem Content="zdominios" Tag="zdominios" />
                    <ComboBoxItem Content="zproyectos" Tag="zproyectos" />
                    <ComboBoxItem Content="zpagar" Tag="zpagar" />
                    <ComboBoxItem Content="zcorreos" Tag="zcorreos" />
                    <ComboBoxItem Content="Personalizado" Tag="__custom__" />
                </ComboBox>

                <TextBox
                    x:Name="CustomDefaultTagBox"
                    Width="125"
                    Height="26"
                    FontSize="11"
                    PlaceholderText="Tag personalizado"
                    TextChanged="CustomDefaultTagBox_TextChanged"
                    Visibility="Collapsed" />

                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.65"
                    Text="Texto" />

                <ComboBox
                    x:Name="TextScaleCombo"
                    Width="92"
                    Height="26"
                    FontSize="11"
                    SelectionChanged="TextScaleCombo_SelectionChanged">
                    <ComboBoxItem Content="Pequeño" Tag="small" />
                    <ComboBoxItem Content="Normal" Tag="normal" />
                    <ComboBoxItem Content="Grande" Tag="large" />
                </ComboBox>
            </StackPanel>
            <StackPanel Visibility="Collapsed">
                <ToggleButton x:Name="ChipPdf" />
                <ToggleButton x:Name="ChipDocx" />
                <ToggleButton x:Name="ChipXlsx" />
                <ToggleButton x:Name="ChipImg" />
                <ToggleButton x:Name="ChipUrl" />
                <ToggleButton x:Name="ChipRecent" />
                <ToggleButton x:Name="ChipFolders" />
            </StackPanel>

            <!--
                FilterTypeCombo se conserva con Visibility=Collapsed
                para que el code-behind que lo referencia no rompa.
                Ya no se muestra porque los chips lo reemplazan.
            -->
            <ComboBox
                x:Name="FilterTypeCombo"
                SelectionChanged="FilterTypeCombo_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem Content="Todo" Tag="all" />
                <ComboBoxItem Content="PDF" Tag="pdf" />
                <ComboBoxItem Content="DOCX" Tag="docx" />
                <ComboBoxItem Content="XLSX" Tag="xlsx" />
                <ComboBoxItem Content="IMG" Tag="img" />
                <ComboBoxItem Content="URL" Tag="url" />
                <ComboBoxItem Content="Recientes" Tag="recent" />
                <ComboBoxItem Content="Favoritos" Tag="bookmarks" />
                <ComboBoxItem Content="Solo carpetas" Tag="folders" />
            </ComboBox>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 3 · BODY   Left | div | Center | div | Right
            ═══════════════════════════════════════════════════════
        -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FoldersPaneCol" Width="220" />
                <ColumnDefinition Width="1" />
                <!--  div izq-centro  -->
                <ColumnDefinition Width="*" />
                <!--  Centro  -->
                <ColumnDefinition Width="1" />
                <!--  div centro-der  -->
                <ColumnDefinition x:Name="DetailsCol" Width="210" />
            </Grid.ColumnDefinitions>

            <!--  Divisores verticales  -->
            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />


            <!--  ── LEFT PANEL ───────────────────────────────────  -->
            <Border
                x:Name="FoldersPane"
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  FILTROS GUARDADOS  -->
                        <Grid x:Name="SavedFiltersExpander">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <Grid
                                Grid.Row="0"
                                Height="30"
                                Padding="10,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="FILTROS GUARDADOS" />
                                <Button
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NewSavedFilter_Click"
                                    ToolTipService.ToolTip="Nuevo filtro guardado">
                                    <Viewbox
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform">
                                        <SymbolIcon Symbol="Add" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!--  Lista — MaxHeight limita a ~7 items, el resto con scroll  -->
                            <ListView
                                x:Name="SavedFiltersList"
                                Grid.Row="1"
                                MaxHeight="200"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="SavedFiltersList_ItemClick"
                                ItemsSource="{x:Bind _savedFilters, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="MinHeight" Value="22" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="searchModels:SavedSearchFilter">
                                        <Grid
                                            MinHeight="28"
                                            HorizontalAlignment="Stretch"
                                            RightTapped="SavedFilter_RightTapped">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!--  Hint vacío  -->
                            <TextBlock
                                x:Name="SavedFiltersEmptyHint"
                                Grid.Row="2"
                                Margin="10,6,0,8"
                                FontSize="11"
                                Opacity="0.5"
                                Text="Aún no hay filtros guardados"
                                Visibility="Collapsed" />
                        </Grid>

                        <!--  MÁS OPCIONES  -->
                        <muxc:Expander
                            x:Name="MoreOptionsExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <muxc:Expander.Header>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Opacity="0.55"
                                    Text="MÁS OPCIONES" />
                            </muxc:Expander.Header>

                            <StackPanel>

                                <!--  CARPETAS  -->
                                <muxc:Expander
                                    x:Name="FoldersTreeExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Height="30"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                        </Grid>
                                        <TreeView
                                            x:Name="FolderTree"
                                            Expanding="FolderTree_Expanding"
                                            ItemInvoked="FolderTree_ItemInvoked">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                        <StackPanel
                                            x:Name="EmptyTreeHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Opacity="0.55"
                                            Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Sin árbol cargado" />
                                            <TextBlock
                                                MaxWidth="180"
                                                FontSize="11"
                                                Text="Pulsa &quot;Actualizar&quot; para cargar carpetas"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  COMANDOS GUARDADOS  -->
                                <muxc:Expander
                                    x:Name="CommandsExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Comandos" />
                                            <Button
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="BtnQuickSaveCommand_Click"
                                                ToolTipService.ToolTip="Guardar búsqueda actual como comando">
                                                <Viewbox
                                                    Width="12"
                                                    Height="12"
                                                    Stretch="Uniform">
                                                    <SymbolIcon Symbol="Add" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </muxc:Expander.Header>
                                    <StackPanel>
                                        <ListView
                                            x:Name="CommandsSidebarList"
                                            MaxHeight="180"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            IsItemClickEnabled="True"
                                            ItemClick="CommandsSidebarList_ItemClick"
                                            SelectionChanged="CommandsSidebarList_SelectionChanged"
                                            SelectionMode="Single">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Setter Property="MinHeight" Value="32" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="32" RightTapped="CommandRow_RightTapped">
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                MaxLines="1"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                MaxLines="1"
                                                                Opacity="0.55"
                                                                Text="{Binding Query}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="CommandsSidebarEmptyHint"
                                            Margin="10,4,0,6"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="Aún no hay comandos" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!--  CARPETAS EXCLUIDAS  -->
                                <muxc:Expander
                                    x:Name="ExcludedExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Carpetas excluidas" />
                                    </muxc:Expander.Header>
                                    <StackPanel Padding="8" Spacing="6">
                                        <Grid ColumnSpacing="6" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnRefreshTree_Click"
                                                Content="Actualizar"
                                                CornerRadius="6"
                                                FontSize="9" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnGoRoot_Click"
                                                Content="Inicio (/)"
                                                CornerRadius="6"
                                                FontSize="10" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnAddExcludedFolder_Click"
                                                Content="Excluir carpeta..."
                                                CornerRadius="6"
                                                FontSize="13" />
                                        </Grid>
                                        <ListView
                                            x:Name="ExcludedFoldersList"
                                            MaxHeight="100"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="28" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Opacity="0.8"
                                                            Text="{Binding}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="BtnRemoveExcludedFolder_Click"
                                                            Tag="{Binding}"
                                                            ToolTipService.ToolTip="Quitar exclusión">
                                                            <Viewbox
                                                                Width="10"
                                                                Height="10"
                                                                Stretch="Uniform">
                                                                <SymbolIcon Symbol="Cancel" />
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock
                                            x:Name="ExcludedHint"
                                            FontSize="11"
                                            Opacity="0.5"
                                            Text="No hay carpetas excluidas" />
                                    </StackPanel>
                                </muxc:Expander>

                            </StackPanel>
                        </muxc:Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── CENTER PANEL ──────────────────────────────────  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <!--  Cabecera: breadcrumb + voz  -->
                    <RowDefinition Height="28" />
                    <!--  Encabezado de columnas estilo Everything  -->
                    <RowDefinition Height="*" />
                    <!--  Lista de resultados  -->
                    <RowDefinition Height="30" />
                    <!--  Paginación  -->
                </Grid.RowDefinitions>

                <!--  Cabecera: breadcrumb izq · controles voz der  -->
                <Grid
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Ruta  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.5"
                            Text="Ruta:" />
                        <TextBlock
                            x:Name="BreadcrumbText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="/" />
                    </StackPanel>

                    <!--  Controles lectura por voz  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="BtnSpeechPrev"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPrev_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Anterior">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ToggleButton
                            x:Name="BtnSpeechPlay"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictPlayPause_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Reproducir / Pausar">
                            <SymbolIcon x:Name="BtnSpeechPlayIcon" Symbol="Play" />
                        </ToggleButton>
                        <Button
                            x:Name="BtnSpeechNext"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Click="BtnDictNext_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="Siguiente">
                            <SymbolIcon Symbol="Forward" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Encabezados de columnas estilo Everything  -->
                <Grid
                    x:Name="ResultsHeaderGrid"
                    Grid.Row="1"
                    Padding="8,0"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderPathColumn" Width="150" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderNameColumn" Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderDateColumn" Width="130" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition x:Name="HeaderStarColumn" Width="36" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#D6D6D6"
                        Text="Path" />

                    <Thumb
                        x:Name="PathNameSplitter"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="PathNameSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Path" />

                    <!--  Ordenar por nombre A-Z / Z-A  -->
                    <Button
                        x:Name="HeaderNameSortButton"
                        Grid.Column="2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HeaderNameSort_Click"
                        ToolTipService.ToolTip="Ordenar por nombre">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D6D6D6"
                                Text="Name" />
                            <TextBlock
                                x:Name="NameSortArrow"
                                FontSize="10"
                                Foreground="#D6D6D6"
                                Text="▲" />
                        </StackPanel>
                    </Button>

                    <Thumb
                        x:Name="NameDateSplitter"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="NameDateSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Name y Date Modified" />

                    <!--  Ordenar por fecha reciente / antigua  -->
                    <Button
                        x:Name="HeaderModifiedSortButton"
                        Grid.Column="4"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="HeaderModifiedSort_Click"
                        ToolTipService.ToolTip="Ordenar por fecha modificada">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D6D6D6"
                                Text="Date Modified" />
                            <TextBlock
                                x:Name="ModifiedSortArrow"
                                FontSize="10"
                                Foreground="#D6D6D6"
                                Text="" />
                        </StackPanel>
                    </Button>

                    <Thumb
                        x:Name="DateStarSplitter"
                        Grid.Column="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DragCompleted="ColumnSplitter_DragCompleted"
                        DragDelta="DateStarSplitter_DragDelta"
                        ToolTipService.ToolTip="Arrastra para ajustar Date Modified y Favorito" />

                    <TextBlock
                        Grid.Column="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Foreground="#D6D6D6"
                        Text="&#xE734;"
                        ToolTipService.ToolTip="Favorito" />
                </Grid>

                <!--  Lista de resultados estilo Everything  -->
                <Grid Grid.Row="2">
                    <Border
                        x:Name="LoadingOverlay"
                        Canvas.ZIndex="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="22,16"
                        Background="#E61B1F23"
                        BorderBrush="#5B8DEF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <StackPanel
                            MinWidth="280"
                            MaxWidth="520"
                            Orientation="Horizontal"
                            Spacing="14">
                            <ProgressRing
                                x:Name="LoadingRing"
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />

                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="LoadingTitleText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Text, ElementName=StatusText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LoadingDetailText"
                                    FontSize="12"
                                    Opacity="0.72"
                                    Text="Espera un momento mientras ANFETA termina la operación."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="NotionDropOverlay"
                        Canvas.ZIndex="80"
                        Margin="18"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#E620242A"
                        BorderBrush="#49B6FF"
                        BorderThickness="2"
                        CornerRadius="14"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                Spacing="10">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="42"
                                    Glyph="&#xE898;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Suelta para subir a Notion"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Opacity="0.76"
                                    Text="Se abrirá el flujo para elegir una página o páginas separadas."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="ResultsList"
                        DoubleTapped="ResultsList_DoubleTapped"
                        ItemsSource="{x:Bind Results, Mode=OneWay}"
                        RightTapped="ResultsList_RightTapped"
                        SelectionChanged="ResultsList_SelectionChanged"
                        SelectionMode="Extended">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultRow">
                                <Grid
                                    Height="22"
                                    Padding="8,0"
                                    ColumnSpacing="0"
                                    Tag="ResultColumns">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Path: en Notion muestra la base correspondiente  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Foreground="#B8B8B8"
                                        MaxLines="1"
                                        Text="{x:Bind PathColumn, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <!--  Name  -->
                                    <Grid
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#B8B8B8"
                                            Glyph="&#xE774;" />

                                        <TextBlock
                                            x:Name="NameText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            DataContextChanged="NameText_DataContextChanged"
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#F2F2F2"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>

                                    <!--  Date Modified  -->
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Foreground="#B8B8B8"
                                        MaxLines="1"
                                        Text="{x:Bind DateModifiedColumn, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <!--  Favorito  -->
                                    <Button
                                        Grid.Column="6"
                                        Width="26"
                                        Height="20"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnStar_Click"
                                        Content="{x:Bind StarGlyph, Mode=OneWay}"
                                        FontSize="11"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Agregar / quitar Favorito" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="ResultsContextFlyout" Opening="ResultsContextFlyout_Opening">

                                <MenuFlyoutItem
                                    x:Name="CtxMenuOpenItem"
                                    Click="CtxOpen_Click"
                                    Text="Abrir" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuOpenExplorerItem"
                                    Click="CtxOpenPath_Click"
                                    Text="Abrir en Explorador Local" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    Click="CtxCopyName_Click"
                                    Text="Copiar nombre" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCopyPathItem"
                                    Click="CtxCopyPath_Click"
                                    Text="Copiar ruta" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCopyLinkItem"
                                    Click="CtxCopyLink_Click"
                                    Text="Copiar link" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuCreateDropboxFolderItem"
                                    Click="CtxCreateDropboxFolder_Click"
                                    Text="Crear carpeta aquí..." />

                                <MenuFlyoutSubItem
                                    x:Name="CtxMenuUploadFileSubItem"
                                    Text="Subir archivo">
                                    <MenuFlyoutItem
                                        x:Name="CtxMenuUploadDropboxFileItem"
                                        Click="CtxUploadDropboxFile_Click"
                                        Text="A Dropbox..." />
                                    <MenuFlyoutItem
                                        x:Name="CtxMenuUploadNotionFileItem"
                                        Click="CtxUploadNotionFile_Click"
                                        Text="A Notion — Revisiones..." />
                                </MenuFlyoutSubItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuRenameItem"
                                    Click="CtxRename_Click"
                                    Text="Renombrar…" />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuDeleteItem"
                                    Click="CtxDelete_Click"
                                    Text="Eliminar" />

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem
                                    x:Name="CtxMenuBookmarkItem"
                                    Click="CtxBookmark_Click"
                                    Text="Agregar a Favoritos" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyResultsHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.5"
                        Text="No hay resultados" />
                </Grid>

                <!--  Paginación — altura fija 30px para que nunca se corte  -->
                <Grid
                    Grid.Row="3"
                    Padding="8,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!--  Prev  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Next  -->
                        <ColumnDefinition Width="*" />
                        <!--  Spacer  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageInfo  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  PageSize  -->
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnPrevPage_Click"
                        Content="⟨"
                        CornerRadius="5"
                        FontSize="13" />
                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BtnNextPage_Click"
                        Content="⟩"
                        CornerRadius="5"
                        FontSize="13" />

                    <TextBlock
                        x:Name="PageInfoText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.65"
                        Text="Página 1" />

                    <ComboBox
                        x:Name="PageSizeCombo"
                        Grid.Column="4"
                        Height="24"
                        VerticalAlignment="Center"
                        PlaceholderText="Tamaño"
                        SelectionChanged="PageSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="25" Tag="25" />
                        <ComboBoxItem Content="50" Tag="50" />
                        <ComboBoxItem Content="100" Tag="100" />
                    </ComboBox>
                </Grid>

            </Grid>


            <!--  ── RIGHT PANEL ──────────────────────────────────  -->
            <Border
                x:Name="DetailsPane"
                Grid.Column="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="Visible">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <!--  Header Favoritos  -->
                        <RowDefinition Height="Auto" />
                        <!--  Search Favoritos  -->
                        <RowDefinition Height="140" />
                        <!--  Lista Favoritos  -->
                        <RowDefinition Height="30" />
                        <!--  Header Detalles  -->
                        <RowDefinition Height="*" />
                        <!--  Detalles  -->
                        <RowDefinition Height="38" />
                        <!--  Acciones  -->
                    </Grid.RowDefinitions>

                    <!--  Header Favoritos  -->
                    <Grid
                        Grid.Row="0"
                        Padding="10,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.55"
                            Text="FAVORITOS" />
                    </Grid>

                    <!--  Search Favoritos  -->
                    <AutoSuggestBox
                        Grid.Row="1"
                        Margin="8,5,8,4"
                        FontSize="12"
                        PlaceholderText="Search Favoritos" />

                    <!--  Lista Favoritos  -->
                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="BookmarksList_ItemClick"
                        ItemsSource="{x:Bind _bookmarksOc, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10"
                                            MaxLines="1"
                                            Opacity="0.5"
                                            Text="{Binding LocalPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnBookmarkPanelStar_Click"
                                        Content="★"
                                        FontSize="11"
                                        Tag="{Binding LocalPath}"
                                        ToolTipService.ToolTip="Quitar Favorito" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  Header Detalles  -->
                    <Grid
                        Grid.Row="3"
                        Padding="10,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.55"
                            Text="DETALLES" />
                    </Grid>

                    <!--  Detalles  -->
                    <ScrollViewer
                        Grid.Row="4"
                        Padding="10,8"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="DetailsTitle"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Selecciona un elemento"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DetailsPath"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Padding="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Opacity="0.55"
                                        Text="Metadata" />
                                    <TextBlock
                                        x:Name="DetailsMeta"
                                        FontSize="11"
                                        Opacity="0.65"
                                        Text="—"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Acciones — altura fija 38px, nunca se corta  -->
                    <Grid
                        Grid.Row="5"
                        Padding="8,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="CtxOpen_Click"
                            Content="Abrir"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            x:Name="BtnDetailsLocation"
                            Grid.Column="1"
                            Height="26"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="BtnDetailsLink_Click"
                            Content="Ubicación"
                            CornerRadius="6"
                            FontSize="11" />
                        <Button
                            Grid.Column="2"
                            Width="28"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Content="⋯"
                            CornerRadius="6"
                            FontSize="13">
                            <Button.Flyout>
                                <MenuFlyout x:Name="DetailsMoreFlyout" Opening="DetailsMoreFlyout_Opening">

                                    <MenuFlyoutItem Click="BtnDetailsInfo_Click" Text="Info" />
                                    <MenuFlyoutItem Click="CtxCopyName_Click" Text="Copiar nombre" />

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem
                                        x:Name="DetailsCreateDropboxFolderItem"
                                        Click="CtxCreateDropboxFolder_Click"
                                        Text="Crear carpeta aquí..." />

                                    <MenuFlyoutSubItem
                                        x:Name="DetailsUploadFileSubItem"
                                        Text="Subir archivo">
                                        <MenuFlyoutItem
                                            x:Name="DetailsUploadDropboxFileItem"
                                            Click="CtxUploadDropboxFile_Click"
                                            Text="A Dropbox..." />
                                        <MenuFlyoutItem
                                            x:Name="DetailsUploadNotionFileItem"
                                            Click="CtxUploadNotionFile_Click"
                                            Text="A Notion — Revisiones..." />
                                    </MenuFlyoutSubItem>

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem
                                        x:Name="DetailsRenameItem"
                                        Click="CtxRename_Click"
                                        Text="Renombrar..." />

                                    <MenuFlyoutItem
                                        x:Name="DetailsDeleteItem"
                                        Click="CtxDelete_Click"
                                        Text="Eliminar" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            ROW 4 · STATUS BAR  — altura fija 22px, siempre visible
            ═══════════════════════════════════════════════════════
        -->
        <Grid
            Grid.Row="4"
            Padding="10,0"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.6"
                    Text="Estado: Dropbox" />
                <TextBlock
                    x:Name="VoiceDebugText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text=""
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock
                x:Name="ModeText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="Modo: Buscar" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.6"
                Text="0 resultados" />
        </Grid>


        <!--
            ═══════════════════════════════════════════════════════
            POPUP AYUDA
            ═══════════════════════════════════════════════════════
        -->
        <Popup x:Name="HelpPopup" IsLightDismissEnabled="True">
            <Grid
                Width="{Binding ElementName=RootLayout, Path=ActualWidth}"
                Height="{Binding ElementName=RootLayout, Path=ActualHeight}"
                Background="#90000000">
                <Border
                    Width="600"
                    MaxWidth="650"
                    MaxHeight="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Black"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Ayuda · Comandos de búsqueda" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter x:Name="HelpContentHost" />
                        </ScrollViewer>
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Click="HelpPopupClose_Click"
                            Content="Cerrar" />
                    </Grid>
                </Border>
            </Grid>
        </Popup>

    </Grid>
</Page>
