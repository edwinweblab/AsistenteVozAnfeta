<Page
    x:Class="Anfeta.UI.Views.CommandsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anfeta.UI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- ── Chip de tier ── -->
        <Style x:Key="TierChipStyle"
               BasedOn="{StaticResource DefaultToggleButtonStyle}"
               TargetType="ToggleButton">
            <Setter Property="CornerRadius"    Value="20"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="MinHeight"       Value="32"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- ── Tab button ── -->
        <Style x:Key="TabToggleStyle"
               BasedOn="{StaticResource DefaultToggleButtonStyle}"
               TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="20,12"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="CornerRadius"    Value="0"/>
        </Style>

        <!-- ── Quick card button ── -->
        <Style x:Key="QuickCardStyle"
               BasedOn="{StaticResource DefaultButtonStyle}"
               TargetType="Button">
            <Setter Property="Background"                 Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="CornerRadius"               Value="12"/>
            <Setter Property="Padding"                    Value="18,16"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="VerticalAlignment"          Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"   Value="Top"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             HEADER
        ═══════════════════════════════════════ -->
        <Grid Padding="28,24,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Centro de ayuda"
                           Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Text="Explora cómo funciona el asistente o busca exactamente lo que necesitas."
                           Style="{StaticResource CaptionTextStyle}"
                           Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════
             TAB STRIP
        ═══════════════════════════════════════ -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="0"
                        Padding="20,0,20,0">
                <ToggleButton x:Name="BtnExplore"
                              Content="Explorar"
                              IsChecked="True"
                              Style="{StaticResource TabToggleStyle}"
                              Click="BtnExplore_Click"/>
                <ToggleButton x:Name="BtnTutorial"
                              Content="Cómo funciona"
                              IsChecked="False"
                              Style="{StaticResource TabToggleStyle}"
                              Click="BtnTutorial_Click"/>
                <ToggleButton x:Name="BtnCommands"
                              Content="Catálogo de comandos"
                              IsChecked="False"
                              Style="{StaticResource TabToggleStyle}"
                              Click="BtnCommands_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             SCROLL CONTENT
        ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24,28,32">
            <Grid>

                <!-- ╔══════════════════════════════╗
                     ║  PANEL EXPLORAR              ║
                     ╚══════════════════════════════╝ -->
                <StackPanel x:Name="ExplorePanel" Spacing="28">

                    <!-- Buscador -->
                    <AutoSuggestBox x:Name="ExploreSearchBox"
                                    PlaceholderText="Buscar: micrófono, calendario, actividades, iniciar sesión..."
                                    QueryIcon="Find"
                                    TextMemberPath="Text"
                                    TextChanged="ExploreSearch_TextChanged"
                                    SuggestionChosen="ExploreSearch_SuggestionChosen"
                                    QuerySubmitted="ExploreSearch_QuerySubmitted"
                                    CornerRadius="10"
                                    MinHeight="46"
                                    FontSize="14">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SearchSuggestion">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            Padding="4,8">
                                    <Border CornerRadius="6"
                                            Padding="8,3"
                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                        <TextBlock Text="{x:Bind Category}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind Text}"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- ── Sugerencia del día ── -->
                    <StackPanel Spacing="12">

                        <!-- Label con punto pulsante -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7"
                                     Fill="{StaticResource AnfetaAccentBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="SUGERENCIA DE HOY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       CharacterSpacing="100"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Card sugerencia -->
                        <Border CornerRadius="14"
                                BorderThickness="1.5"
                                BorderBrush="{StaticResource AnfetaWarningBrush}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Contenido tappeable -->
                                <Grid Padding="20,18,20,16"
                                      ColumnSpacing="18"
                                      Tapped="DailyCard_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono con fondo -->
                                    <Grid Width="52" Height="52" VerticalAlignment="Center">
                                        <Border CornerRadius="13"
                                                Background="{StaticResource AnfetaAccentBrush}"
                                                Opacity="0.15"/>
                                        <FontIcon x:Name="DailyGlyphIcon"
                                                  Glyph="&#xE720;"
                                                  FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>

                                    <!-- Texto -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="5"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="DailyTitle"
                                                   Style="{StaticResource BodyLargeTextStyle}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="DailyDesc"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.72"
                                                   LineHeight="20"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                            <FontIcon Glyph="&#xE8A7;"
                                                      FontSize="10"
                                                      Foreground="{StaticResource AnfetaAccentBrush}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="Ver detalle completo"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AnfetaAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Flecha derecha -->
                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource AnfetaAccentBrush}"
                                              Opacity="0.45"/>
                                </Grid>

                                <!-- Barra nav: prev · contador · next -->
                                <Border Grid.Row="1"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                Foreground="{StaticResource AnfetaAccentBrush}"
                                                Click="DailyPrev_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                                                <TextBlock Text="Anterior" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock x:Name="DailyCounter"
                                                   Grid.Column="1"
                                                   Text="1 / 6"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                Foreground="{StaticResource AnfetaAccentBrush}"
                                                Click="DailyNext_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Siguiente" FontSize="11" FontWeight="SemiBold"/>
                                                <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── Acceso rápido ── -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="ACCESO RÁPIDO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   CharacterSpacing="100"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Tag="0" Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE720;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Usar el micrófono" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Activar, cancelar y configurar" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Tag="1" Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE787;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Google Calendar" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Conectar y ver eventos" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Tag="2" Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE8F9;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Crear actividad" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Flujo paso a paso" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Tag="3" Grid.Row="1" Grid.Column="0"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE7E7;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Recordatorios" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Crear, editar y eliminar" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Tag="4" Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE9D2;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Mis revisiones" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Ver por fecha y estado" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Tag="5" Grid.Row="1" Grid.Column="2"
                                    Style="{StaticResource QuickCardStyle}"
                                    Click="QuickCard_Click">
                                <StackPanel Spacing="12">
                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{StaticResource AnfetaAccentBrush}" Opacity="0.14"/>
                                        <FontIcon Glyph="&#xE8D7;" FontSize="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource AnfetaAccentBrush}"/>
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Iniciar sesión" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Correo y teléfono empresa" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- ── Barra de estado ── -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="BARRA DE ESTADO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   CharacterSpacing="100"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Border CornerRadius="12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="0">
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StatusItem">
                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,16">
                                            <Grid ColumnSpacing="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Indicador izquierdo -->
                                                <StackPanel Spacing="8"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind Glyph}"
                                                              FontSize="20"
                                                              HorizontalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Border CornerRadius="10"
                                                            Padding="10,4"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    HorizontalAlignment="Center">
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{x:Bind DemoDotBrush}"
                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind DemoLabel}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Descripción derecha -->
                                                <StackPanel Grid.Column="1"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{x:Bind ColorRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StatusColorRow">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="10"
                                                                            Margin="0,3">
                                                                    <Ellipse Width="8" Height="8"
                                                                             Fill="{x:Bind DotBrush}"
                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{x:Bind Description}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               Opacity="0.78"
                                                                               LineHeight="18"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>

                <!-- ╔══════════════════════════════╗
                     ║  PANEL CÓMO FUNCIONA         ║
                     ╚══════════════════════════════╝ -->
                <StackPanel x:Name="TutorialPanel"
                            Visibility="Collapsed"
                            Spacing="16">

                    <!-- Flujo básico -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="2" Margin="0,6">
                                <TextBlock Text="Flujo básico"
                                           Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="Los 3 pasos de cada interacción con el asistente."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl x:Name="BasicStepsList" Margin="0,12,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TutorialStep">
                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="0,0,0,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Número + icono -->
                                            <StackPanel Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0">
                                                <Grid Width="40" Height="40">
                                                    <Ellipse Fill="{StaticResource AnfetaAccentBrush}"
                                                             Opacity="0.12"/>
                                                    <TextBlock Text="{x:Bind Number}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AnfetaAccentBrush}"/>
                                                </Grid>
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="18"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{StaticResource AnfetaAccentBrush}"
                                                          Opacity="0.7"/>
                                            </StackPanel>

                                            <!-- Texto -->
                                            <StackPanel Grid.Column="1" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyLargeTextStyle}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.82"
                                                           LineHeight="22"/>
                                                <Border BorderBrush="{StaticResource AnfetaAccentBrush}"
                                                        BorderThickness="3,0,0,0"
                                                        CornerRadius="0,6,6,0"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        Padding="12,8"
                                                        Visibility="{x:Bind DetailVisibility}">
                                                    <TextBlock Text="{x:Bind Detail}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="Wrap"
                                                               FontStyle="Italic"
                                                               Opacity="0.78"
                                                               LineHeight="18"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Elementos de la interfaz -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="2" Margin="0,6">
                                <TextBlock Text="Elementos de la interfaz"
                                           Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="Qué hace cada componente visible en la pantalla principal."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl x:Name="InterfaceElementsList" Margin="0,12,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:InterfaceElement">
                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="0,0,0,10">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="42" Height="42"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Border CornerRadius="10"
                                                        Background="{StaticResource AnfetaAccentBrush}"
                                                        Opacity="0.12"/>
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="19"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AnfetaAccentBrush}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Flujos conversacionales -->
                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Spacing="2" Margin="0,6">
                                <TextBlock Text="Flujos conversacionales"
                                           Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="Comandos que requieren varios pasos de diálogo con el asistente."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl x:Name="MultiTurnList" Margin="0,12,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TutorialStep">
                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="0,0,0,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0">
                                                <Grid Width="36" Height="36">
                                                    <Border CornerRadius="9"
                                                            Background="{StaticResource AnfetaAccentBrush}"
                                                            Opacity="0.12"/>
                                                    <TextBlock Text="{x:Bind Number}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AnfetaAccentBrush}"/>
                                                </Grid>
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="16"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{StaticResource AnfetaAccentBrush}"
                                                          Opacity="0.7"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyLargeTextStyle}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.82"
                                                           LineHeight="22"/>
                                                <Border BorderBrush="{StaticResource AnfetaAccentBrush}"
                                                        BorderThickness="3,0,0,0"
                                                        CornerRadius="0,6,6,0"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        Padding="12,8"
                                                        Visibility="{x:Bind DetailVisibility}">
                                                    <TextBlock Text="{x:Bind Detail}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="Wrap"
                                                               FontStyle="Italic"
                                                               Opacity="0.78"
                                                               LineHeight="18"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                </StackPanel>

                <!-- ╔══════════════════════════════╗
                     ║  PANEL CATÁLOGO              ║
                     ╚══════════════════════════════╝ -->
                <StackPanel x:Name="CommandsPanel"
                            Visibility="Collapsed"
                            Spacing="14">

                    <!-- Filtros -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ModulesCombo"
                                  Height="42"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Módulo..."
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ModulesCombo_SelectionChanged"
                                  CornerRadius="8"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="42"
                                 PlaceholderText="Buscar por título, frase o respuesta..."
                                 TextChanged="SearchBox_TextChanged"
                                 CornerRadius="8"/>

                        <Button Grid.Column="2"
                                Height="42"
                                Content="Limpiar"
                                Style="{StaticResource CompactButtonStyle}"
                                Click="Clear_Click"/>
                    </Grid>

                    <!-- Chips de tier -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="ChipAll"
                                      Content="Todos"
                                      IsChecked="True"
                                      Style="{StaticResource TierChipStyle}"
                                      Click="ChipAll_Click"/>
                        <ToggleButton x:Name="ChipT1"
                                      Content="Tier 1 — Sin IA"
                                      IsChecked="False"
                                      Style="{StaticResource TierChipStyle}"
                                      Click="ChipT1_Click"/>
                        <ToggleButton x:Name="ChipT2"
                                      Content="Tier 2 — Conversacional"
                                      IsChecked="False"
                                      Style="{StaticResource TierChipStyle}"
                                      Click="ChipT2_Click"/>
                        <ToggleButton x:Name="ChipT3"
                                      Content="Tier 3 — IA"
                                      IsChecked="False"
                                      Style="{StaticResource TierChipStyle}"
                                      Click="ChipT3_Click"/>
                    </StackPanel>

                    <!-- Leyenda + contador -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8" Height="8"
                                             Fill="#2DB880" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tier 1 — sin IA, instantáneo"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8" Height="8"
                                             Fill="#E09030" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tier 2 — conversacional"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8" Height="8"
                                             Fill="#8B7ED4" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tier 3 — procesado por IA"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Contador -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="VisibleCount"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="/"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Name="TotalCount"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="comandos"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Info módulo -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind SelectedModuleTitle, Mode=OneWay}"
                                       Style="{StaticResource BodyLargeTextStyle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind SelectedModuleSubtitle, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Opacity="0.65"/>
                        </StackPanel>
                    </Border>

                    <!-- Lista acordeón -->
                    <ItemsControl x:Name="CommandsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CommandItem">
                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Margin="0,0,0,10"
                                          CornerRadius="12">
                                    <Expander.Header>
                                        <Grid HorizontalAlignment="Stretch"
                                              ColumnSpacing="12"
                                              Margin="0,8,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tier pill -->
                                            <Border CornerRadius="10"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind TierBackground}">
                                                <TextBlock Text="{x:Bind Tier}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{x:Bind TierForeground}"/>
                                            </Border>

                                            <!-- Título -->
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind IdAndModule}"
                                                           FontSize="10"
                                                           Opacity="0.4"
                                                           FontWeight="SemiBold"
                                                           CharacterSpacing="20"/>
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyLargeTextStyle}"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border CornerRadius="6"
                                                            Padding="8,3"
                                                            Background="{StaticResource AnfetaWarningBrush}"
                                                            Opacity="0.2"
                                                            Visibility="{x:Bind ConfirmVisibility}">
                                                        <TextBlock Text="Confirmación"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AnfetaAccentBrush}"/>
                                                    </Border>
                                                    <Border CornerRadius="6"
                                                            Padding="8,3"
                                                            Background="{StaticResource AnfetaInfoBrush}"
                                                            Opacity="0.18"
                                                            Visibility="{x:Bind MultiTurnVisibility}">
                                                        <TextBlock Text="Multi-turno"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AnfetaInfoBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Contenido expandido — dos columnas -->
                                    <Grid ColumnSpacing="20" Padding="4,14,4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- IZQUIERDA: lista de frases -->
                                        <StackPanel Grid.Column="0" Spacing="10">
                                            <TextBlock Text="FRASES QUE PUEDES DECIR"
                                                       FontSize="10" FontWeight="Bold"
                                                       CharacterSpacing="80" Opacity="0.4"/>
                                            <ItemsControl ItemsSource="{x:Bind Phrases}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="10"
                                                                    Margin="0,0,0,7">
                                                            <FontIcon Glyph="&#xE76C;"
                                                                      FontSize="10"
                                                                      Foreground="{StaticResource AnfetaAccentBrush}"
                                                                      VerticalAlignment="Center"
                                                                      Opacity="0.7"/>
                                                            <Border CornerRadius="6"
                                                                    Padding="10,6"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{x:Bind}"
                                                                           FontSize="13"
                                                                           FontStyle="Italic"
                                                                           TextWrapping="Wrap"
                                                                           Opacity="0.88"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Divisor vertical -->
                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Opacity="0.35"
                                                VerticalAlignment="Stretch"/>

                                        <!-- DERECHA: conversación ejemplo -->
                                        <StackPanel Grid.Column="2" Spacing="12">
                                            <TextBlock Text="EJEMPLO DE USO"
                                                       FontSize="10" FontWeight="Bold"
                                                       CharacterSpacing="80" Opacity="0.4"/>

                                            <!-- Burbuja usuario -->
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="12"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="Usuario"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border CornerRadius="0,10,10,10"
                                                        Padding="12,9"
                                                        Margin="0,0,24,0"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{x:Bind Phrases[0]}"
                                                               FontSize="13" FontStyle="Italic"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Burbuja asistente -->
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                            Background="{StaticResource AnfetaAccentBrush}">
                                                        <FontIcon Glyph="&#xE720;" FontSize="12"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="Asistente"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AnfetaAccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource AnfetaAccentBrush}"
                                                            CornerRadius="3,0,0,3"/>
                                                    <Border Grid.Column="1"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="0,10,10,10"
                                                            Padding="12,9"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="0,1,1,1">
                                                        <TextBlock Text="{x:Bind ResponseExample}"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="20"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
