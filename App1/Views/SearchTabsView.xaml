<Page
    x:Class="Anfeta.UI.Views.SearchTabsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anfeta.UI.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required">

    <Grid>
        <muxc:TabView x:Name="Tabs"
              AddTabButtonClick="Tabs_AddTabButtonClick"
              TabCloseRequested="Tabs_TabCloseRequested"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <muxc:TabViewItem Header="Buscar 1" IsClosable="False">
                <local:SearchView x:Name="FirstSearchView" />
            </muxc:TabViewItem>
        </muxc:TabView>
    </Grid>
</Page>