<Page
    x:Class="App1.FunctionTests.TestRunner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Grid.Row="0"
            Text="PRUEBAS DE FUNCIONES ANFETA"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,20">
            <Button 
                x:Name="btnTestNetwork"
                Content="Probar Funciones de Red"
                Click="BtnTestNetwork_Click"
                HorizontalAlignment="Stretch"
                Padding="10"/>

            <Button 
                x:Name="btnTestNotifications"
                Content="Probar Notificaciones"
                Click="BtnTestNotifications_Click"
                HorizontalAlignment="Stretch"
                Padding="10"/>

            <Button 
                x:Name="btnTestSystem"
                Content="Probar Funciones del Sistema"
                Click="BtnTestSystem_Click"
                HorizontalAlignment="Stretch"
                Padding="10"/>

            <Button 
                x:Name="btnRunAllTests"
                Content="Ejecutar TODAS las Pruebas"
                Click="BtnRunAllTests_Click"
                HorizontalAlignment="Stretch"
                Padding="10"
                FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" BorderThickness="1" BorderBrush="Gray">
            <TextBlock 
                x:Name="txtResults"
                Text="Presiona un botón para ejecutar las pruebas..."
                TextWrapping="Wrap"
                Padding="10"
                FontFamily="Consolas"
                FontSize="12"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar 
                x:Name="progressBar"
                Height="4"
                IsIndeterminate="False"
                Visibility="Collapsed"/>
            <TextBlock 
                x:Name="txtStatus"
                Text="Listo"
                Margin="0,5,0,0"
                FontSize="12"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>