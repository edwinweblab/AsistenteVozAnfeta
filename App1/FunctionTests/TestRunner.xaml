<Page
    x:Class="Anfeta.UI.FunctionTests.TestRunner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid Padding="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
			<FontIcon Glyph="&#xE7C1;" FontSize="28"
                      Foreground="{StaticResource AnfetaAccentBrush}"
                      VerticalAlignment="Center"/>
			<TextBlock Text="Pruebas de Sistema"
                       Style="{StaticResource HeaderTextStyle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
		</StackPanel>

		<!-- Grid de botones 2x2 -->
		<Grid Grid.Row="1" Margin="0,0,0,24">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Red -->
			<Button x:Name="btnTestNetwork"
                    Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="BtnTestNetwork_Click">
				<StackPanel Orientation="Horizontal">
					<FontIcon Glyph="&#xE968;" FontSize="18" Margin="0,0,10,0"/>
					<TextBlock Text="Red" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<!-- Notificaciones -->
			<Button x:Name="btnTestNotifications"
                    Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="BtnTestNotifications_Click">
				<StackPanel Orientation="Horizontal">
					<FontIcon Glyph="&#xE91C;" FontSize="18" Margin="0,0,10,0"/>
					<TextBlock Text="Notificaciones" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<!-- Sistema -->
			<Button x:Name="btnTestSystem"
                    Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="BtnTestSystem_Click">
				<StackPanel Orientation="Horizontal">
					<FontIcon Glyph="&#xE770;" FontSize="18" Margin="0,0,10,0"/>
					<TextBlock Text="Sistema" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<!-- Micrófono -->
			<Button x:Name="btnTestMicrophone"
                    Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="BtnTestMicrophone_Click">
				<StackPanel Orientation="Horizontal">
					<FontIcon Glyph="&#xE720;" FontSize="18" Margin="0,0,10,0"/>
					<TextBlock Text="Micrófono" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</Grid>

		<!-- Área de resultados -->
		<Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
			<ScrollViewer>
				<TextBlock x:Name="txtResults"
                           Text="Selecciona una prueba para ejecutar..."
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
			</ScrollViewer>
		</Border>

		<!-- Footer -->
		<StackPanel Grid.Row="3" Margin="0,16,0,0">
			<ProgressBar x:Name="progressBar"
                         Height="4"
                         IsIndeterminate="False"
                         Visibility="Collapsed"/>
			<TextBlock x:Name="txtStatus"
                       Text="Listo"
                       Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       HorizontalAlignment="Center"/>
		</StackPanel>
	</Grid>
</Page>